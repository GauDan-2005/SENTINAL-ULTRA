+#[test]
+fn one_sided_alternatives_pick_the_requested_tail() {
+    // The two one-sided p-values partition the probability for a continuous statistic, but
+    // that identity on its own is symmetric: it holds just as well if an implementation has
+    // Less and Greater the wrong way round. Every block below also pins the direction.
+
+    // The sample mean sits well above the population mean, so Greater is the small tail.
+    let above = vec![10.0, 11.0, 12.0, 13.0, 14.0];
+    let (_, p_less) =
+        ttest_onesample(above.clone(), 5.0, Alternative::Less, NaNPolicy::Error).unwrap();
+    let (_, p_greater) =
+        ttest_onesample(above.clone(), 5.0, Alternative::Greater, NaNPolicy::Error).unwrap();
+    let (_, p_two) =
+        ttest_onesample(above, 5.0, Alternative::TwoSided, NaNPolicy::Error).unwrap();
+    assert!(prec::almost_eq(p_less + p_greater, 1.0, 1e-12));
+    assert!(prec::almost_eq(p_two, 2.0 * p_less.min(p_greater), 1e-12));
+    assert!(p_greater < 0.001);
+    assert!(p_less > 0.999);
+
+    // The same sample against a population mean well above it flips which tail is small.
+    let below = vec![10.0, 11.0, 12.0, 13.0, 14.0];
+    let (_, p_less) =
+        ttest_onesample(below.clone(), 20.0, Alternative::Less, NaNPolicy::Error).unwrap();
+    let (_, p_greater) =
+        ttest_onesample(below, 20.0, Alternative::Greater, NaNPolicy::Error).unwrap();
+    assert!(p_less < 0.001);
+    assert!(p_greater > 0.999);
+
+    // Right-skewed data, so the skew z score is positive and Greater is the small tail.
+    let skewed = vec![148.0, 154.0, 158.0, 160.0, 161.0, 162.0, 166.0, 170.0, 182.0, 195.0, 236.0];
+    let (z, p_greater) = skewtest(skewed.clone(), Alternative::Greater, NaNPolicy::Error).unwrap();
+    let (_, p_less) = skewtest(skewed.clone(), Alternative::Less, NaNPolicy::Error).unwrap();
+    let (_, p_two) = skewtest(skewed, Alternative::TwoSided, NaNPolicy::Error).unwrap();
+    assert!(z > 0.0);
+    assert!(prec::almost_eq(p_less + p_greater, 1.0, 1e-12));
+    assert!(prec::almost_eq(p_two, 2.0 * p_less.min(p_greater), 1e-12));
+    assert!(p_greater < 0.01);
+    assert!(p_less > 0.99);
+
+    // Mann-Whitney offers the same two tails, and the exact method has to give the reference
+    // value for BOTH sample orders. Exchanging x and y exchanges the two tails, so a result
+    // that stays put under the swap is reporting the wrong tail for one of the two orders.
+    let x = [19, 22, 16, 29, 24];
+    let y = [20, 11, 17, 12];
+    let (_, p_less) =
+        mannwhitneyu(&x, &y, MannWhitneyUMethod::Exact, Alternative::Less).unwrap();
+    let (_, p_greater) =
+        mannwhitneyu(&x, &y, MannWhitneyUMethod::Exact, Alternative::Greater).unwrap();
+    let (_, p_two) =
+        mannwhitneyu(&x, &y, MannWhitneyUMethod::Exact, Alternative::TwoSided).unwrap();
+    assert!(prec::almost_eq(p_less, 0.96825396825396826, 1e-9));
+    assert!(prec::almost_eq(p_greater, 0.05555555555555555, 1e-9));
+    assert!(prec::almost_eq(p_two, 0.11111111111111110, 1e-9));
+
+    let (_, p_less) =
+        mannwhitneyu(&y, &x, MannWhitneyUMethod::Exact, Alternative::Less).unwrap();
+    let (_, p_greater) =
+        mannwhitneyu(&y, &x, MannWhitneyUMethod::Exact, Alternative::Greater).unwrap();
+    let (_, p_two) =
+        mannwhitneyu(&y, &x, MannWhitneyUMethod::Exact, Alternative::TwoSided).unwrap();
+    assert!(prec::almost_eq(p_less, 0.05555555555555555, 1e-9));
+    assert!(prec::almost_eq(p_greater, 0.96825396825396826, 1e-9));
+    assert!(prec::almost_eq(p_two, 0.11111111111111110, 1e-9));
+
+    // The smallest case that separates the two tails, with x the smaller sample and every
+    // value of x below every value of y. Less is the significant side here.
+    let small = [1, 2];
+    let large = [3, 4, 5];
+    let (_, p_less) =
+        mannwhitneyu(&small, &large, MannWhitneyUMethod::Exact, Alternative::Less).unwrap();
+    let (_, p_greater) =
+        mannwhitneyu(&small, &large, MannWhitneyUMethod::Exact, Alternative::Greater).unwrap();
+    let (_, p_two) =
+        mannwhitneyu(&small, &large, MannWhitneyUMethod::Exact, Alternative::TwoSided).unwrap();
+    assert!(prec::almost_eq(p_less, 0.1, 1e-9));
+    assert!(prec::almost_eq(p_greater, 1.0, 1e-9));
+    assert!(prec::almost_eq(p_two, 0.2, 1e-9));
+
+    let (_, p_less) =
+        mannwhitneyu(&large, &small, MannWhitneyUMethod::Exact, Alternative::Less).unwrap();
+    let (_, p_greater) =
+        mannwhitneyu(&large, &small, MannWhitneyUMethod::Exact, Alternative::Greater).unwrap();
+    let (_, p_two) =
+        mannwhitneyu(&large, &small, MannWhitneyUMethod::Exact, Alternative::TwoSided).unwrap();
+    assert!(prec::almost_eq(p_less, 1.0, 1e-9));
+    assert!(prec::almost_eq(p_greater, 0.1, 1e-9));
+    assert!(prec::almost_eq(p_two, 0.2, 1e-9));
+
+    // Equal sample sizes, which is the other shape where a size-dependent tail choice shows up.
+    let eq_low = [1, 2, 3];
+    let eq_high = [4, 5, 6];
+    let (_, p_less) =
+        mannwhitneyu(&eq_low, &eq_high, MannWhitneyUMethod::Exact, Alternative::Less).unwrap();
+    let (_, p_greater) =
+        mannwhitneyu(&eq_low, &eq_high, MannWhitneyUMethod::Exact, Alternative::Greater).unwrap();
+    assert!(prec::almost_eq(p_less, 0.05, 1e-9));
+    assert!(prec::almost_eq(p_greater, 1.0, 1e-9));
+}
