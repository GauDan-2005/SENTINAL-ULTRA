+#[test]
+fn mannwhitneyu_asymptotic_variants_differ_by_the_continuity_correction() {
+    let x = [19, 22, 16, 29, 24, 28, 7, 10, 30];
+    let y = [20, 11, 17, 12, 5, 31, 18, 2, 34];
+
+    let (stat_incl, p_incl) = mannwhitneyu(
+        &x,
+        &y,
+        MannWhitneyUMethod::AsymptoticInclContinuityCorrection,
+        Alternative::TwoSided,
+    )
+    .unwrap();
+    let (stat_excl, p_excl) = mannwhitneyu(
+        &x,
+        &y,
+        MannWhitneyUMethod::AsymptoticExclContinuityCorrection,
+        Alternative::TwoSided,
+    )
+    .unwrap();
+
+    // Same statistic either way; only the p-value moves.
+    assert_eq!(stat_incl, stat_excl);
+    // The continuity correction shrinks the absolute z score, so it raises the p-value.
+    assert!(p_incl > p_excl);
+
+    // Both samples hold more than eight values, so Automatic takes the corrected route.
+    let (stat_auto, p_auto) =
+        mannwhitneyu(&x, &y, MannWhitneyUMethod::Automatic, Alternative::TwoSided).unwrap();
+    assert_eq!(stat_auto, stat_incl);
+    assert!(prec::almost_eq(p_auto, p_incl, 1e-12));
+
+    // Reference values for the asymptotic branch, both continuity settings and all three
+    // alternatives. These come from the normal approximation with the tie correction, computed
+    // outside the crate, so they check agreement with the reference rather than the code
+    // against itself.
+    let (_, p) = mannwhitneyu(&x, &y, MannWhitneyUMethod::AsymptoticInclContinuityCorrection, Alternative::Less).unwrap();
+    assert!(prec::almost_eq(p, 0.78661163173350812, 1e-9));
+    let (_, p) = mannwhitneyu(&x, &y, MannWhitneyUMethod::AsymptoticInclContinuityCorrection, Alternative::Greater).unwrap();
+    assert!(prec::almost_eq(p, 0.23996434607297862, 1e-9));
+    let (_, p) = mannwhitneyu(&x, &y, MannWhitneyUMethod::AsymptoticInclContinuityCorrection, Alternative::TwoSided).unwrap();
+    assert!(prec::almost_eq(p, 0.47992869214595724, 1e-9));
+    let (_, p) = mannwhitneyu(&x, &y, MannWhitneyUMethod::AsymptoticExclContinuityCorrection, Alternative::Less).unwrap();
+    assert!(prec::almost_eq(p, 0.77354375828754152, 1e-9));
+    let (_, p) = mannwhitneyu(&x, &y, MannWhitneyUMethod::AsymptoticExclContinuityCorrection, Alternative::Greater).unwrap();
+    assert!(prec::almost_eq(p, 0.22645624171245846, 1e-9));
+    let (_, p) = mannwhitneyu(&x, &y, MannWhitneyUMethod::AsymptoticExclContinuityCorrection, Alternative::TwoSided).unwrap();
+    assert!(prec::almost_eq(p, 0.45291248342491691, 1e-9));
+
+    // Pooled ties send Automatic to the asymptotic branch even though both samples are well
+    // under the size threshold. Three against three, with one value shared across the two
+    // samples, so the pooled data has a tie while neither sample has one on its own.
+    let tie_x = [1, 2, 3];
+    let tie_y = [3, 4, 5];
+    let (stat_tie_auto, p_tie_auto) =
+        mannwhitneyu(&tie_x, &tie_y, MannWhitneyUMethod::Automatic, Alternative::TwoSided).unwrap();
+    let (stat_tie_incl, p_tie_incl) = mannwhitneyu(
+        &tie_x,
+        &tie_y,
+        MannWhitneyUMethod::AsymptoticInclContinuityCorrection,
+        Alternative::TwoSided,
+    )
+    .unwrap();
+    assert_eq!(stat_tie_auto, stat_tie_incl);
+    assert!(prec::almost_eq(p_tie_auto, p_tie_incl, 1e-12));
+    // ... and the reference value for that input, so this is not a comparison with itself.
+    assert!(prec::almost_eq(p_tie_auto, 0.12118327283746322, 1e-9));
+    let (_, p_tie_less) = mannwhitneyu(
+        &tie_x,
+        &tie_y,
+        MannWhitneyUMethod::AsymptoticInclContinuityCorrection,
+        Alternative::Less,
+    )
+    .unwrap();
+    assert!(prec::almost_eq(p_tie_less, 0.06059163641873161, 1e-9));
+    let (_, p_tie_excl) = mannwhitneyu(
+        &tie_x,
+        &tie_y,
+        MannWhitneyUMethod::AsymptoticExclContinuityCorrection,
+        Alternative::Less,
+    )
+    .unwrap();
+    assert!(prec::almost_eq(p_tie_excl, 0.03826125023752960, 1e-9));
+    // The exact method refuses the same input rather than falling back.
+    assert_eq!(
+        mannwhitneyu(&tie_x, &tie_y, MannWhitneyUMethod::Exact, Alternative::TwoSided),
+        Err(MannWhitneyUError::ExactMethodWithTiesInData)
+    );
+    // A tie-free pair of the same size still takes the exact route.
+    let free_x = [1, 2, 3];
+    let free_y = [4, 5, 6];
+    let (_, p_free_auto) =
+        mannwhitneyu(&free_x, &free_y, MannWhitneyUMethod::Automatic, Alternative::Less).unwrap();
+    let (_, p_free_exact) =
+        mannwhitneyu(&free_x, &free_y, MannWhitneyUMethod::Exact, Alternative::Less).unwrap();
+    assert!(prec::almost_eq(p_free_auto, p_free_exact, 1e-12));
+    assert!(prec::almost_eq(p_free_auto, 0.05, 1e-9));
+
+    // Exact has no size limit of its own. The size threshold belongs to Automatic, so asking
+    // for Exact on nine against nine has to give the exact answer rather than being refused or
+    // quietly downgraded to the approximation.
+    let nine_a = [1, 3, 5, 7, 9, 11, 13, 15, 17];
+    let nine_b = [2, 4, 6, 8, 10, 12, 14, 16, 18];
+    let (_, p_forced_exact) =
+        mannwhitneyu(&nine_a, &nine_b, MannWhitneyUMethod::Exact, Alternative::TwoSided).unwrap();
+    let (_, p_auto_same) = mannwhitneyu(
+        &nine_a,
+        &nine_b,
+        MannWhitneyUMethod::Automatic,
+        Alternative::TwoSided,
+    )
+    .unwrap();
+    assert!(prec::almost_eq(p_forced_exact, 0.7304401480872069, 1e-9));
+    // Automatic goes the other way on the same input, because both samples are over eight.
+    assert!((p_forced_exact - p_auto_same).abs() > 1e-6);
+
+    // Only one sample over the threshold is not enough to leave the exact route. Nine values
+    // against five, with no ties, still has to match Exact and not the approximation.
+    let nine = [1, 3, 5, 7, 9, 11, 13, 15, 17];
+    let five = [2, 4, 6, 8, 10];
+    let (_, p_mixed_auto) = mannwhitneyu(
+        &nine,
+        &five,
+        MannWhitneyUMethod::Automatic,
+        Alternative::TwoSided,
+    )
+    .unwrap();
+    let (_, p_mixed_exact) =
+        mannwhitneyu(&nine, &five, MannWhitneyUMethod::Exact, Alternative::TwoSided).unwrap();
+    let (_, p_mixed_asym) = mannwhitneyu(
+        &nine,
+        &five,
+        MannWhitneyUMethod::AsymptoticInclContinuityCorrection,
+        Alternative::TwoSided,
+    )
+    .unwrap();
+    assert!(prec::almost_eq(p_mixed_auto, p_mixed_exact, 1e-12));
+    assert!((p_mixed_auto - p_mixed_asym).abs() > 1e-6);
+}
