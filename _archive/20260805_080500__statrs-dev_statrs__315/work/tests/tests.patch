+#[test]
+fn error_enums_implement_display_and_the_error_trait() {
+    // Every error type has to be usable as a std::error::Error and print something.
+    fn check<E: std::error::Error>(e: E) {
+        assert!(!e.to_string().is_empty());
+        let as_dyn: &dyn std::error::Error = &e;
+        assert!(!format!("{as_dyn}").is_empty());
+        assert!(!format!("{e:?}").is_empty());
+    }
+    check(ChiSquareTestError::FObsInvalid);
+    check(ChiSquareTestError::FExpInvalid);
+    check(ChiSquareTestError::DdofInvalid);
+    check(FOneWayTestError::NotEnoughSamples);
+    check(FOneWayTestError::SampleTooSmall);
+    check(FOneWayTestError::SampleContainsSameConstants);
+    check(FOneWayTestError::SampleContainsNaN);
+    check(MannWhitneyUError::UncomparableData);
+    check(MannWhitneyUError::SampleTooSmall);
+    check(MannWhitneyUError::ExactMethodWithTiesInData);
+    check(TTestOneSampleError::SampleTooSmall);
+    check(TTestOneSampleError::SampleContainsNaN);
+    check(SkewTestError::SampleTooSmall);
+    check(SkewTestError::SampleContainsNaN);
+    check(AndersonDarlingError::SampleTooSmall);
+    check(AndersonDarlingError::SampleContainsNaN);
+}
