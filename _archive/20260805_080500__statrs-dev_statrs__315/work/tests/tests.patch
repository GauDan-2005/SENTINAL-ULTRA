+#[test]
+fn chisquare_ddof_reduces_the_degrees_of_freedom() {
+    let f_obs = [16, 18, 16, 14, 12, 12];
+
+    // Six categories, so the largest accepted ddof is four.
+    let (stat_default, p_default) = chisquare(&f_obs, None, None).unwrap();
+    let (stat_ddof, p_ddof) = chisquare(&f_obs, None, Some(4)).unwrap();
+
+    // ddof does not touch the statistic, only the reference distribution.
+    assert!(prec::almost_eq(stat_default, stat_ddof, 1e-12));
+    // Fewer degrees of freedom put the same statistic further into the tail.
+    assert!(p_ddof < p_default);
+    // Some(0) is the documented default.
+    let (_, p_zero) = chisquare(&f_obs, None, Some(0)).unwrap();
+    assert!(prec::almost_eq(p_zero, p_default, 1e-12));
+}
