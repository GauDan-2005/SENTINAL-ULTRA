+#[test]
+fn mannwhitneyu_error_cases() {
+    // empty x
+    assert_eq!(
+        mannwhitneyu(
+            &[] as &[i32],
+            &[1, 2, 3],
+            MannWhitneyUMethod::Automatic,
+            Alternative::TwoSided,
+        ),
+        Err(MannWhitneyUError::SampleTooSmall)
+    );
+    // empty y
+    assert_eq!(
+        mannwhitneyu(
+            &[1, 2, 3],
+            &[] as &[i32],
+            MannWhitneyUMethod::Automatic,
+            Alternative::TwoSided,
+        ),
+        Err(MannWhitneyUError::SampleTooSmall)
+    );
+    // Exact method with ties
+    assert_eq!(
+        mannwhitneyu(
+            &[1, 2],
+            &[1, 2, 3],
+            MannWhitneyUMethod::Exact,
+            Alternative::TwoSided,
+        ),
+        Err(MannWhitneyUError::ExactMethodWithTiesInData)
+    );
+
+    // Unorderable data and the precedence of an empty sample, folded in from the
+    // separate case they used to have.
+    let with_nan = [1.0f64, 2.0, f64::NAN, 4.0];
+    let plain = [3.0f64, 5.0, 6.0];
+
+    // A NaN makes a pair of values unorderable, whichever sample it sits in.
+    assert_eq!(
+        mannwhitneyu(
+            &with_nan,
+            &plain,
+            MannWhitneyUMethod::Automatic,
+            Alternative::TwoSided
+        ),
+        Err(MannWhitneyUError::UncomparableData)
+    );
+    assert_eq!(
+        mannwhitneyu(
+            &plain,
+            &with_nan,
+            MannWhitneyUMethod::Automatic,
+            Alternative::TwoSided
+        ),
+        Err(MannWhitneyUError::UncomparableData)
+    );
+
+    // An empty sample is named ahead of the unorderable data.
+    assert_eq!(
+        mannwhitneyu(
+            &[] as &[f64],
+            &with_nan,
+            MannWhitneyUMethod::Automatic,
+            Alternative::TwoSided
+        ),
+        Err(MannWhitneyUError::SampleTooSmall)
+    );
+}
