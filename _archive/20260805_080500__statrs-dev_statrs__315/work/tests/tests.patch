+#[test]
+fn anderson_darling_matches_the_reference_statistic() {
+    // A fully specified standard normal, so nothing is estimated from the sample and the
+    // expected values are fixed. The reference numbers were computed outside the crate.
+    let dist = Normal::new(0.0, 1.0).unwrap();
+    let sample = vec![-1.2, -0.4, 0.1, 0.35, 0.9, 1.6, -0.75, 0.25];
+    let (statistic, pvalue) = anderson_darling(sample, &dist, NaNPolicy::Error).unwrap();
+    assert!(prec::almost_eq(statistic, 0.19666521574821871, 1e-9));
+    assert!(prec::almost_eq(pvalue, 0.82983792335537543, 1e-9));
+
+    // The statistic handed back is the unadjusted one. The small sample adjustment is used
+    // for the p-value only, so the returned value must NOT be the adjusted figure.
+    assert!(!prec::almost_eq(statistic, 0.22201659121576253, 1e-9));
+
+    // The sample is given out of order on purpose. Sorting is the caller's problem to solve,
+    // and a re-ordered copy of the same observations has to give the same answer.
+    let sorted = vec![-1.2, -0.75, -0.4, 0.1, 0.25, 0.35, 0.9, 1.6];
+    let (statistic_sorted, pvalue_sorted) =
+        anderson_darling(sorted, &dist, NaNPolicy::Error).unwrap();
+    assert!(prec::almost_eq(statistic, statistic_sorted, 1e-12));
+    assert!(prec::almost_eq(pvalue, pvalue_sorted, 1e-12));
+
+    // A sample that sits badly against the distribution has to score worse than one that
+    // does not, on both the statistic and the p-value.
+    let poor = vec![4.0, 4.5, 5.0, 5.5, 6.0, 6.5, 7.0, 7.5];
+    let (statistic_poor, pvalue_poor) = anderson_darling(poor, &dist, NaNPolicy::Error).unwrap();
+    assert!(statistic_poor > statistic);
+    assert!(pvalue_poor < pvalue);
+}
