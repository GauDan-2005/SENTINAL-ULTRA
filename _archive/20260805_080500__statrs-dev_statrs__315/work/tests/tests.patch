+#[test]
+fn anderson_darling_error_cases() {
+    let dist = Normal::new(0.0, 1.0).unwrap();
+    // Nothing to test at all.
+    assert_eq!(
+        anderson_darling(vec![], &dist, NaNPolicy::Error),
+        Err(AndersonDarlingError::SampleTooSmall)
+    );
+    // NaN under the Error policy.
+    assert_eq!(
+        anderson_darling(vec![0.1, f64::NAN, 0.4], &dist, NaNPolicy::Error),
+        Err(AndersonDarlingError::SampleContainsNaN)
+    );
+    // The NaN rules run before the size rule, so Emit can empty the sample and the size rule
+    // then fires on what is left.
+    assert_eq!(
+        anderson_darling(vec![f64::NAN, f64::NAN], &dist, NaNPolicy::Emit),
+        Err(AndersonDarlingError::SampleTooSmall)
+    );
+    // Propogate keeps the call successful and returns NaN for both outputs.
+    let (statistic, pvalue) =
+        anderson_darling(vec![0.1, f64::NAN, 0.4], &dist, NaNPolicy::Propogate).unwrap();
+    assert!(statistic.is_nan());
+    assert!(pvalue.is_nan());
+    // Emit on a sample that still has observations left agrees with the same call on data
+    // cleaned by hand.
+    let (s_emit, p_emit) = anderson_darling(
+        vec![-1.2, f64::NAN, -0.4, 0.1, 0.35, 0.9, 1.6, -0.75, 0.25, f64::NAN],
+        &dist,
+        NaNPolicy::Emit,
+    )
+    .unwrap();
+    let (s_clean, p_clean) = anderson_darling(
+        vec![-1.2, -0.4, 0.1, 0.35, 0.9, 1.6, -0.75, 0.25],
+        &dist,
+        NaNPolicy::Error,
+    )
+    .unwrap();
+    assert!(prec::almost_eq(s_emit, s_clean, 1e-12));
+    assert!(prec::almost_eq(p_emit, p_clean, 1e-12));
+}
