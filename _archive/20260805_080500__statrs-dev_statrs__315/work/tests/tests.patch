+#[test]
+fn chisquare_scipy_example() {
+    let (statistic, pvalue) = chisquare(&[16, 18, 16, 14, 12, 12], None, None).unwrap();
+    assert!(prec::almost_eq(statistic, 2.0, 1e-9));
+    assert!(prec::almost_eq(pvalue, 0.84914503608460956, 1e-9));
+
+    let (statistic, pvalue) = chisquare(
+        &[16, 18, 16, 14, 12, 12],
+        Some(&[16.0, 16.0, 16.0, 16.0, 16.0, 8.0]),
+        None,
+    )
+    .unwrap();
+    assert!(prec::almost_eq(statistic, 3.5, 1e-9));
+    assert!(prec::almost_eq(pvalue, 0.62338762774958223, 1e-9));
+}
+
+#[test]
+fn chisquare_invalid_inputs() {
+    assert_eq!(
+        chisquare(&[16], None, None),
+        Err(ChiSquareTestError::FObsInvalid)
+    );
+    assert_eq!(
+        chisquare(&[16, 18, 16, 14, 12, 12], None, Some(5)),
+        Err(ChiSquareTestError::DdofInvalid)
+    );
+
+    // Precedence. Every input below breaks more than one rule at once, so the variant that
+    // comes back pins the order the checks run in rather than just one check on its own.
+    // f_obs comes first, ahead of both a bad f_exp and a bad ddof.
+    assert_eq!(
+        chisquare(&[16], Some(&[1.0, 2.0, 3.0]), Some(99)),
+        Err(ChiSquareTestError::FObsInvalid)
+    );
+    // f_exp comes ahead of ddof, on a length mismatch ...
+    assert_eq!(
+        chisquare(&[16, 18, 16, 14, 12, 12], Some(&[1.0, 2.0]), Some(99)),
+        Err(ChiSquareTestError::FExpInvalid)
+    );
+    // ... and on a total mismatch.
+    assert_eq!(
+        chisquare(&[16, 18, 16, 14, 12, 12], Some(&[16.0; 6]), Some(99)),
+        Err(ChiSquareTestError::FExpInvalid)
+    );
+    // ddof is only reported once f_obs and f_exp are both good.
+    assert_eq!(
+        chisquare(
+            &[16, 18, 16, 14, 12, 12],
+            Some(&[16.0, 16.0, 16.0, 16.0, 16.0, 8.0]),
+            Some(5)
+        ),
+        Err(ChiSquareTestError::DdofInvalid)
+    );
+
+    // f_exp validation, folded in from the separate case it used to have.
+    // wrong length
+    assert_eq!(
+        chisquare(&[16, 18, 16, 14, 12, 12], Some(&[1.0, 2.0, 3.0]), None),
+        Err(ChiSquareTestError::FExpInvalid)
+    );
+    // correct length but wrong sum (96 != 88)
+    assert_eq!(
+        chisquare(&[16, 18, 16, 14, 12, 12], Some(&[16.0; 6]), None),
+        Err(ChiSquareTestError::FExpInvalid)
+    );
+    // Totals are compared as whole numbers. f_obs sums to 88, so an f_exp summing to 88.7 is
+    // accepted because it is still 88 once the fraction is dropped ...
+    assert!(chisquare(
+        &[16, 18, 16, 14, 12, 12],
+        Some(&[16.7, 16.0, 16.0, 16.0, 16.0, 8.0]),
+        None
+    )
+    .is_ok());
+    // ... while one summing to 87.9 falls into the whole number below and is rejected.
+    assert_eq!(
+        chisquare(
+            &[16, 18, 16, 14, 12, 12],
+            Some(&[15.9, 16.0, 16.0, 16.0, 16.0, 8.0]),
+            None
+        ),
+        Err(ChiSquareTestError::FExpInvalid)
+    );
+}
