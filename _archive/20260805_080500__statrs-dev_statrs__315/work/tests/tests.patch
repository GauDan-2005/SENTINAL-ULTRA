+#[test]
+fn f_oneway_scipy_example() {
+    let a1 = Vec::from([6f64, 8f64, 4f64, 5f64, 3f64, 4f64]);
+    let a2 = Vec::from([8f64, 12f64, 9f64, 11f64, 6f64, 8f64]);
+    let a3 = Vec::from([13f64, 9f64, 11f64, 8f64, 7f64, 12f64]);
+    let sample_input = Vec::from([a1, a2, a3]);
+    let (statistic, pvalue) = f_oneway(sample_input, NaNPolicy::Error).unwrap();
+    assert!(prec::almost_eq(statistic, 9.264705882352942, 1e-9));
+    assert!(prec::almost_eq(pvalue, 0.00239877732939298, 1e-9));
+}
+
+#[test]
+fn f_oneway_error_cases() {
+    // fewer than two groups
+    assert_eq!(
+        f_oneway(vec![vec![1.0, 2.0, 3.0]], NaNPolicy::Error),
+        Err(FOneWayTestError::NotEnoughSamples)
+    );
+    // NaN input with NaNPolicy::Error
+    assert_eq!(
+        f_oneway(
+            vec![vec![1.0, f64::NAN, 3.0], vec![4.0, 5.0, 6.0]],
+            NaNPolicy::Error
+        ),
+        Err(FOneWayTestError::SampleContainsNaN)
+    );
+    // all values the same in a group
+    assert_eq!(
+        f_oneway(vec![vec![1.0, 1.0], vec![2.0, 2.0]], NaNPolicy::Error),
+        Err(FOneWayTestError::SampleContainsSameConstants)
+    );
+
+    // Sample size rules, folded in from the separate case they used to have.
+    // one group is empty
+    assert_eq!(
+        f_oneway(vec![vec![], vec![1.0, 2.0, 3.0]], NaNPolicy::Error),
+        Err(FOneWayTestError::SampleTooSmall)
+    );
+    // two groups, but no group holds at least two values
+    assert_eq!(
+        f_oneway(vec![vec![1.0], vec![2.0]], NaNPolicy::Error),
+        Err(FOneWayTestError::SampleTooSmall)
+    );
+    // fewer than two groups outranks the size rule
+    assert_eq!(
+        f_oneway(vec![vec![]], NaNPolicy::Error),
+        Err(FOneWayTestError::NotEnoughSamples)
+    );
+}
