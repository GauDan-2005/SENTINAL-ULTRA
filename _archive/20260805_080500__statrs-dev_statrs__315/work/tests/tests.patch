+//! Integration tests for the hypothesis test functions added in PR #315:
+//! Mann-Whitney U test, one-way ANOVA F-test, one-sample t-test, chi-square
+//! test, and skewtest. Expected values are taken from the scipy-validated
+//! examples used in the PR.
+
+use statrs::distribution::Normal;
+use statrs::prec;
+use statrs::stats_tests::anderson_darling::{anderson_darling, AndersonDarlingError};
+use statrs::stats_tests::chisquare::{chisquare, ChiSquareTestError};
+use statrs::stats_tests::f_oneway::{f_oneway, FOneWayTestError};
+use statrs::stats_tests::mannwhitneyu::{mannwhitneyu, MannWhitneyUError, MannWhitneyUMethod};
+use statrs::stats_tests::skewtest::{skewtest, SkewTestError};
+use statrs::stats_tests::ttest_onesample::{ttest_onesample, TTestOneSampleError};
+use statrs::stats_tests::{Alternative, NaNPolicy};
