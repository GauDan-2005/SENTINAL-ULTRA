@@ -0,0 +1,120 @@
+use crate::distribution::ContinuousCDF;
+use crate::stats_tests::NaNPolicy;
+
+/// Represents the errors that can occur when computing the anderson_darling function
+#[derive(Copy, Clone, PartialEq, Eq, Debug, Hash)]
+#[non_exhaustive]
+pub enum AndersonDarlingError {
+    /// sample must hold at least one observation once any NaNs have been handled
+    SampleTooSmall,
+    /// sample contains NaN and the NaNPolicy is Error
+    SampleContainsNaN,
+}
+
+impl std::fmt::Display for AndersonDarlingError {
+    #[cfg_attr(coverage_nightly, coverage(off))]
+    fn fmt(&self, f: &mut std::fmt::Formatter) -> std::fmt::Result {
+        match self {
+            AndersonDarlingError::SampleTooSmall => {
+                write!(f, "sample must have at least one observation")
+            }
+            AndersonDarlingError::SampleContainsNaN => {
+                write!(f, "sample contains NaN when the NaNPolicy is Error")
+            }
+        }
+    }
+}
+
+impl std::error::Error for AndersonDarlingError {}
+
+/// Perform an Anderson-Darling goodness of fit test, comparing a sample against a
+/// fully specified continuous distribution.
+///
+/// Returns the unadjusted A-squared statistic together with a p-value taken from the
+/// small sample adjusted form of the statistic.
+pub fn anderson_darling<T: ContinuousCDF<f64, f64>>(
+    a: Vec<f64>,
+    dist: &T,
+    nan_policy: NaNPolicy,
+) -> Result<(f64, f64), AndersonDarlingError> {
+    let mut a = a;
+    let has_nans = a.iter().any(|x| x.is_nan());
+    if has_nans {
+        match nan_policy {
+            NaNPolicy::Propogate => {
+                return Ok((f64::NAN, f64::NAN));
+            }
+            NaNPolicy::Error => {
+                return Err(AndersonDarlingError::SampleContainsNaN);
+            }
+            NaNPolicy::Emit => {
+                a = a.into_iter().filter(|x| !x.is_nan()).collect::<Vec<_>>();
+            }
+        }
+    }
+
+    let n = a.len();
+    if n == 0 {
+        return Err(AndersonDarlingError::SampleTooSmall);
+    }
+
+    a.sort_unstable_by(|x, y| x.partial_cmp(y).unwrap());
+
+    let n_float = n as f64;
+    let beta: f64 = (1.0 / n_float)
+        * (0..n)
+            .map(|i| {
+                (2.0 * (i + 1) as f64 - 1.0)
+                    * (f64::ln(dist.cdf(a[i])) + f64::ln(1.0 - dist.cdf(a[n - 1 - i])))
+            })
+            .sum::<f64>();
+    let a_squared = -n_float - beta;
+    let a_squared_adjusted = a_squared * (1.0 + (0.75 / n_float) + (2.25 / n_float.powi(2)));
+    let p_value = if a_squared_adjusted >= 0.6 {
+        (1.2937 - 5.709 * a_squared_adjusted + 0.0186 * a_squared_adjusted.powi(2)).exp()
+    } else if a_squared_adjusted >= 0.34 {
+        (0.9177 - 4.279 * a_squared_adjusted - 1.38 * a_squared_adjusted.powi(2)).exp()
+    } else if a_squared_adjusted >= 0.2 {
+        1.0 - (-8.318 + 42.796 * a_squared_adjusted - 59.938 * a_squared_adjusted.powi(2)).exp()
+    } else {
+        1.0 - (-13.436 + 101.14 * a_squared_adjusted - 223.73 * a_squared_adjusted.powi(2)).exp()
+    };
+
+    Ok((a_squared, p_value))
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::distribution::Normal;
+
+    #[test]
+    fn test_good_fit() {
+        let data = vec![5.2, 4.9, 5.5, 4.8, 5.0, 5.1, 5.3, 4.7, 5.4, 4.9, 5.2, 5.0];
+        let n = data.len() as f64;
+        let mean = data.iter().sum::<f64>() / n;
+        let sd = (data.iter().map(|v| (v - mean).powi(2)).sum::<f64>() / (n - 1.0)).sqrt();
+        let dist = Normal::new(mean, sd).unwrap();
+        let (stat, pvalue) = anderson_darling(data, &dist, NaNPolicy::Error).unwrap();
+        assert!(stat < 0.5);
+        assert!(pvalue > 0.05);
+    }
+
+    #[test]
+    fn test_bad_data_sample_too_small() {
+        let dist = Normal::new(0.0, 1.0).unwrap();
+        assert_eq!(
+            anderson_darling(vec![], &dist, NaNPolicy::Error),
+            Err(AndersonDarlingError::SampleTooSmall)
+        );
+    }
+
+    #[test]
+    fn test_nan_in_data_w_error() {
+        let dist = Normal::new(0.0, 1.0).unwrap();
+        assert_eq!(
+            anderson_darling(vec![1.0, f64::NAN], &dist, NaNPolicy::Error),
+            Err(AndersonDarlingError::SampleContainsNaN)
+        );
+    }
+}
