+//! Verifier-only probe.
+//!
+//! The harness compiles this in a configuration where the `pqcp` feature is
+//! off. There the module must not exist, so this file must fail to compile. If
+//! it does compile, the new API is reachable without its feature.
+
+#![cfg(not(feature = "pqcp"))]
+
+#[test]
+fn pqcp_module_is_not_reachable_without_the_feature() {
+    let _ = libcrux_ml_kem::mlkem768::pqcp::PK_LEN;
+}
diff --git a/libcrux-ml-kem/tests/sentinel_pqcp_verifier.rs b/libcrux-ml-kem/tests/sentinel_pqcp_verifier.rs
