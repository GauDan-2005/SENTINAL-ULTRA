+//! Verifier-only probe.
+//!
+//! The harness compiles this with `pqcp` on and `rand` off. The four
+//! randomness-sampling entry points must not exist there, so this file must
+//! fail to compile. If it compiles, they were not gated on `rand`.
+
+#![cfg(all(feature = "pqcp", not(feature = "rand")))]
+
+use libcrux_ml_kem::mlkem768::pqcp::crypto_kem_enc as _;
+use libcrux_ml_kem::mlkem768::pqcp::crypto_kem_enc_struct as _;
+use libcrux_ml_kem::mlkem768::pqcp::crypto_kem_keypair as _;
+use libcrux_ml_kem::mlkem768::pqcp::crypto_kem_keypair_struct as _;
+
+#[test]
+fn rand_gated_functions_are_absent_without_the_rand_feature() {}
