+/*
+ * Hypervisor.framework stand-in for the Linux host-check build.
+ *
+ * Copyright 2026 elfuse contributors
+ * SPDX-License-Identifier: Apache-2.0
+ *
+ * elfuse is a macOS/Apple Silicon program, so its headers pull in
+ * <Hypervisor/Hypervisor.h> transitively almost everywhere. The host checks in
+ * this directory compile a handful of elfuse translation units for
+ * aarch64-linux and exercise them directly, which needs those types to exist
+ * but never needs the framework itself: every hv_* entry point is left
+ * undefined here and stubbed at link time, and no host check calls one.
+ *
+ * Nothing here is used by the macOS build.
+ */
+
+#pragma once
+
+#include <stddef.h>
+#include <stdint.h>
+
+struct hv_vcpu_exit_s;
+
+typedef uint64_t hv_vcpu_t;
+typedef int hv_return_t;
+typedef uint32_t hv_reg_t;
+typedef uint32_t hv_sys_reg_t;
+typedef uint32_t hv_simd_fp_reg_t;
+typedef uint64_t hv_ipa_t;
+typedef struct hv_vcpu_exit_s hv_vcpu_exit_t;
+
+#define HV_SUCCESS 0
+
+typedef struct {
+    unsigned char v[16];
+} hv_simd_fp_uchar16_t;
+
+enum {
+    HV_REG_X0 = 0, HV_REG_X1, HV_REG_X2, HV_REG_X3, HV_REG_X4, HV_REG_X5,
+    HV_REG_X6, HV_REG_X7, HV_REG_X8, HV_REG_X9, HV_REG_X10, HV_REG_X11,
+    HV_REG_X12, HV_REG_X13, HV_REG_X14, HV_REG_X15, HV_REG_X16, HV_REG_X17,
+    HV_REG_X18, HV_REG_X19, HV_REG_X20, HV_REG_X21, HV_REG_X22, HV_REG_X23,
+    HV_REG_X24, HV_REG_X25, HV_REG_X26, HV_REG_X27, HV_REG_X28,
+    HV_REG_FP, HV_REG_LR, HV_REG_PC, HV_REG_FPCR, HV_REG_FPSR, HV_REG_CPSR
+};
+
+enum {
+    HV_SYS_REG_ELR_EL1 = 0x4021, HV_SYS_REG_SPSR_EL1, HV_SYS_REG_SCTLR_EL1,
+    HV_SYS_REG_TPIDR_EL0, HV_SYS_REG_TPIDRRO_EL0, HV_SYS_REG_TPIDR_EL1,
+    HV_SYS_REG_MIDR_EL1, HV_SYS_REG_MPIDR_EL1, HV_SYS_REG_CNTV_CTL_EL0,
+    HV_SYS_REG_CNTV_CVAL_EL0, HV_SYS_REG_ESR_EL1, HV_SYS_REG_FAR_EL1,
+    HV_SYS_REG_VBAR_EL1, HV_SYS_REG_TTBR0_EL1, HV_SYS_REG_TTBR1_EL1,
+    HV_SYS_REG_TCR_EL1, HV_SYS_REG_MAIR_EL1, HV_SYS_REG_SP_EL0,
+    HV_SYS_REG_SP_EL1, HV_SYS_REG_CPACR_EL1
+};
+
+enum { HV_SIMD_FP_REG_Q0 = 0 };
+
+enum {
+    HV_EXIT_REASON_CANCELED = 0,
+    HV_EXIT_REASON_EXCEPTION,
+    HV_EXIT_REASON_VTIMER_ACTIVATED,
+    HV_EXIT_REASON_UNKNOWN
+};
+
+typedef struct {
+    uint64_t syndrome;
+    uint64_t virtual_address;
+    hv_ipa_t physical_address;
+} hv_vcpu_exit_exception_t;
+
+struct hv_vcpu_exit_s {
+    uint32_t reason;
+    hv_vcpu_exit_exception_t exception;
+};
+
+hv_return_t hv_vcpu_get_reg(hv_vcpu_t vcpu, hv_reg_t reg, uint64_t *value);
+hv_return_t hv_vcpu_set_reg(hv_vcpu_t vcpu, hv_reg_t reg, uint64_t value);
+hv_return_t hv_vcpu_get_sys_reg(hv_vcpu_t vcpu, hv_sys_reg_t reg,
+                                uint64_t *value);
+hv_return_t hv_vcpu_set_sys_reg(hv_vcpu_t vcpu, hv_sys_reg_t reg,
+                                uint64_t value);
+hv_return_t hv_vcpu_get_simd_fp_reg(hv_vcpu_t vcpu, hv_simd_fp_reg_t reg,
+                                    hv_simd_fp_uchar16_t *value);
+hv_return_t hv_vcpu_set_simd_fp_reg(hv_vcpu_t vcpu, hv_simd_fp_reg_t reg,
+                                    hv_simd_fp_uchar16_t value);
+hv_return_t hv_vcpu_run(hv_vcpu_t vcpu);
+hv_return_t hv_vcpus_exit(hv_vcpu_t *vcpus, uint32_t count);
+hv_return_t hv_vcpu_set_vtimer_mask(hv_vcpu_t vcpu, int masked);
