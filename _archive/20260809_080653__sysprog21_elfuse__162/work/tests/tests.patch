+#include <signal.h>
+#include <unistd.h>
+
+#undef si_addr
+#undef si_band
+#undef si_code
+#undef si_int
+#undef si_pid
+#undef si_ptr
+#undef si_status
+#undef si_uid
+#undef si_value
+
+#ifndef F_GETPATH
+#define F_GETPATH 50
+#endif
+
+#ifndef _CS_DARWIN_USER_TEMP_DIR
+#define _CS_DARWIN_USER_TEMP_DIR 65537
+#endif
