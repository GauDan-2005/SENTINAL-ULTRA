diff --git a/tests/sentinel-hostcheck/hostbuild.py b/tests/sentinel-hostcheck/hostbuild.py
new file mode 100644
index 0000000..c8a06cf
--- /dev/null
+++ b/tests/sentinel-hostcheck/hostbuild.py
@@ -0,0 +1,204 @@
+"""Build the Linux host-check probe out of the emulator's own sources.
+
+Copyright 2026 elfuse contributors
+SPDX-License-Identifier: Apache-2.0
+
+elfuse runs on macOS and its guest tests need a live VM, so a Linux CI host can
+run neither. The syscall handlers are ordinary C though, so this module
+cross-compiles the dispatch layer together with the time and process
+translation units for aarch64-linux, links them against the small stub set in
+this directory, and hands back a binary that qemu-user can run.
+
+Two things keep the build from being coupled to one particular implementation.
+Any symbol left undefined after the first link attempt is looked up across
+src/, and the file that defines it is pulled into the build, so a handler put
+in a new file still links. Whatever is left after that belongs to parts of the
+emulator no probe reaches (the VM, the debugger, the filesystem layer) and is
+filled in with an inert placeholder.
+"""
+
+from __future__ import annotations
+
+import os
+import re
+import shutil
+import subprocess
+
+HERE = os.path.dirname(os.path.abspath(__file__))
+ROOT = os.path.dirname(os.path.dirname(HERE))
+
+CC = "aarch64-linux-gnu-gcc"
+RUNNER = "qemu-aarch64-static"
+
+UNDEF_RE = re.compile(r"undefined reference to [`'\"]([A-Za-z_][A-Za-z0-9_]*)")
+TLS_RE = re.compile(r"([A-Za-z_][A-Za-z0-9_]*): (?:TLS reference in .*? "
+                    r"mismatches non-TLS definition|non-TLS reference in .*? "
+                    r"mismatches TLS definition)")
+
+
+class BuildError(RuntimeError):
+    """Raised when the probe cannot be built. Carries the compiler output."""
+
+
+def _run(cmd, **kw):
+    return subprocess.run(cmd, capture_output=True, text=True, **kw)
+
+
+def tools_present():
+    return shutil.which(CC) is not None and shutil.which(RUNNER) is not None
+
+
+def _flags(build_dir):
+    hv = os.path.join("tests", "sentinel-hostcheck", "hvshim")
+    hc = os.path.join("tests", "sentinel-hostcheck")
+    return [
+        "-O1",
+        "-g0",
+        "-std=gnu11",
+        "-include", os.path.join(hv, "prelude.h"),
+        "-I", hv,
+        "-I", hc,
+        "-I", "src",
+        "-I", build_dir,
+        "-Wno-implicit-function-declaration",
+        "-Wno-builtin-declaration-mismatch",
+        "-Wno-int-conversion",
+    ]
+
+
+def _compile(src, obj, build_dir, bare=False):
+    """Compile one file. `bare` drops the elfuse include path and the forced
+    prelude, which is what the generated placeholder file needs: it declares
+    nothing but bare symbol names and must not meet any real prototype."""
+    flags = ["-O1", "-g0", "-std=gnu11"] if bare else _flags(build_dir)
+    res = _run([CC] + flags + ["-c", src, "-o", obj], cwd=ROOT)
+    return res.returncode == 0, res.stderr
+
+
+def _defining_source(symbol):
+    """Find a src/ file that defines `symbol` at the start of a line."""
+    pattern = re.compile(
+        r"^[A-Za-z_][A-Za-z0-9_ \*\t]*\b%s\s*\(" % re.escape(symbol), re.MULTILINE
+    )
+    for dirpath, _dirs, files in os.walk(os.path.join(ROOT, "src")):
+        for name in sorted(files):
+            if not name.endswith(".c"):
+                continue
+            path = os.path.join(dirpath, name)
+            try:
+                with open(path, encoding="utf-8", errors="replace") as fh:
+                    if pattern.search(fh.read()):
+                        return os.path.relpath(path, ROOT)
+            except OSError:
+                continue
+    return None
+
+
+def generate_dispatch_header(build_dir):
+    """Run the repo's own generator. It only succeeds when the syscall number
+    table, the dispatch manifest and the wrapper definitions agree."""
+    out = os.path.join(build_dir, "dispatch.h")
+    res = _run(
+        ["python3", os.path.join("scripts", "gen-syscall-dispatch.py"),
+         "--output", out],
+        cwd=ROOT,
+    )
+    return res.returncode, out, (res.stdout + res.stderr)
+
+
+def build_probe(build_dir):
+    """Compile and link the probe. Returns its path."""
+    os.makedirs(build_dir, exist_ok=True)
+    rc, _header, log = generate_dispatch_header(build_dir)
+    if rc != 0:
+        raise BuildError(
+            "the syscall dispatch generator failed, so the number table, the "
+            "dispatch manifest and the wrappers do not agree:\n" + log)
+
+    objs = []
+    sources = ["src/syscall/time.c", "src/syscall/proc.c",
+               "tests/sentinel-hostcheck/stubs.c",
+               "tests/sentinel-hostcheck/probe_core.c"]
+    for src in sources:
+        obj = os.path.join(build_dir, src.replace("/", "_") + ".o")
+        ok, err = _compile(src, obj, build_dir)
+        if not ok:
+            raise BuildError("could not compile %s:\n%s" % (src, err))
+        objs.append(obj)
+
+    probe = os.path.join(build_dir, "probe_core")
+    tried_sources = set(sources)
+    inert = set()
+    inert_tls = set()
+
+    def write_placeholders():
+        path = os.path.join(build_dir, "inert.c")
+        with open(path, "w", encoding="utf-8") as fh:
+            fh.write("/* Placeholders for emulator internals no probe reaches. */\n")
+            for symbol in sorted(inert_tls):
+                fh.write("__thread long %s;\n" % symbol)
+            for symbol in sorted(inert - inert_tls):
+                fh.write("long %s();\nlong %s() { return 0; }\n"
+                         % (symbol, symbol))
+        return path
+
+    for _attempt in range(10):
+        cmd = [CC, "-static"] + objs + ["-o", probe, "-lpthread"]
+        res = _run(cmd, cwd=ROOT)
+        if res.returncode == 0:
+            return probe
+        tls = set(TLS_RE.findall(res.stderr))
+        if tls - inert_tls:
+            inert_tls.update(tls)
+            inert.update(tls)
+            obj = os.path.join(build_dir, "inert.o")
+            ok, err = _compile(os.path.relpath(write_placeholders(), ROOT),
+                               obj, build_dir, bare=True)
+            if not ok:
+                raise BuildError("could not compile placeholders:\n" + err)
+            objs = [o for o in objs if not o.endswith("inert.o")] + [obj]
+            continue
+
+        missing = sorted(set(UNDEF_RE.findall(res.stderr)))
+        if not missing:
+            raise BuildError("link failed:\n" + res.stderr)
+
+        progressed = False
+        for symbol in missing:
+            src = _defining_source(symbol)
+            if src and src not in tried_sources:
+                tried_sources.add(src)
+                obj = os.path.join(build_dir, src.replace("/", "_") + ".o")
+                ok, _err = _compile(src, obj, build_dir)
+                if ok:
+                    objs.append(obj)
+                    progressed = True
+        if progressed:
+            continue
+
+        new = [s for s in missing if s not in inert]
+        if not new:
+            raise BuildError("link failed:\n" + res.stderr)
+        inert.update(new)
+        path = write_placeholders()
+        obj = os.path.join(build_dir, "inert.o")
+        ok, err = _compile(os.path.relpath(path, ROOT), obj, build_dir,
+                           bare=True)
+        if not ok:
+            raise BuildError("could not compile placeholders:\n" + err)
+        objs = [o for o in objs if not o.endswith("inert.o")] + [obj]
+
+    raise BuildError("link did not settle after several attempts")
+
+
+def run_scenario(probe, scenario, timeout=180):
+    res = _run([RUNNER, probe, scenario], timeout=timeout)
+    values = {}
+    for line in res.stdout.splitlines():
+        if "=" in line:
+            key, _, val = line.partition("=")
+            try:
+                values[key.strip()] = int(val.strip())
+            except ValueError:
+                values[key.strip()] = val.strip()
+    return res.returncode, values, res.stdout + res.stderr
