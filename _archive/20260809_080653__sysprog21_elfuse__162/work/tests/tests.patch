diff --git a/tests/sentinel-hostcheck/hostcheck.h b/tests/sentinel-hostcheck/hostcheck.h
new file mode 100644
index 0000000..ee2da6f
--- /dev/null
+++ b/tests/sentinel-hostcheck/hostcheck.h
@@ -0,0 +1,31 @@
+/*
+ * Shared scaffolding for the Linux host checks.
+ *
+ * Copyright 2026 elfuse contributors
+ * SPDX-License-Identifier: Apache-2.0
+ *
+ * Each probe is a small aarch64-linux program that links one or more elfuse
+ * translation units, drives them, and prints what it observed as `key=value`
+ * lines. The probes make no judgement about what is correct: they report, and
+ * the pytest suite decides. That keeps the expected behaviour in one readable
+ * place and keeps the probe from quietly agreeing with whatever it measured.
+ */
+
+#pragma once
+
+#include <inttypes.h>
+#include <stdio.h>
+#include <string.h>
+
+static inline void report_i(const char *key, long long value)
+{
+    printf("%s=%lld\n", key, value);
+}
+
+static inline void report_s(const char *key, const char *value)
+{
+    printf("%s=%s\n", key, value);
+}
+
+/* Scenario dispatch: probes are invoked as `probe <scenario>`. */
+#define SCENARIO(name) (argc > 1 && strcmp(argv[1], (name)) == 0)
