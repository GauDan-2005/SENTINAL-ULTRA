diff --git a/internal/client/func.go b/internal/client/func.go
index 1957e15..f2ac1c5 100644
--- a/internal/client/func.go
+++ b/internal/client/func.go
@@ -2,6 +2,7 @@ package client
 
 import (
 	"bytes"
+	"errors"
 	"strings"
 
 	"RedisShake/internal/client/proto"
@@ -26,3 +27,36 @@ func (r *Redis) IsCluster() bool {
 	reply := r.DoWithStringReply("INFO", "Cluster")
 	return strings.Contains(reply, "cluster_enabled:1")
 }
+
+// ParseServerVersion reports whether the server an INFO reply describes is Valkey.
+//
+// A Valkey server also publishes a redis_version line so that Redis clients keep working,
+// and it publishes that line before its own, so a reply cannot be judged by whichever
+// version line turns up first.
+func ParseServerVersion(serverInfo string) (isValkey bool, err error) {
+	sawRedis := false
+	for _, line := range strings.Split(serverInfo, "\n") {
+		line = strings.TrimSpace(line)
+		if strings.HasPrefix(line, "valkey_version:") {
+			return true, nil
+		}
+		if strings.HasPrefix(line, "redis_version:") {
+			sawRedis = true
+		}
+	}
+	if sawRedis {
+		return false, nil
+	}
+	return false, errors.New("server version not found in info string")
+}
+
+// IsValkey reports whether the connected server is Valkey.
+func (r *Redis) IsValkey() bool {
+	reply := r.DoWithStringReply("INFO", "server")
+	isValkey, err := ParseServerVersion(reply)
+	if err != nil {
+		log.Warnf("failed to detect server type: %v, assuming Redis", err)
+		return false
+	}
+	return isValkey
+}
