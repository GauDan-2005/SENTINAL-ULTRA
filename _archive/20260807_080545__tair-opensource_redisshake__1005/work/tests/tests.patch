@@ -0,0 +1,172 @@
+package writer
+
+import (
+	"bufio"
+	"context"
+	"fmt"
+	"io"
+	"net"
+	"os"
+	"os/exec"
+	"strconv"
+	"strings"
+	"testing"
+	"time"
+
+	"RedisShake/internal/config"
+	"RedisShake/internal/entry"
+)
+
+// A hash field can hold a value larger than the target's query buffer allows in one go. The
+// writer throttles on how much it has already sent and not yet had answered, and an entry that
+// is on its own bigger than that allowance has to go out anyway, because nothing will ever come
+// back to make room for it.
+//
+// The writer ends the process on a protocol error, so this runs in a child copy of the test
+// binary and the parent reads the verdict off its output.
+
+const (
+	sentinelWriterChildFlag = "SENTINEL_WRITER_CHILD"
+	sentinelWriterSent      = "SENTINELWRITER SENT"
+	sentinelWriterStuck     = "SENTINELWRITER STUCK"
+)
+
+// sentinelReadOneCommand reads a single RESP array of bulk strings.
+func sentinelReadOneCommand(rd *bufio.Reader) ([]string, error) {
+	line, err := rd.ReadString('\n')
+	if err != nil {
+		return nil, err
+	}
+	line = strings.TrimRight(line, "\r\n")
+	if len(line) == 0 || line[0] != '*' {
+		return nil, fmt.Errorf("not an array: %q", line)
+	}
+	n, err := strconv.Atoi(line[1:])
+	if err != nil {
+		return nil, err
+	}
+	argv := make([]string, 0, n)
+	for i := 0; i < n; i++ {
+		head, err := rd.ReadString('\n')
+		if err != nil {
+			return nil, err
+		}
+		head = strings.TrimRight(head, "\r\n")
+		if len(head) == 0 || head[0] != '$' {
+			return nil, fmt.Errorf("not a bulk string: %q", head)
+		}
+		l, err := strconv.Atoi(head[1:])
+		if err != nil {
+			return nil, err
+		}
+		buf := make([]byte, l+2)
+		if _, err := io.ReadFull(rd, buf); err != nil {
+			return nil, err
+		}
+		argv = append(argv, string(buf[:l]))
+	}
+	return argv, nil
+}
+
+// TestSentinelWriterLivenessHelper is the child half and is not graded.
+func TestSentinelWriterLivenessHelper(t *testing.T) {
+	if os.Getenv(sentinelWriterChildFlag) != "1" {
+		t.Skip("helper process for sentinelWriteOversized")
+	}
+
+	arrived := make(chan string, 8)
+	ln, err := net.Listen("tcp", "127.0.0.1:0")
+	if err != nil {
+		return
+	}
+	defer ln.Close()
+	go func() {
+		for {
+			conn, err := ln.Accept()
+			if err != nil {
+				return
+			}
+			go func(c net.Conn) {
+				defer c.Close()
+				rd := bufio.NewReader(c)
+				for {
+					argv, err := sentinelReadOneCommand(rd)
+					if err != nil {
+						return
+					}
+					name := ""
+					if len(argv) > 0 {
+						name = strings.ToUpper(argv[0])
+						select {
+						case arrived <- name:
+						default:
+						}
+					}
+					if name == "PING" {
+						fmt.Fprint(c, "+PONG\r\n")
+					} else {
+						fmt.Fprint(c, "+OK\r\n")
+					}
+				}
+			}(conn)
+		}
+	}()
+
+	config.Opt.Advanced.PipelineCountLimit = 128
+	config.Opt.Advanced.TargetRedisMaxQPS = 1000
+	// the allowance is far smaller than the one entry below, and nothing else is in flight
+	config.Opt.Advanced.TargetRedisClientMaxQuerybufLen = 200
+
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+	w := NewRedisStandaloneWriter(ctx, &RedisWriterOptions{Address: ln.Addr().String()})
+	w.StartWrite(ctx)
+
+	e := entry.NewEntry()
+	e.DbId = 0
+	e.Argv = []string{"hset", "big", "field", strings.Repeat("v", 4096)}
+	e.CmdName = "hset"
+	go w.Write(e)
+
+	deadline := time.After(10 * time.Second)
+	for {
+		select {
+		case cmd := <-arrived:
+			if cmd == "HSET" {
+				fmt.Println(sentinelWriterSent)
+				return
+			}
+		case <-deadline:
+			fmt.Println(sentinelWriterStuck)
+			return
+		}
+	}
+}
+
+// sentinelWriteOversized runs the child and reports whether the entry ever reached the target.
+func sentinelWriteOversized(t *testing.T) bool {
+	t.Helper()
+	ctx, cancel := context.WithTimeout(context.Background(), 60*time.Second)
+	defer cancel()
+	cmd := exec.CommandContext(ctx, os.Args[0], "-test.run=^TestSentinelWriterLivenessHelper$")
+	cmd.Env = append(os.Environ(), sentinelWriterChildFlag+"=1")
+	raw, _ := cmd.CombinedOutput()
+	text := string(raw)
+	if strings.Contains(text, sentinelWriterSent) {
+		return true
+	}
+	if strings.Contains(text, sentinelWriterStuck) {
+		return false
+	}
+	t.Fatalf("the writer child reported neither outcome. output:\n%s", text)
+	return false
+}
+
+// One entry larger than the whole allowance, with nothing outstanding, still has to be sent.
+// Waiting for room that only arrives when something already sent is answered is waiting for
+// something that cannot happen, and the copy stops there for good.
+func TestSentinelWriterForwardsAnOversizedEntry(t *testing.T) {
+	if !sentinelWriteOversized(t) {
+		t.Errorf("an entry bigger than the target's allowance never left the writer, so a hash field larger than that allowance stops the copy permanently")
+	}
+}
