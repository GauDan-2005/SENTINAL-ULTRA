diff --git a/tests/ext/encoder.test.ts b/tests/ext/encoder.test.ts
new file mode 100644
index 0000000..9be868e
--- /dev/null
+++ b/tests/ext/encoder.test.ts
@@ -0,0 +1,345 @@
+import { assert, assertEquals } from "../test.deps.ts";
+import { VALUES } from "../values.ts";
+import { mockUser1 } from "../mocks.ts";
+import { useKv } from "../utils.ts";
+import { collection, type Encoder, kvdex, type KvdexOptions, model } from "../../mod.ts";
+import type { User } from "../models.ts";
+import {
+  brotliCompressor,
+  jsonDeserialize,
+  jsonEncoder,
+  jsonSerialize,
+  v8Deserialize,
+  v8Encoder,
+  v8Serialize,
+} from "../../src/ext/encoding/mod.ts";
+import * as jsonBarrel from "../../src/ext/encoding/json/mod.ts";
+import * as v8Barrel from "../../src/ext/encoding/v8/mod.ts";
+import * as brotliBarrel from "../../src/ext/encoding/brotli/mod.ts";
+
+Deno.test("ext - encoder", async (t) => {
+  await t.step("json", async (t) => {
+    await t.step(
+      "Should successfully serialize all KvValue type values",
+      () => {
+        const serialized = VALUES.map(jsonSerialize);
+        assert(serialized.every((val) => val instanceof Uint8Array));
+      },
+    );
+
+    await t.step(
+      "Should successfully deserialize all KvValue type values from Uint8Array",
+      () => {
+        VALUES.forEach((val) => {
+          const seralized = jsonSerialize(val);
+          const deserialized = jsonDeserialize(seralized);
+          assertEquals(val, deserialized);
+        });
+      },
+    );
+  });
+
+  await t.step("v8", async (t) => {
+    await t.step(
+      "Should successfully serialize all KvValue type values",
+      () => {
+        const serialized = VALUES.map((val) => {
+          try {
+            return v8Serialize(val);
+          } catch (e) {
+            throw new Error(
+              `Failed to serialize value: ${val}, Error: ${e}`,
+            );
+          }
+        });
+        assert(serialized.every((val) => val instanceof Uint8Array));
+      },
+    );
+
+    await t.step(
+      "Should successfully deserialize all KvValue type values from Uint8Array",
+      () => {
+        VALUES.forEach((val) => {
+          const serialized = v8Serialize(val);
+          try {
+            const deserialized = v8Deserialize(serialized);
+            assertEquals(val, deserialized);
+          } catch (e) {
+            throw new Error(`Failed to deserialize value: ${val}, Error: ${e}`);
+          }
+        });
+      },
+    );
+  });
+});
+
+Deno.test("ext - encoder factories", async (t) => {
+  await t.step("json", async (t) => {
+    await t.step("Should create an encoder holding the json serializer", () => {
+      const encoder = jsonEncoder();
+      assertEquals(typeof encoder.serializer.serialize, "function");
+      assertEquals(typeof encoder.serializer.deserialize, "function");
+    });
+
+    await t.step("Should leave the compressor unset by default", () => {
+      const encoder = jsonEncoder();
+      assertEquals(encoder.compressor, undefined);
+    });
+
+    await t.step("Should carry through a given compressor", () => {
+      const compressor = brotliCompressor();
+      const encoder = jsonEncoder({ compressor });
+      assertEquals(encoder.compressor, compressor);
+    });
+
+    await t.step(
+      "Should round-trip a value through its serializer",
+      async () => {
+        const encoder = jsonEncoder();
+        const serialized = await encoder.serializer.serialize(mockUser1);
+        assert(serialized instanceof Uint8Array);
+        const deserialized = await encoder.serializer.deserialize<User>(
+          serialized,
+        );
+        assertEquals(deserialized, mockUser1);
+      },
+    );
+  });
+
+  await t.step("v8", async (t) => {
+    await t.step("Should create an encoder holding the v8 serializer", () => {
+      const encoder = v8Encoder();
+      assertEquals(typeof encoder.serializer.serialize, "function");
+      assertEquals(typeof encoder.serializer.deserialize, "function");
+    });
+
+    await t.step("Should leave the compressor unset by default", () => {
+      const encoder = v8Encoder();
+      assertEquals(encoder.compressor, undefined);
+    });
+
+    await t.step("Should carry through a given compressor", () => {
+      const compressor = brotliCompressor();
+      const encoder = v8Encoder({ compressor });
+      assertEquals(encoder.compressor, compressor);
+    });
+
+    await t.step(
+      "Should round-trip a value through its serializer",
+      async () => {
+        const encoder = v8Encoder();
+        const serialized = await encoder.serializer.serialize(mockUser1);
+        assert(serialized instanceof Uint8Array);
+        const deserialized = await encoder.serializer.deserialize<User>(
+          serialized,
