+Deno.test("ext - brotliCompressor", async (t) => {
+  // Repetitive payload so compression is guaranteed to shrink it.
+  const payload = new Uint8Array(8_192);
+  for (let i = 0; i < payload.length; i++) {
+    payload[i] = i % 4;
+  }
+
+  await t.step("Should implement the compressor methods", () => {
+    const compressor = brotliCompressor();
+    assertEquals(typeof compressor.compress, "function");
+    assertEquals(typeof compressor.decompress, "function");
+  });
+
+  await t.step("Should compress to a smaller Uint8Array", async () => {
+    const compressor = brotliCompressor();
+    const compressed = await compressor.compress(payload);
+    assert(compressed instanceof Uint8Array);
+    assert(compressed.byteLength < payload.byteLength);
+  });
+
+  await t.step("Should decompress back to the original bytes", async () => {
+    const compressor = brotliCompressor();
+    const compressed = await compressor.compress(payload);
+    const decompressed = await compressor.decompress(compressed);
+    assert(decompressed instanceof Uint8Array);
+    assertEquals(decompressed, payload);
+  });
+
+  await t.step("Should default to quality level 1", async () => {
+    const defaulted = await brotliCompressor().compress(payload);
+    const explicit = await brotliCompressor({ quality: 1 }).compress(payload);
+    assertEquals(defaulted, explicit);
+  });
+
+  await t.step("Should honour an explicit quality level", async () => {
+    const compressor = brotliCompressor({ quality: 6 });
+    const compressed = await compressor.compress(payload);
+    assert(compressed instanceof Uint8Array);
+    assert(compressed.byteLength < payload.byteLength);
+    assertEquals(await compressor.decompress(compressed), payload);
+  });
+});
+
+Deno.test("ext - encoding module surface", async (t) => {
+  await t.step("barrels", async (t) => {
+    await t.step("Should expose the json encoder from the json barrel", () => {
+      assertEquals(typeof jsonBarrel.jsonEncoder, "function");
+      assertEquals(typeof jsonBarrel.jsonSerialize, "function");
+      assertEquals(typeof jsonBarrel.jsonDeserialize, "function");
+    });
+
+    await t.step("Should expose the v8 encoder from the v8 barrel", () => {
+      assertEquals(typeof v8Barrel.v8Encoder, "function");
+      assertEquals(typeof v8Barrel.v8Serialize, "function");
+      assertEquals(typeof v8Barrel.v8Deserialize, "function");
+    });
+
+    await t.step("Should expose the compressor from the brotli barrel", () => {
+      assertEquals(typeof brotliBarrel.brotliCompressor, "function");
+    });
+  });
+
+  await t.step("export map", async (t) => {
+    const expected: Record<string, string[]> = {
+      "./encoding": [
+        "jsonEncoder",
+        "v8Encoder",
+        "brotliCompressor",
+        "jsonSerialize",
+        "jsonDeserialize",
+        "v8Serialize",
+        "v8Deserialize",
+      ],
+      "./encoding/json": ["jsonEncoder", "jsonSerialize", "jsonDeserialize"],
+      "./encoding/v8": ["v8Encoder", "v8Serialize", "v8Deserialize"],
+      "./encoding/brotli": ["brotliCompressor"],
+    };
+
+    const config = JSON.parse(
+      await Deno.readTextFile(new URL("../../deno.json", import.meta.url)),
+    );
+    const exports = config.exports as Record<string, string>;
+
+    for (const [entry, symbols] of Object.entries(expected)) {
+      await t.step(`Should expose ${entry} from the export map`, async () => {
+        const target = exports[entry];
+        assert(
+          typeof target === "string",
+          `missing export map entry for ${entry}`,
+        );
+
+        const url = new URL(
+          `../../${target.replace(/^\.\//, "")}`,
+          import.meta.url,
+        );
+        const mod = await import(url.href);
+        for (const symbol of symbols) {
+          assertEquals(
+            typeof mod[symbol],
+            "function",
+            `${entry} does not export ${symbol}`,
+          );
+        }
+      });
+    }
+  });
+});
+
+Deno.test("ext - custom encoder", async (t) => {
+  // Reversing the bytes is its own inverse, so a collection that fails to call
+  // decompress before deserialize cannot read the value back.
+  const reverse = (data: Uint8Array) => new Uint8Array([...data].reverse());
+
+  // Counting both directions proves the collection really routes through the
+  // compressor. A round-trip alone would still pass if it ignored both halves.
+  let compressed = 0;
+  let decompressed = 0;
+
+  const asyncEncoder: Encoder = {
+    serializer: {
+      serialize: (data) => Promise.resolve(jsonSerialize(data)),
+      deserialize: <T>(data: Uint8Array) =>
+        Promise.resolve(jsonDeserialize<T>(data)),
+    },
+    compressor: {
+      compress: (data) => {
+        compressed++;
+        return reverse(data);
+      },
+      decompress: (data) => {
+        decompressed++;
+        return reverse(data);
+      },
+    },
+  };
+
+  const plainEncoder: Encoder = {
+    serializer: {
+      serialize: (data) => jsonSerialize(data),
+      deserialize: <T>(data: Uint8Array) => jsonDeserialize<T>(data),
+    },
+  };
+
+  await t.step(
+    "Should round-trip through an async serializer and a custom compressor",
+    async () => {
+      await useKv(async (kv) => {
+        const db = kvdex({
+          kv,
+          schema: {
+            users: collection(model<User>(), { encoder: asyncEncoder }),
+          },
+        });
+
+        const cr = await db.users.add(mockUser1);
+        assert(cr.ok);
+
+        const doc = await db.users.find(cr.id);
+        assertEquals(doc?.value, mockUser1);
+
+        // the encoder's compressor must actually be used in both directions
+        assert(compressed > 0);
+        assert(decompressed > 0);
+      });
+    },
+  );
+
+  await t.step(
+    "Should round-trip when no compressor is attached",
+    async () => {
+      await useKv(async (kv) => {
+        const db = kvdex({
+          kv,
+          schema: {
+            users: collection(model<User>(), { encoder: plainEncoder }),
+          },
+        });
+
+        const cr = await db.users.add(mockUser1);
+        assert(cr.ok);
+
+        const doc = await db.users.find(cr.id);
+        assertEquals(doc?.value, mockUser1);
+      });
+    },
+  );
+
+  await t.step("Should build a database when no schema is given", async () => {
+    await useKv((kv) => {
+      const options: KvdexOptions = { kv };
+      const db = kvdex(options);
+      assertEquals(typeof db.countAll, "function");
+    });
+  });
+
+  await t.step(
+    "Should no longer export the serialization helpers from their old home",
+    async () => {
+      const root = await import("../../mod.ts") as Record<string, unknown>;
+      assertEquals(root.jsonSerialize, undefined);
+      assertEquals(root.jsonDeserialize, undefined);
+    },
+  );
+});
