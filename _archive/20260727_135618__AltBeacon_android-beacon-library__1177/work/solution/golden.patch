+            return if (other is ForegroundServiceScanStrategy) {
+                if (this.notificationId == other.notificationId &&
+                    this.notification == other.notification &&
+                    this.androidLScanningDisabled == other.androidLScanningDisabled) {
+                    0
+                } else {
+                    -1
