+                    if (this.immediateJobId == other.immediateJobId &&
+                        this.periodicJobId == other.periodicJobId &&
+                        this.jobPersistenceEnabled == other.jobPersistenceEnabled) {
+                        0
+                    } else {
+                        -1
+                    }
+                } else {
+                    -1
+                }
+            }
+        }
