+package org.altbeacon.beacon;
+
+import android.app.Notification;
+import android.content.Context;
+
+import org.altbeacon.beacon.logging.LogManager;
+import org.altbeacon.beacon.logging.Loggers;
+import org.junit.Before;
+import org.junit.Test;
+import org.junit.runner.RunWith;
+import org.robolectric.RobolectricTestRunner;
+import org.robolectric.RuntimeEnvironment;
+import org.robolectric.annotation.Config;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertFalse;
+import static org.junit.Assert.assertNull;
+import static org.junit.Assert.assertTrue;
+
+@RunWith(RobolectricTestRunner.class)
+@Config(sdk = 28)
+public class SettingsJavaTest {
+
+    private BeaconManager beaconManager;
+
+    @Before
+    public void before() {
+        org.robolectric.shadows.ShadowLog.stream = System.err;
+        LogManager.setLogger(Loggers.verboseLogger());
+        LogManager.setVerboseLoggingEnabled(true);
+        BeaconManager.setsManifestCheckingDisabled(true);
+        beaconManager = BeaconManager.getInstanceForApplication(RuntimeEnvironment.getApplication());
+        // Start every test from the library defaults so the tests do not depend on each other.
+        beaconManager.revertSettings();
+        BeaconManager.setsManifestCheckingDisabled(true);
+    }
+
+    @Test
+    public void builderIsUsableFromJava() {
+        Context context = RuntimeEnvironment.getApplication();
+        Settings settings = new Settings.Builder()
+                .setDebug(true)
+                .setDistanceModelUpdateUrl("https://s3.amazonaws.com/android-beacon-library/android-distance.json")
+                .setScanPeriods(new Settings.ScanPeriods(1100, 0, 10000, 0))
+                .setScanStrategy(new Settings.ForegroundServiceScanStrategy(
+                        new Notification.Builder(context, "BeaconReferenceApp").build(), 1))
+                .setLongScanForcingEnabled(true)
+                .build();
+
+        assertEquals(Boolean.TRUE, settings.getDebug());
+        assertEquals("https://s3.amazonaws.com/android-beacon-library/android-distance.json",
+                settings.getDistanceModelUpdateUrl());
+        assertEquals(1100L, settings.getScanPeriods().getForegroundScanPeriodMillis());
+        assertEquals(10000L, settings.getScanPeriods().getBackgroundScanPeriodMillis());
+        assertEquals(Boolean.TRUE, settings.getLongScanForcingEnabled());
+        assertTrue(settings.getScanStrategy() instanceof Settings.ForegroundServiceScanStrategy);
+        // Fields the builder was never given stay unset.
+        assertNull(settings.getHardwareEqualityEnforced());
+        assertNull(settings.getRegionExitPeriodMillis());
+    }
+
+    @Test
+    public void defaultsAreReadableFromJava() {
+        beaconManager.revertSettings();
+        Settings.ScanPeriods periods = beaconManager.getActiveSettings().getScanPeriods();
+        assertEquals(1100L, periods.getForegroundScanPeriodMillis());
+        assertEquals(0L, periods.getForegroundBetweenScanPeriodMillis());
+        assertEquals(30000L, periods.getBackgroundScanPeriodMillis());
+        assertEquals(0L, periods.getBackgroundBetweenScanPeriodMillis());
+        assertEquals("", beaconManager.getActiveSettings().getDistanceModelUpdateUrl());
+        assertEquals(30000L, beaconManager.getActiveSettings().getRegionExitPeriodMillis());
+        assertFalse(beaconManager.getActiveSettings().getDebug());
+        assertTrue(beaconManager.getActiveSettings().getUseTrackingCache());
+    }
+
+    @Test
+    public void settingsAppliedFromJavaAreReadableBack() {
+        Settings settings = new Settings.Builder()
+                .setDebug(true)
+                .setScanPeriods(new Settings.ScanPeriods(1100, 0, 10000, 0))
+                .build();
+        beaconManager.adjustSettings(settings);
+
+        assertTrue(beaconManager.getActiveSettings().getDebug());
+        assertEquals(10000L,
+                beaconManager.getActiveSettings().getScanPeriods().getBackgroundScanPeriodMillis());
+        assertEquals(10000L, beaconManager.getBackgroundScanPeriod());
+
+        beaconManager.revertSettings();
+        assertFalse(beaconManager.getActiveSettings().getDebug());
+        assertEquals(30000L,
+                beaconManager.getActiveSettings().getScanPeriods().getBackgroundScanPeriodMillis());
+    }
+}
