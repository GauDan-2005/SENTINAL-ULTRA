diff --git a/connectrpc-build/tests/element_budget.rs b/connectrpc-build/tests/element_budget.rs
new file mode 100644
index 0000000..d68fa23
--- /dev/null
+++ b/connectrpc-build/tests/element_budget.rs
@@ -0,0 +1,302 @@
+//! Element-memory budget behaviour of the public `connectrpc-build` API.
+//!
+//! Everything here drives `Config::compile`, the entry point a build script
+//! calls, so the checks hold for any implementation that gets the observable
+//! behaviour right.
+
+mod element_budget {
+    use std::process::Command;
+    use std::sync::{Mutex, MutexGuard};
+
+    use buffa::Message;
+    use buffa_codegen::generated::descriptor::{FileDescriptorProto, FileDescriptorSet};
+    use connectrpc_build::Config;
+
+    /// Documented override for the budget a build applies to its descriptors.
+    const BUDGET_ENV: &str = "BUFFA_ELEMENT_MEMORY_LIMIT";
+
+    /// Serialises the tests that set `BUDGET_ENV`: it is process-global, and a
+    /// concurrent compile in this binary would otherwise pick up a budget that
+    /// is not the one its own case configured.
+    static ENV_LOCK: Mutex<()> = Mutex::new(());
+
+    fn env_lock() -> MutexGuard<'static, ()> {
+        // A panicking test poisons the lock; the data is `()`, so carrying on
+        // costs nothing and keeps one failure from cascading.
+        ENV_LOCK.lock().unwrap_or_else(|poisoned| poisoned.into_inner())
+    }
+
+    fn fixture(name: &str) -> String {
+        format!("{}/tests/fixtures/{name}", env!("CARGO_MANIFEST_DIR"))
+    }
+
+    /// A descriptor set that a build could plausibly produce and that the
+    /// untrusted-input budget rejects.
+    ///
+    /// The budget is charged per element on struct size rather than on encoded
+    /// bytes, so the count is derived from the live `size_of` — a literal would
+    /// quietly stop exceeding the budget as soon as that struct shrank, and the
+    /// test would then prove nothing.
+    fn over_default_budget_set() -> Vec<u8> {
+        let per_element = std::mem::size_of::<FileDescriptorProto>();
+        let count = (buffa::DEFAULT_ELEMENT_MEMORY_LIMIT / per_element) * 5 / 4;
+        let set = FileDescriptorSet {
+            file: (0..count)
+                .map(|i| FileDescriptorProto {
+                    name: Some(format!("bulk/f{i}.proto")),
+                    package: Some("bulk.v1".into()),
+                    syntax: Some("proto3".into()),
+                    ..Default::default()
+                })
+                .collect(),
+            ..Default::default()
+        };
+        set.encode_to_vec()
+    }
+
+    /// A set the untrusted default still admits, but a 1024-byte budget does
+    /// not. Needed so a lowered override is not confused with the default
+    /// rejection of a huge schema.
+    fn over_tiny_budget_set() -> Vec<u8> {
+        let per_element = std::mem::size_of::<FileDescriptorProto>().max(1);
+        let count = (1024 / per_element) + 2;
+        assert!(
+            count * per_element < buffa::DEFAULT_ELEMENT_MEMORY_LIMIT,
+            "tiny-over fixture spilled into the untrusted default"
+        );
+        let set = FileDescriptorSet {
+            file: (0..count)
+                .map(|i| FileDescriptorProto {
+                    name: Some(format!("tiny/f{i}.proto")),
+                    package: Some("tiny.v1".into()),
+                    syntax: Some("proto3".into()),
+                    ..Default::default()
+                })
+                .collect(),
+            ..Default::default()
+        };
+        set.encode_to_vec()
+    }
+
+    /// Compile a small, valid descriptor set with `BUDGET_ENV` set to `limit`,
+    /// and return the resulting error text.
+    fn compile_error_with_budget(limit: &str) -> String {
+        let _guard = env_lock();
+        let out = tempfile::tempdir().unwrap();
+
+        // SAFETY: `ENV_LOCK` is held, and every other test in this binary that
+        // compiles takes the same lock, so no other thread reads the
+        // environment while it is modified here.
+        unsafe { std::env::set_var(BUDGET_ENV, limit) };
+        let result = Config::new()
+            .descriptor_set(fixture("echo.fds.bin"))
+            .files(&["echo.proto"])
+            .out_dir(out.path())
+            .compile();
+        // SAFETY: as above.
+        unsafe { std::env::remove_var(BUDGET_ENV) };
+
+        match result {
+            Ok(()) => panic!("a {limit}-byte budget must reject this descriptor set"),
+            Err(e) => e.to_string(),
+        }
+    }
+
+    /// The regression: descriptors a build produced itself must compile even
+    /// when they are larger than the bound meant for untrusted wire input.
+    ///
+    /// The first assertion is the control. Without it the compile below would
+    /// pass whether or not the budget in force was ever raised.
+    #[test]
+    fn a_schema_over_the_untrusted_default_budget_compiles() {
+        let _guard = env_lock();
+        let bytes = over_default_budget_set();
+
+        assert!(
+            matches!(
+                FileDescriptorSet::decode_from_slice(&bytes),
+                Err(buffa::DecodeError::ElementMemoryLimitExceeded)
+            ),
+            "fixture no longer exceeds the untrusted default budget \
+             ({} encoded bytes); it must, or the compile below proves nothing",
+            bytes.len()
+        );
+
+        let dir = tempfile::tempdir().unwrap();
+        let set_path = dir.path().join("bulk.fds.bin");
+        std::fs::write(&set_path, &bytes).unwrap();
+        let out = tempfile::tempdir().unwrap();
+
+        Config::new()
+            .descriptor_set(&set_path)
+            .files(&["bulk/f0.proto"])
+            .out_dir(out.path())
+            .compile()
+            .expect("an ordinary large schema must compile");
+    }
+
+    /// Lowering has to work too. A compile that always uses the compiler-sized
+    /// default, and ignores the variable, would still admit this set.
+    #[test]
+    fn a_low_environment_budget_rejects_a_set_the_tooling_default_would_admit() {
+        let _guard = env_lock();
+        let bytes = over_tiny_budget_set();
+        let dir = tempfile::tempdir().unwrap();
+        let set_path = dir.path().join("tiny.fds.bin");
+        std::fs::write(&set_path, &bytes).unwrap();
+        let out = tempfile::tempdir().unwrap();
+
+        unsafe { std::env::set_var(BUDGET_ENV, "1024") };
+        let result = Config::new()
+            .descriptor_set(&set_path)
+            .files(&["tiny/f0.proto"])
+            .out_dir(out.path())
+            .compile();
+        unsafe { std::env::remove_var(BUDGET_ENV) };
+
+        let err = result.expect_err("a 1024-byte budget must reject this set");
+        let rendered = err.to_string();
+        assert!(
+            rendered.contains(BUDGET_ENV),
+            "a lowered budget is still a budget failure: {rendered}"
+        );
+    }
+
+    /// The documented raise that a build script can actually set.
+    #[test]
+    fn an_unlimited_environment_budget_admits_a_set_the_untrusted_default_rejects() {
+        let _guard = env_lock();
+        let bytes = over_default_budget_set();
+        assert!(
+            matches!(
+                FileDescriptorSet::decode_from_slice(&bytes),
+                Err(buffa::DecodeError::ElementMemoryLimitExceeded)
+            ),
+            "fixture no longer exceeds the untrusted default budget"
+        );
+
+        let dir = tempfile::tempdir().unwrap();
+        let set_path = dir.path().join("bulk.fds.bin");
+        std::fs::write(&set_path, &bytes).unwrap();
+        let out = tempfile::tempdir().unwrap();
+
+        unsafe { std::env::set_var(BUDGET_ENV, "unlimited") };
+        let result = Config::new()
+            .descriptor_set(&set_path)
+            .files(&["bulk/f0.proto"])
+            .out_dir(out.path())
+            .compile();
+        unsafe { std::env::remove_var(BUDGET_ENV) };
+
+        result.expect("unlimited must admit a set the untrusted default rejects");
+    }
+
+    /// An over-budget build failure has to name the override that a build
+    /// script can actually reach.
+    #[test]
+    fn an_over_budget_compile_names_the_environment_override() {
+        let rendered = compile_error_with_budget("1024");
+        assert!(
+            rendered.contains(BUDGET_ENV),
+            "must name the variable that works here: {rendered}"
+        );
+    }
+
+    /// It also has to say why the plugin option is not the answer here, since
+    /// that is the remedy the underlying error offers first.
+    #[test]
+    fn an_over_budget_compile_explains_that_a_build_script_has_no_plugin_options() {
+        let rendered = compile_error_with_budget("1024");
+        assert!(
+            rendered.contains("build script"),
+            "must say why the plugin option does not apply: {rendered}"
+        );
+    }
+
+    /// And it has to point at this project's documentation rather than leave
+    /// the reader to find the workaround.
+    #[test]
+    fn an_over_budget_compile_links_the_connectrpc_guide() {
+        let rendered = compile_error_with_budget("1024");
+        assert!(
+            rendered.contains("connectrpc/connect-rust"),
+            "must link this project's guide: {rendered}"
+        );
+    }
+
+    /// A budget the build reads is a build input: cargo has to be told, or a
+    /// build that succeeded with the variable set is reused unchanged after it
+    /// changes, and the setting looks inert.
+    ///
+    /// Directives go to this process's stdout, which the harness swallows, so
+    /// the compile runs in a child process with output captured.
+    #[test]
+    fn the_build_declares_a_rebuild_trigger_for_the_budget_variable() {
+        let exe = std::env::current_exe().expect("test binary path");
+        let output = Command::new(exe)
+            .args([
+                "element_budget::a_compile_emits_its_rebuild_triggers",
+                "--exact",
+                "--nocapture",
+                "--test-threads=1",
+            ])
+            .env_remove(BUDGET_ENV)
+            .output()
+            .expect("re-running this test binary must work");
+
+        let stdout = String::from_utf8_lossy(&output.stdout);
+        assert!(
+            output.status.success(),
+            "the child compile failed:\n{stdout}{}",
+            String::from_utf8_lossy(&output.stderr)
+        );
+        assert!(
+            stdout.contains(&format!("cargo:rerun-if-env-changed={BUDGET_ENV}")),
+            "the build must declare {BUDGET_ENV} as a rebuild trigger, got:\n{stdout}"
+        );
+    }
+
+    /// The compile whose stdout the test above inspects. It stands on its own
+    /// as a check that the ordinary precompiled-set path still works.
+    #[test]
+    fn a_compile_emits_its_rebuild_triggers() {
+        let _guard = env_lock();
+        let out = tempfile::tempdir().unwrap();
+
+        Config::new()
+            .descriptor_set(fixture("echo.fds.bin"))
+            .files(&["echo.proto"])
+            .out_dir(out.path())
+            .compile()
+            .expect("the fixture must compile");
+    }
+
+    /// A corrupt set must not be dressed up as a budget problem: that sends
+    /// the reader off raising a limit that was never the cause.
+    #[test]
+    fn a_malformed_descriptor_set_is_not_reported_as_a_budget_problem() {
+        let _guard = env_lock();
+        let dir = tempfile::tempdir().unwrap();
+        let set_path = dir.path().join("truncated.fds.bin");
+        // A length-delimited field one byte long whose payload never arrives.
+        std::fs::write(&set_path, [0x0a, 0x7f]).unwrap();
+        let out = tempfile::tempdir().unwrap();
+
+        let err = Config::new()
+            .descriptor_set(&set_path)
+            .files(&["echo.proto"])
+            .out_dir(out.path())
+            .compile()
+            .expect_err("a truncated descriptor set must fail")
+            .to_string();
+
+        assert!(
+            !err.contains(BUDGET_ENV),
+            "a truncated set must not point at the budget: {err}"
+        );
+        assert!(
+            err.to_lowercase().contains("decode"),
+            "it should still report a decode failure: {err}"
+        );
+    }
+}
diff --git a/connectrpc-codegen/src/codegen.rs b/connectrpc-codegen/src/codegen.rs
