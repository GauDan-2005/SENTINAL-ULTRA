-fn get_endpoints() -> Vec<Option<String>> {
-    let configurations = [
-        "OCI_REST_ENDPOINT",
-        "OCI_HTTP_ENDPOINT",
-        "OCI_ALB_ENDPOINT",
-        // "OCI_FURL_ENDPOINT",
-        "ZIP_REST_ENDPOINT",
-        "ZIP_HTTP_ENDPOINT",
-        "ZIP_ALB_ENDPOINT",
-        // "ZIP_FURL_ENDPOINT",
-    ];
-
-    configurations.iter().map(|e| env::var(e).ok()).collect()
-}
-
-fn decode_reader(bytes: &Vec<u8>) -> io::Result<String> {
-    let mut gz = GzDecoder::new(&bytes[..]);
-    let mut s = String::new();
-    gz.read_to_string(&mut s)?;
-    Ok(s)
-}
