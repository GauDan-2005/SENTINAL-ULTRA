+    };
+    assert!(env::var("SSL_CERT_FILE").is_err());
+    let _adapter = Adapter::new(&options);
+    assert_eq!(Ok(cert_path.to_string()), env::var("SSL_CERT_FILE"));
+    env::remove_var("SSL_CERT_FILE");
+}
