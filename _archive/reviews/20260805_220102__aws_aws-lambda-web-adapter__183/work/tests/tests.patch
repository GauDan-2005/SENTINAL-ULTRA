+#[tokio::test]
+async fn an_identity_that_cannot_be_used_does_not_become_an_anonymous_one() {
+    // Control first, for the same reason: this app accepts anonymous callers.
+    let open = TlsApp::start();
+    aim_at_tls_app(open.port);
+    let mut adapter = adapter_from_env();
+    assert_eq!(
+        200,
+        call(&mut adapter, "/hello.txt")
+            .await
+            .expect("an app that demands nothing should answer")
+            .status()
+    );
+    drop(adapter);
+
+    // The key file here holds a certificate, not a key: named, readable, useless.
+    // The app on the other end would happily accept an anonymous client, so only
+    // an adapter that fails closed refuses this request.
+    let app = TlsApp::start();
+    aim_at_tls_app(app.port);
+    let material = tls_material();
+    env::set_var("AWS_LWA_TLS_CLIENT_CERT_FILE", &material.client_cert);
+    env::set_var("AWS_LWA_TLS_CLIENT_KEY_FILE", &material.ca);
+    let mut adapter = adapter_from_env();
+
+    assert!(
+        call(&mut adapter, "/hello.txt").await.is_err(),
+        "an identity that cannot be used was dropped and the request went out anonymously"
+    );
+}
