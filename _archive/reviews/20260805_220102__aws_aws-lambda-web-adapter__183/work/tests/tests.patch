+
+    hello.assert();
+    assert_eq!(200, response.status());
+    assert_eq!("Hello Query", body_to_string(response).await);
+}
+
+#[tokio::test]
+async fn regression_post_put_delete_reach_the_app() {
+    let app_server = MockServer::start();
+    let post = app_server.mock(|when, then| {
+        when.method(POST).path("/resource");
+        then.status(201).body("created");
+    });
+    let put = app_server.mock(|when, then| {
+        when.method(PUT).path("/resource");
+        then.status(200).body("updated");
+    });
+    let delete = app_server.mock(|when, then| {
+        when.method(DELETE).path("/resource");
+        then.status(204);
+    });
+
+    let mut adapter = Adapter::new(&options_for(&app_server));
+
+    let created = adapter
+        .call(
+            LambdaEventBuilder::new()
+                .with_method(Method::POST)
+                .with_path("/resource")
+                .build()
+                .into(),
+        )
+        .await
+        .expect("POST failed");
+    let updated = adapter
+        .call(
+            LambdaEventBuilder::new()
+                .with_method(Method::PUT)
+                .with_path("/resource")
+                .build()
+                .into(),
+        )
+        .await
+        .expect("PUT failed");
+    let removed = adapter
+        .call(
+            LambdaEventBuilder::new()
+                .with_method(Method::DELETE)
+                .with_path("/resource")
+                .build()
+                .into(),
+        )
+        .await
+        .expect("DELETE failed");
+
+    post.assert();
+    put.assert();
+    delete.assert();
+    assert_eq!(201, created.status());
+    assert_eq!(200, updated.status());
+    assert_eq!(204, removed.status());
+}
+
+#[tokio::test]
+async fn regression_base_path_is_stripped_before_proxying() {
+    let app_server = MockServer::start();
+    let hello = app_server.mock(|when, then| {
+        when.method(GET).path("/hello");
+        then.status(200).body("Hello Stripped");
+    });
+
+    let options = AdapterOptions {
+        base_path: Some("/prod".to_string()),
