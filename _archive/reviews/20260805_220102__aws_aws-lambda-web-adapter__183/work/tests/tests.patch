+#[tokio::test]
+async fn the_readiness_probe_proves_who_it_is_as_well() {
+    let app = TlsApp::demanding_a_client_certificate();
+    let probe = TlsApp::demanding_a_client_certificate();
+    aim_at_tls_app(app.port);
+    env::set_var("READINESS_CHECK_PORT", probe.port.to_string());
+    present_the_client_identity();
+    let mut adapter = adapter_from_env();
+
+    // The probe retries until the app answers, so returning at all means the
+    // handshake on the readiness port succeeded.
+    tokio::time::timeout(PATIENCE, adapter.check_init_health())
+        .await
+        .expect("the readiness probe never got past an app that demands a client certificate");
+    assert_eq!(200, call(&mut adapter, "/hello.txt").await.unwrap().status());
+}
