+#[tokio::test]
+async fn half_an_identity_is_not_an_identity() {
+    // Control: this app asks nothing of its callers, so it answers an adapter
+    // carrying no identity at all. Without that, the refusal below would also
+    // hold for an adapter that cannot reach a TLS app in the first place.
+    let open = TlsApp::start();
+    aim_at_tls_app(open.port);
+    let mut adapter = adapter_from_env();
+    assert_eq!(
+        200,
+        call(&mut adapter, "/hello.txt")
+            .await
+            .expect("an app that demands nothing should answer")
+            .status()
+    );
+    drop(adapter);
+
+    // A certificate with no key cannot prove anything. The adapter must not
+    // shrug and connect as though nothing had been configured.
+    let app = TlsApp::start();
+    aim_at_tls_app(app.port);
+    env::set_var("AWS_LWA_TLS_CLIENT_CERT_FILE", &tls_material().client_cert);
+    let mut adapter = adapter_from_env();
+
+    assert!(
+        call(&mut adapter, "/hello.txt").await.is_err(),
+        "a half-configured identity was quietly ignored and the request went out anyway"
+    );
+    drop(adapter);
+
+    // The mirror of the same mistake: a key with nothing to present it for.
+    let other_half = TlsApp::start();
+    aim_at_tls_app(other_half.port);
+    env::set_var("AWS_LWA_TLS_CLIENT_KEY_FILE", &tls_material().client_key);
+    let mut adapter = adapter_from_env();
+    assert!(
+        call(&mut adapter, "/hello.txt").await.is_err(),
+        "a key with no certificate to go with it was quietly ignored"
+    );
+}
