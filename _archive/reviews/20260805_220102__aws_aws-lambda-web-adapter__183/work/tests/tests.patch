+    assert_eq!(response.headers().get("fizz").unwrap(), "buzz");
+    assert_eq!("Hello World", body_to_string(response).await);
+}
+
+#[tokio::test]
+async fn regression_encoded_path_is_forwarded_verbatim() {
+    let app_server = MockServer::start();
+    let hello = app_server.mock(|when, then| {
+        when.method(GET).path("/hello%20world");
