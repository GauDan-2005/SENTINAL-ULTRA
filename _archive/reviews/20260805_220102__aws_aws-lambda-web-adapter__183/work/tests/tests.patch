+//! Plain-HTTP behaviour of the adapter. Every option is built with
+//! `..Default::default()`, so this file compiles against the crate as it stands
+//! today and against the crate once the TLS options exist. It must pass in both
+//! states: with TLS off, nothing here is allowed to move.
+
+#[path = "lwa_support/mod.rs"]
+mod lwa_support;
+
+use std::io;
+use std::io::prelude::*;
+
+use flate2::read::GzDecoder;
+use flate2::write::GzEncoder;
+use flate2::Compression;
+use http::{Method, Response};
+use httpmock::{
+    Method::{DELETE, GET, POST, PUT},
+    MockServer,
+};
+use hyper::{body, Body};
+use lambda_web_adapter::{Adapter, AdapterOptions, Protocol};
+use lwa_support::{LambdaEventBuilder, PATIENCE};
+use tower::Service;
+
+fn options_for(server: &MockServer) -> AdapterOptions {
+    AdapterOptions {
+        host: server.host(),
+        port: server.port().to_string(),
+        readiness_check_port: server.port().to_string(),
+        readiness_check_path: "/healthcheck".to_string(),
+        readiness_check_protocol: Protocol::Http,
+        async_init: false,
+        base_path: None,
+        compression: false,
+        ..Default::default()
+    }
+}
+
+async fn body_to_string(res: Response<Body>) -> String {
+    let body_bytes = body::to_bytes(res.into_body()).await.unwrap();
+    String::from_utf8_lossy(&body_bytes).to_string()
+}
+
+fn decode_reader(bytes: &[u8]) -> io::Result<String> {
+    let mut gz = GzDecoder::new(bytes);
+    let mut s = String::new();
+    gz.read_to_string(&mut s)?;
+    Ok(s)
+}
+
+async fn compressed_body_to_string(res: Response<Body>) -> String {
+    let body_bytes = body::to_bytes(res.into_body()).await.unwrap();
+    decode_reader(&body_bytes).unwrap()
+}
+
+#[test]
+fn regression_protocol_default_and_parsing() {
+    assert_eq!(Protocol::Http, Protocol::default());
+    assert_eq!(Protocol::Tcp, Protocol::from("tcp"));
+    assert_eq!(Protocol::Tcp, Protocol::from("TCP"));
+    assert_eq!(Protocol::Http, Protocol::from("http"));
+    assert_eq!(Protocol::Http, Protocol::from("something-else"));
+}
+
+#[test]
+fn regression_options_build_from_defaults() {
+    let options = AdapterOptions {
+        host: "127.0.0.1".to_string(),
+        port: "8080".to_string(),
+        ..Default::default()
+    };
+    assert_eq!("127.0.0.1", options.host);
+    assert_eq!("8080", options.port);
+    assert_eq!(Protocol::Http, options.readiness_check_protocol);
+    assert_eq!(None, options.base_path);
+    assert!(!options.async_init);
+    assert!(!options.compression);
+}
+
+#[tokio::test]
+async fn regression_readiness_check_calls_configured_path() {
+    let app_server = MockServer::start();
+    let healthcheck = app_server.mock(|when, then| {
+        when.method(GET).path("/healthcheck");
+        then.status(200).body("OK");
+    });
+
+    let mut adapter = Adapter::new(&options_for(&app_server));
+    tokio::time::timeout(PATIENCE, adapter.check_init_health())
+        .await
+        .expect("the readiness regression never finished");
+
+    healthcheck.assert();
+}
+
+#[tokio::test]
+async fn regression_basic_request_is_proxied() {
+    let app_server = MockServer::start();
+    let hello = app_server.mock(|when, then| {
+        when.method(GET).path("/hello");
+        then.status(200).body("Hello World");
+    });
+
+    let mut adapter = Adapter::new(&options_for(&app_server));
+    let req = LambdaEventBuilder::new().with_path("/hello").build();
+    let response = adapter.call(req.into()).await.expect("Request failed");
+
+    hello.assert();
+    assert_eq!(200, response.status());
+    assert_eq!(response.headers().get("content-length").unwrap(), "11");
+    assert_eq!("Hello World", body_to_string(response).await);
+}
+
+#[tokio::test]
+async fn regression_request_and_response_headers_survive() {
+    let app_server = MockServer::start();
+    let hello = app_server.mock(|when, then| {
