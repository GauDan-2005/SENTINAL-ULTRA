+    });
+
+    let mut adapter = Adapter::new(&options_for(&app_server));
+    let req = LambdaEventBuilder::new()
+        .with_path("/hello")
+        .with_query("name", "adapter")
+        .with_query("greeting", "hi")
+        .build();
