+use std::collections::HashMap;
+use std::str::FromStr;
+
+use http::header::HeaderName;
+use http::{HeaderMap, HeaderValue, Method};
+use lambda_http::aws_lambda_events::alb::{AlbTargetGroupRequest, AlbTargetGroupRequestContext, ElbContext};
+use lambda_http::aws_lambda_events::query_map::QueryMap;
+use lambda_http::request::LambdaRequest;
+
+#[derive(Debug)]
+pub enum LambdaEventType {
+    ALB,
+    // TODO: Add other event types
+}
+
+impl Default for LambdaEventType {
+    fn default() -> Self {
+        LambdaEventType::ALB
+    }
+}
+
+/// Makes it easy to construct events for testing purposes.
+///
+/// Example:
+///
+/// ```rs
+/// LambdaEventBuilder::new()
+///  .with_method(http::Method::POST)
+///  .with_path("/hello")
+///  .with_query("foo", "bar")
+///  .with_query("fizz", "buzz")
+///  .with_header("ContentType", "application/json")
+///  .build()
+///
+///  let req: http::Request<Body> = req.into();
+// ```
+#[derive(Debug, Default)]
+pub struct LambdaEventBuilder {
+    path: String,
+    method: Method,
+    query: HashMap<String, String>,
+    headers: HeaderMap,
+    event_type: LambdaEventType,
+    body: Option<String>,
+}
+
+impl LambdaEventBuilder {
+    pub fn new() -> Self {
+        Self {
+            path: "/".into(),
+            method: Method::GET,
+            query: HashMap::new(),
+            headers: HeaderMap::new(),
+            event_type: LambdaEventType::ALB,
+            body: None,
+        }
+    }
+
+    pub fn with_path(mut self, path: &str) -> Self {
+        self.path = path.into();
+        self
+    }
+
+    pub fn with_query(mut self, key: &str, value: &str) -> Self {
+        self.query.insert(key.into(), value.into());
+        self
+    }
+
+    pub fn with_method(mut self, method: Method) -> Self {
+        self.method = method;
+        self
+    }
+
+    pub fn with_header(mut self, key: &str, value: &str) -> Self {
+        let value = HeaderValue::from_str(value).unwrap();
+        let key = HeaderName::from_str(key).unwrap();
+        self.headers.insert(key, value);
+        self
+    }
+
+    pub fn with_event_type(mut self, event_type: LambdaEventType) -> Self {
+        self.event_type = event_type;
+        self
+    }
+
+    pub fn build(self) -> LambdaRequest {
+        match self.event_type {
+            LambdaEventType::ALB => LambdaRequest::Alb(AlbTargetGroupRequest {
+                http_method: self.method,
+                path: Some(self.path),
+                query_string_parameters: QueryMap::from(self.query.clone()),
+                multi_value_query_string_parameters: QueryMap::from(self.query),
+                headers: self.headers.clone(),
+                multi_value_headers: self.headers,
+                is_base64_encoded: false,
+                body: self.body,
+                request_context: AlbTargetGroupRequestContext {
+                    elb: ElbContext {
+                        target_group_arn: Some("arn:aws:us-east-1:123456789:elb/Foo".into()),
+                    },
+                },
+            }),
+        }
+    }
+}
+
+/// Remove every environment variable `AdapterOptions::from_env` reads, so a
+/// test's expectations never depend on what ran before it.
+pub fn clear_adapter_env() {
+    for key in [
+        "HOST",
+        "PORT",
+        "READINESS_CHECK_PORT",
+        "READINESS_CHECK_PATH",
+        "READINESS_CHECK_PROTOCOL",
+        "REMOVE_BASE_PATH",
+        "ASYNC_INIT",
+        "AWS_LWA_ENABLE_COMPRESSION",
+        "AWS_LWA_ENABLE_TLS",
+        "AWS_LWA_TLS_SERVER_NAME",
+        "AWS_LWA_TLS_CERT_FILE",
+        "AWS_LWA_TLS_CLIENT_CERT_FILE",
+        "AWS_LWA_TLS_CLIENT_KEY_FILE",
+        // An implementation is free to hand its trust bundle to the TLS stack
+        // through the usual OpenSSL variable. That is process-wide state, so it
+        // has to be cleared between tests or the bundle one test configures
+        // silently keeps the next one trusting it.
+        "SSL_CERT_FILE",
+    ] {
+        std::env::remove_var(key);
+    }
+}
+
+/// A raw loopback socket that records the first bytes a client actually sends.
+///
+/// Nothing here parses or terminates TLS. It only captures what went on the
+/// wire, which is what keeps the assertions independent of whichever TLS stack
+/// a solution picks: every TLS implementation opens with a handshake record,
+/// and every HTTP client opens with a request line.
+pub struct WireTap {
+    pub port: u16,
+    rx: std::sync::mpsc::Receiver<Vec<u8>>,
+}
+
+impl WireTap {
+    pub fn start() -> Self {
+        let listener = std::net::TcpListener::bind("127.0.0.1:0").expect("bind loopback listener");
+        let port = listener.local_addr().expect("local addr").port();
+        let (tx, rx) = std::sync::mpsc::channel();
+        std::thread::spawn(move || {
+            for stream in listener.incoming() {
+                let mut stream = match stream {
+                    Ok(s) => s,
+                    Err(_) => break,
+                };
+                let _ = stream.set_read_timeout(Some(std::time::Duration::from_secs(5)));
+                // One read is right: a client writes its opening bytes in a
+                // single go and then waits for us. Reading again would block.
+                let mut buf = vec![0u8; 4096];
+                let n = std::io::Read::read(&mut stream, &mut buf).unwrap_or(0);
+                buf.truncate(n);
+                if tx.send(buf).is_err() {
+                    break;
+                }
+            }
+        });
+        WireTap { port, rx }
+    }
+
+    /// The first non-empty bytes any client put on the wire, or None if nothing
+    /// ever connected — which is itself a failure worth asserting on.
+    pub fn first_bytes(&self, timeout: std::time::Duration) -> Option<Vec<u8>> {
+        // The deadline is fixed once. A client that keeps reconnecting without
+        // sending anything hands this loop an endless supply of empty buffers, and
+        // a per-recv timeout would be reset by every one of them — the wait would
+        // never end and the test would hang instead of reporting a failure.
+        let deadline = std::time::Instant::now() + timeout;
+        loop {
+            let left = deadline.checked_duration_since(std::time::Instant::now())?;
+            match self.rx.recv_timeout(left) {
+                Ok(b) if b.is_empty() => continue,
+                Ok(b) => return Some(b),
+                Err(_) => return None,
+            }
+        }
+    }
+}
+
+/// TLS record layer: content type 0x16 (handshake) followed by a legacy version
+/// whose major byte is 0x03. True of TLS 1.0 through 1.3, in every stack.
+pub fn looks_like_tls_handshake(bytes: &[u8]) -> bool {
+    bytes.len() >= 3 && bytes[0] == 0x16 && bytes[1] == 0x03
+}
+
+/// An HTTP/1.x request opens with a method token.
+pub fn looks_like_http_request(bytes: &[u8]) -> bool {
+    let head = String::from_utf8_lossy(&bytes[..bytes.len().min(16)]).to_string();
+    ["GET ", "POST ", "PUT ", "DELETE ", "HEAD ", "PATCH ", "OPTIONS "]
+        .iter()
+        .any(|m| head.starts_with(m))
+}
+
+/// Does the captured handshake carry this name in the clear?
+pub fn carries_ascii(bytes: &[u8], needle: &str) -> bool {
+    let n = needle.as_bytes();
+    !n.is_empty() && bytes.windows(n.len()).any(|w| w == n)
+}
+
+// ---------------------------------------------------------------------------
+// A web application that only speaks TLS.
+//
+// The wire tap answers "what did the adapter put on the socket". It cannot
+// answer "did the adapter complete a TLS session and bring the app's response
+// back", and an implementation that writes handshake-shaped bytes and then gives
+// up looks identical through that lens. This runs a real TLS listener so the
+// round trip itself is what gets graded.
+// ---------------------------------------------------------------------------
+
+use std::io::{Read, Write};
+use std::process::{Child, Command, Stdio};
+use std::sync::OnceLock;
+
+/// The name on the application's certificate.
+pub const APP_SERVER_NAME: &str = "app.internal.test";
+/// A second name the authority will sign for, so "certificate for the wrong
+/// name" can be told apart from "certificate from an unknown authority".
+pub const OTHER_SERVER_NAME: &str = "somebody-else.internal.test";
+pub const APP_PAGE: &str = "hello from the tls-only application";
+
+/// Bound every call into the adapter, so a wrong implementation reports a named
+/// failure instead of wedging the suite.
+pub const PATIENCE: std::time::Duration = std::time::Duration::from_secs(30);
+
+/// A private authority and the certificates it issues. Generated here, never
+/// committed: a private key in a repository is a liability whatever it was
+/// minted for, and nothing below depends on which bytes the key has — only on
+/// who signed what, and for which name.
+pub struct TlsMaterial {
+    pub ca: String,
+    pub key: String,
+    pub app_cert: String,
+    pub other_cert: String,
+    pub htdocs: String,
+    /// A certificate this authority issued for a client, and the key that goes
+    /// with it. An app that demands a client certificate accepts this pair.
+    pub client_cert: String,
+    pub client_key: String,
+}
+
+pub fn tls_material() -> &'static TlsMaterial {
+    static MATERIAL: OnceLock<TlsMaterial> = OnceLock::new();
+    MATERIAL.get_or_init(|| {
+        let dir = std::env::temp_dir().join(format!("lwa-tls-{}", std::process::id()));
+        let htdocs = dir.join("htdocs");
+        std::fs::create_dir_all(&htdocs).expect("create certificate directory");
+        std::fs::write(htdocs.join("hello.txt"), format!("{APP_PAGE}\n")).unwrap();
+        std::fs::write(htdocs.join("other.txt"), "the other page served over tls\n").unwrap();
+        let at = |n: &str| dir.join(n).to_str().unwrap().to_string();
+
+        let openssl = |args: &[&str]| {
+            let out = Command::new("openssl")
+                .args(args)
+                .output()
+                .expect("openssl is needed to build the test certificates");
+            assert!(
+                out.status.success(),
+                "openssl {:?} failed: {}",
+                args,
+                String::from_utf8_lossy(&out.stderr)
+            );
+        };
+
+        let (ca, ca_key) = (at("ca.pem"), at("ca-key.pem"));
+        openssl(&[
+            "req", "-x509", "-newkey", "rsa:2048", "-sha256", "-days", "3650", "-nodes",
+            "-keyout", &ca_key, "-out", &ca, "-subj", "/CN=LWA Test Root CA",
+            "-addext", "basicConstraints=critical,CA:TRUE,pathlen:0",
+            "-addext", "keyUsage=critical,keyCertSign,cRLSign",
+        ]);
+
+        let (key, csr) = (at("server-key.pem"), at("server.csr"));
+        openssl(&[
+            "req", "-newkey", "rsa:2048", "-nodes", "-keyout", &key, "-out", &csr,
+            "-subj", "/CN=server",
+        ]);
+
+        let mut issue = |name: &str, out_name: &str| {
+            let ext = dir.join(format!("{out_name}.ext"));
+            std::fs::write(
+                &ext,
+                format!(
+                    "subjectAltName=DNS:{name}\nbasicConstraints=critical,CA:FALSE\n\
+                     keyUsage=critical,digitalSignature,keyEncipherment\nextendedKeyUsage=serverAuth\n"
+                ),
+            )
+            .unwrap();
+            let out = at(out_name);
+            openssl(&[
+                "x509", "-req", "-in", &csr, "-CA", &ca, "-CAkey", &ca_key, "-CAcreateserial",
+                "-out", &out, "-days", "3650", "-sha256", "-extfile", ext.to_str().unwrap(),
+            ]);
+            out
+        };
+        let app_cert = issue(APP_SERVER_NAME, "app.pem");
+        let other_cert = issue(OTHER_SERVER_NAME, "other.pem");
+
+        // A client identity from the same authority: its own key, and a certificate
+        // marked for client authentication rather than for serving.
+        let (client_key, client_csr) = (at("client-key.pem"), at("client.csr"));
+        openssl(&["genpkey", "-algorithm", "RSA", "-pkeyopt", "rsa_keygen_bits:2048", "-out", &client_key]);
+        openssl(&[
+            "req", "-new", "-key", &client_key, "-out", &client_csr, "-subj", "/CN=lambda-web-adapter",
+        ]);
+        let client_ext = dir.join("client.ext");
+        std::fs::write(
+            &client_ext,
+            "basicConstraints=critical,CA:FALSE\nkeyUsage=critical,digitalSignature\nextendedKeyUsage=clientAuth\n",
+        )
+        .unwrap();
+        let client_cert = at("client.pem");
+        openssl(&[
+            "x509", "-req", "-in", &client_csr, "-CA", &ca, "-CAkey", &ca_key, "-CAcreateserial",
+            "-out", &client_cert, "-days", "3650", "-sha256", "-extfile", client_ext.to_str().unwrap(),
+        ]);
+
+        TlsMaterial {
+            ca,
+            key,
+            app_cert,
+            other_cert,
+            htdocs: htdocs.to_str().unwrap().to_string(),
+            client_cert,
+            client_key,
+        }
+    })
+}
+
+pub struct TlsApp {
+    pub port: u16,
+    child: Child,
+}
+
+/// A one-request TLS application that exposes the HTTP request it received.
+///
+/// The certificate and listener are verifier-owned; the implementation under
+/// test may use any client or TLS stack. This fixture observes only the bytes
+/// delivered after a successful TLS session.
+pub struct TlsRequestRecorder {
+    pub port: u16,
+    rx: std::sync::mpsc::Receiver<String>,
+}
+
+impl TlsRequestRecorder {
+    pub fn start() -> Self {
+        let material = tls_material();
+        let identity_file = std::path::Path::new(&material.ca)
+            .parent()
+            .unwrap()
+            .join("server.p12");
+        if !identity_file.exists() {
+            let out = Command::new("openssl")
+                .args([
+                    "pkcs12",
+                    "-export",
+                    "-out",
+                    identity_file.to_str().unwrap(),
+                    "-inkey",
+                    &material.key,
+                    "-in",
+                    &material.app_cert,
+                    "-passout",
+                    "pass:lwa-test",
+                ])
+                .output()
+                .expect("openssl is needed to build the TLS server identity");
+            assert!(
+                out.status.success(),
+                "openssl pkcs12 failed: {}",
+                String::from_utf8_lossy(&out.stderr)
+            );
+        }
+
+        let identity = hyper_tls::native_tls::Identity::from_pkcs12(
+            &std::fs::read(identity_file).unwrap(),
+            "lwa-test",
+        )
+        .expect("read TLS server identity");
+        let acceptor = hyper_tls::native_tls::TlsAcceptor::new(identity).unwrap();
+        let listener = std::net::TcpListener::bind("127.0.0.1:0").expect("bind TLS recorder");
+        let port = listener.local_addr().unwrap().port();
+        let (tx, rx) = std::sync::mpsc::channel();
+
+        std::thread::spawn(move || {
+            let (stream, _) = listener.accept().expect("accept TLS recorder connection");
+            stream
+                .set_read_timeout(Some(std::time::Duration::from_secs(30)))
+                .unwrap();
+            let mut stream = acceptor.accept(stream).expect("complete TLS handshake");
+            let mut request = Vec::new();
+            let mut chunk = [0u8; 2048];
+            while !request.windows(4).any(|window| window == b"\r\n\r\n") {
+                let n = stream.read(&mut chunk).expect("read HTTP request over TLS");
+                if n == 0 {
+                    break;
+                }
+                request.extend_from_slice(&chunk[..n]);
+            }
+            tx.send(String::from_utf8_lossy(&request).into_owned())
+                .unwrap();
+            stream
+                .write_all(
+                    b"HTTP/1.1 200 OK\r\ncontent-length: 8\r\nx-app-reply: secured\r\nconnection: close\r\n\r\nrecorded",
+                )
+                .unwrap();
+            stream.flush().unwrap();
+        });
+
+        Self { port, rx }
+    }
+
+    pub fn request(self) -> String {
+        self.rx
+            .recv_timeout(PATIENCE)
+            .expect("the TLS application did not receive an HTTP request")
+    }
+}
+
+impl Drop for TlsApp {
+    fn drop(&mut self) {
+        let _ = self.child.kill();
+        let _ = self.child.wait();
+    }
+}
+
+impl TlsApp {
+    /// Serves `hello.txt` over TLS and nothing else — there is no cleartext
+    /// listener to fall back to.
+    pub fn start() -> Self {
+        Self::presenting(&tls_material().app_cert)
+    }
+
+    /// Serves the same page, but refuses the handshake unless the client proves
+    /// who it is with a certificate this authority issued.
+    pub fn demanding_a_client_certificate() -> Self {
+        Self::spawn(&tls_material().app_cert, true)
+    }
+
+    pub fn presenting(cert: &str) -> Self {
+        Self::spawn(cert, false)
+    }
+
+    fn spawn(cert: &str, demand_client_cert: bool) -> Self {
+        let material = tls_material();
+        let port = std::net::TcpListener::bind("127.0.0.1:0")
+            .unwrap()
+            .local_addr()
+            .unwrap()
+            .port();
+        let mut args: Vec<String> = vec![
+            "s_server".into(), "-accept".into(), port.to_string(), "-cert".into(), cert.into(),
+            "-key".into(), material.key.clone(), "-WWW".into(), "-quiet".into(),
+        ];
+        if demand_client_cert {
+            // -Verify, not -verify: the capital form makes the certificate mandatory.
+            args.extend(["-Verify".to_string(), "1".to_string(), "-CAfile".to_string(), material.ca.clone()]);
+        }
+        let child = Command::new("openssl")
+            .args(&args)
+            .current_dir(&material.htdocs)
+            .stdout(Stdio::null())
+            .stderr(Stdio::null())
+            .spawn()
+            .expect("could not start the TLS test application");
+        let app = TlsApp { port, child };
+        let deadline = std::time::Instant::now() + std::time::Duration::from_secs(30);
+        while std::time::Instant::now() < deadline {
+            if std::net::TcpStream::connect(("127.0.0.1", port)).is_ok() {
+                return app;
+            }
+            std::thread::sleep(std::time::Duration::from_millis(50));
+        }
+        panic!("the TLS test application never accepted a connection on port {port}");
+    }
+}
