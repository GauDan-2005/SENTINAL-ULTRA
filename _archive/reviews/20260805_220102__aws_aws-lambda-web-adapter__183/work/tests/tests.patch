+#[tokio::test]
+async fn half_an_identity_changes_nothing_while_tls_is_off() {
+    // A certificate with no key beside it is half an identity, and half an identity
+    // is a configuration error — inside a TLS session. With the switch off there is
+    // no session to prove anything in, so the variable is inert and the plaintext
+    // app answers exactly as it did before anyone set it.
+    let app = MockServer::start();
+    let endpoint = app.mock(|when, then| {
+        when.method(GET).path("/hello");
+        then.status(200).body("plaintext");
+    });
+    clear_adapter_env();
+    env::set_var("HOST", app.host());
+    env::set_var("PORT", app.port().to_string());
+    env::set_var("AWS_LWA_TLS_CLIENT_CERT_FILE", &tls_material().client_cert);
+    let mut adapter = adapter_from_env();
+
+    let response = call(&mut adapter, "/hello")
+        .await
+        .expect("a client certificate named while TLS is off must not stop a cleartext request");
+    assert_eq!(200, response.status());
+    endpoint.assert();
+}
