+
+    hello.assert();
+    assert_eq!(200, response.status());
+    assert_eq!(response.headers().get("content-encoding").unwrap(), "gzip");
+    assert_eq!(
+        "Hello World Hello World Hello World Hello World Hello World",
+        compressed_body_to_string(response).await
+    );
+}
+
+#[tokio::test]
+async fn regression_gzip_skipped_for_uncompressable_type() {
+    let app_server = MockServer::start();
+    let hello = app_server.mock(|when, then| {
+        when.method(GET).path("/hello");
+        then.status(200)
+            .header("content-type", "application/octet-stream")
+            .body("Hello World Hello World Hello World Hello World Hello World");
+    });
+
+    let options = AdapterOptions {
+        compression: true,
+        ..options_for(&app_server)
+    };
+    let mut adapter = Adapter::new(&options);
+    let req = LambdaEventBuilder::new()
+        .with_path("/hello")
+        .with_header("accept-encoding", "gzip")
+        .build();
+    let response = adapter.call(req.into()).await.expect("Request failed");
+
+    hello.assert();
+    assert_eq!(200, response.status());
+    assert_eq!(response.headers().get("content-length").unwrap(), "59");
+    assert!(!response.headers().contains_key("content-encoding"));
+    assert_eq!(
+        "Hello World Hello World Hello World Hello World Hello World",
+        body_to_string(response).await
+    );
+}
+
+#[tokio::test]
+async fn regression_already_compressed_body_is_left_alone() {
+    let app_server = MockServer::start();
+    let mut encoder = GzEncoder::new(Vec::new(), Compression::default());
+    encoder
+        .write_all(b"Hello World Hello World Hello World Hello World Hello World")
+        .unwrap();
+    let gzipped = encoder.finish().unwrap();
+    let gzipped_len = gzipped.len();
+
+    let hello = app_server.mock(|when, then| {
+        when.method(GET).path("/hello");
+        then.status(200)
+            .header("content-type", "text/plain")
+            .header("content-encoding", "gzip")
+            .body(gzipped);
+    });
+
+    let options = AdapterOptions {
+        compression: true,
+        ..options_for(&app_server)
+    };
+    let mut adapter = Adapter::new(&options);
+    let req = LambdaEventBuilder::new()
+        .with_path("/hello")
+        .with_header("accept-encoding", "gzip")
+        .build();
+    let response = adapter.call(req.into()).await.expect("Request failed");
+
+    hello.assert();
+    assert_eq!(200, response.status());
+    assert_eq!(response.headers().get("content-encoding").unwrap(), "gzip");
+    assert_eq!(
+        response.headers().get("content-length").unwrap(),
+        &gzipped_len.to_string()
+    );
+    assert_eq!(
+        "Hello World Hello World Hello World Hello World Hello World",
+        compressed_body_to_string(response).await
+    );
+}
