+    assert_eq!("Hello Stripped", body_to_string(response).await);
+}
+
+#[tokio::test]
+async fn regression_gzip_applied_when_compression_enabled() {
+    let app_server = MockServer::start();
+    let hello = app_server.mock(|when, then| {
+        when.method(GET).path("/hello");
+        then.status(200)
+            .header("content-type", "text/plain")
