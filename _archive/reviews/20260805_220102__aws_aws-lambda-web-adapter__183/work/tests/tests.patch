+//! What turning TLS on actually does to the traffic.
+//!
+//! Everything here drives the adapter the way an operator drives it: through the
+//! environment. Nothing names an internal field or type, so any arrangement of
+//! the code that produces the right behaviour passes.
+//!
+//! Two kinds of observation. Where the question is what went out on the wire, a
+//! bare socket records the first bytes the adapter wrote. Where the question is
+//! whether the exchange actually worked, a real TLS-only application answers —
+//! handshake-shaped bytes are not enough to get a page back from it.
+
+#[path = "lwa_support/mod.rs"]
+mod lwa_support;
+
+use std::env;
+use std::time::Duration;
+
+use flate2::read::GzDecoder;
+use std::io::Read;
+
+use http::{HeaderValue, Method};
+use httpmock::{Method::GET, MockServer};
+use lambda_web_adapter::{Adapter, AdapterOptions};
+use lwa_support::{
+    carries_ascii, clear_adapter_env, looks_like_http_request, looks_like_tls_handshake,
+    tls_material, LambdaEventBuilder, TlsApp, TlsRequestRecorder, WireTap, APP_PAGE,
+    APP_SERVER_NAME, PATIENCE,
+};
+use tower::Service;
+
+fn adapter_from_env() -> Adapter {
+    Adapter::new(&AdapterOptions::from_env())
+}
+
+async fn call(adapter: &mut Adapter, path: &str) -> Result<hyper::Response<hyper::Body>, lambda_http::Error> {
+    let req = LambdaEventBuilder::new().with_path(path).build();
+    tokio::time::timeout(PATIENCE, adapter.call(req.into()))
+        .await
+        .expect("the adapter never finished the request")
+}
+
+async fn call_with(
+    adapter: &mut Adapter,
+    path: &str,
+    header: (&'static str, &str),
+) -> Result<hyper::Response<hyper::Body>, lambda_http::Error> {
+    let req = LambdaEventBuilder::new()
+        .with_path(path)
+        .with_header(header.0, header.1)
+        .build();
+    tokio::time::timeout(PATIENCE, adapter.call(req.into()))
+        .await
+        .expect("the adapter never finished the request")
+}
+
+async fn body_text(res: hyper::Response<hyper::Body>) -> String {
+    String::from_utf8_lossy(&hyper::body::to_bytes(res.into_body()).await.unwrap()).to_string()
+}
+
+/// Point the adapter at a TLS application, TLS on, its authority trusted.
+fn aim_at_tls_app(port: u16) {
+    clear_adapter_env();
+    env::set_var("HOST", "127.0.0.1");
+    env::set_var("PORT", port.to_string());
+    env::set_var("READINESS_CHECK_PORT", port.to_string());
+    env::set_var("READINESS_CHECK_PATH", "/hello.txt");
+    env::set_var("AWS_LWA_ENABLE_TLS", "true");
+    env::set_var("AWS_LWA_TLS_SERVER_NAME", APP_SERVER_NAME);
+    env::set_var("AWS_LWA_TLS_CERT_FILE", &tls_material().ca);
+}
+
+/// Name the identity the adapter should prove itself with.
+fn present_the_client_identity() {
+    let material = tls_material();
+    env::set_var("AWS_LWA_TLS_CLIENT_CERT_FILE", &material.client_cert);
+    env::set_var("AWS_LWA_TLS_CLIENT_KEY_FILE", &material.client_key);
+}
+
+fn aim_at_socket(port: u16, tls: Option<&str>) {
+    clear_adapter_env();
+    env::set_var("HOST", "127.0.0.1");
+    env::set_var("PORT", port.to_string());
+    env::set_var("READINESS_CHECK_PORT", port.to_string());
+    env::set_var("READINESS_CHECK_PATH", "/healthcheck");
+    if let Some(v) = tls {
+        env::set_var("AWS_LWA_ENABLE_TLS", v);
+        env::set_var("AWS_LWA_TLS_SERVER_NAME", APP_SERVER_NAME);
+    }
+}
+
+// -- the switch, observed on the wire ---------------------------------------
+
+async fn assert_wire_is_cleartext(setting: Option<&str>) {
+    let tap = WireTap::start();
+    aim_at_socket(tap.port, setting);
+    let mut adapter = adapter_from_env();
+    let _ = call(&mut adapter, "/hello").await;
+
+    let wire = tap
+        .first_bytes(Duration::from_secs(10))
+        .expect("the adapter must still contact the app");
+    assert!(
+        looks_like_http_request(&wire),
+        "the app must receive a plain HTTP request; first bytes were {:?}",
+        &wire[..wire.len().min(12)]
+    );
+}
+
+#[tokio::test]
+async fn requests_stay_cleartext_when_nothing_asks_for_tls() {
+    assert_wire_is_cleartext(None).await;
+}
+
+#[tokio::test]
+async fn requests_stay_cleartext_when_tls_is_switched_off() {
+    assert_wire_is_cleartext(Some("false")).await;
+}
+
+#[tokio::test]
+async fn a_value_that_is_not_a_bool_leaves_tls_off() {
+    assert_wire_is_cleartext(Some("sure-why-not")).await;
+}
+
+#[tokio::test]
+async fn an_empty_value_leaves_tls_off() {
+    assert_wire_is_cleartext(Some("")).await;
+}
+
+#[tokio::test]
+async fn requests_are_encrypted_when_tls_is_switched_on() {
+    let tap = WireTap::start();
+    aim_at_socket(tap.port, Some("true"));
+    let mut adapter = adapter_from_env();
+    let _ = call(&mut adapter, "/hello").await;
+
+    let wire = tap.first_bytes(Duration::from_secs(10)).expect("the app must still be contacted");
+    assert!(
+        looks_like_tls_handshake(&wire),
+        "the app was spoken to in cleartext; first bytes were {:?}",
+        &wire[..wire.len().min(12)]
+    );
+    assert!(!looks_like_http_request(&wire));
+}
+
+#[tokio::test]
+async fn the_readiness_probe_is_encrypted_when_tls_is_switched_on() {
+    let tap = WireTap::start();
+    aim_at_socket(tap.port, Some("true"));
+    // The tap records bytes and never answers, so the probe would retry until the
+    // suite times out. Async init bounds it: the probe gets its window, then returns.
+    env::set_var("ASYNC_INIT", "true");
+    let mut adapter = adapter_from_env();
+    let _ = tokio::time::timeout(PATIENCE, adapter.check_init_health()).await;
+
+    let wire = tap.first_bytes(Duration::from_secs(10)).expect("the probe must reach the app socket");
+    assert!(
+        looks_like_tls_handshake(&wire),
+        "the readiness probe went out in cleartext; first bytes were {:?}",
+        &wire[..wire.len().min(12)]
+    );
+}
+
+#[tokio::test]
+async fn the_readiness_probe_stays_cleartext_when_tls_is_off() {
+    let tap = WireTap::start();
+    aim_at_socket(tap.port, None);
+    env::set_var("ASYNC_INIT", "true"); // same bound as the encrypted case
+    let mut adapter = adapter_from_env();
+    let _ = tokio::time::timeout(PATIENCE, adapter.check_init_health()).await;
+
+    let wire = tap.first_bytes(Duration::from_secs(10)).expect("the probe must reach the app socket");
+    assert!(looks_like_http_request(&wire), "the readiness probe must stay plain HTTP");
+}
+
+#[tokio::test]
+async fn the_configured_name_travels_in_the_handshake() {
+    let tap = WireTap::start();
+    aim_at_socket(tap.port, Some("true"));
+    let mut adapter = adapter_from_env();
+    let _ = call(&mut adapter, "/hello").await;
+
+    let wire = tap.first_bytes(Duration::from_secs(10)).expect("the app must be contacted");
+    assert!(
+        carries_ascii(&wire, APP_SERVER_NAME),
+        "the configured name must be the name used for the TLS session"
+    );
+
+    // With no name configured the session still has to be opened for something,
+    // and what it is decides which certificates can ever verify.
+    let bare = WireTap::start();
+    clear_adapter_env();
+    env::set_var("HOST", "127.0.0.1");
+    env::set_var("PORT", bare.port.to_string());
+    env::set_var("AWS_LWA_ENABLE_TLS", "true");
+    let mut adapter = adapter_from_env();
+    let _ = call(&mut adapter, "/hello").await;
+
+    let wire = bare.first_bytes(Duration::from_secs(10)).expect("the app must be contacted");
+    assert!(
+        carries_ascii(&wire, "localhost"),
+        "with no name configured the session should be opened for localhost"
+    );
+}
+
+#[tokio::test]
+async fn a_plaintext_app_is_out_of_reach_once_tls_is_on() {
+    let app = MockServer::start();
+    let endpoint = app.mock(|when, then| {
+        when.method(GET).path("/hello");
+        then.status(200).body("plaintext");
+    });
+    clear_adapter_env();
+    env::set_var("HOST", app.host());
+    env::set_var("PORT", app.port().to_string());
+    env::set_var("AWS_LWA_ENABLE_TLS", "true");
+    env::set_var("AWS_LWA_TLS_SERVER_NAME", APP_SERVER_NAME);
+
+    let mut adapter = adapter_from_env();
+    let result = call(&mut adapter, "/hello").await;
+
+    assert!(result.is_err(), "a cleartext app answered while TLS was on");
+    endpoint.assert_hits(0);
+}
+
+// -- against an application that only speaks TLS ------------------------------
+
+#[tokio::test]
+async fn a_request_is_proxied_to_a_tls_only_app() {
+    let app = TlsApp::start();
+    aim_at_tls_app(app.port);
+    let mut adapter = adapter_from_env();
+
+    let response = call(&mut adapter, "/hello.txt")
+        .await
+        .expect("the adapter could not complete a TLS request to the app");
+    assert_eq!(200, response.status());
+    assert!(body_text(response).await.contains(APP_PAGE));
+}
+
+#[tokio::test]
+async fn the_readiness_probe_completes_against_a_tls_only_app() {
+    let app = TlsApp::start();
+    aim_at_tls_app(app.port);
+    let mut adapter = adapter_from_env();
+
+    tokio::time::timeout(PATIENCE, adapter.check_init_health())
+        .await
+        .expect("the readiness probe never finished against a TLS app");
+    let response = call(&mut adapter, "/hello.txt").await.unwrap();
+    assert_eq!(200, response.status());
+}
+
+#[tokio::test]
+async fn the_request_path_selects_what_the_tls_app_returns() {
+    let app = TlsApp::start();
+    aim_at_tls_app(app.port);
+    let mut adapter = adapter_from_env();
+
+    let response = call(&mut adapter, "/other.txt").await.unwrap();
+    assert_eq!(200, response.status());
+    let body = body_text(response).await;
+    assert!(body.contains("the other page"), "wrong page came back: {body:?}");
+    assert!(!body.contains(APP_PAGE));
+}
+
+#[tokio::test]
+async fn the_query_string_reaches_a_tls_app() {
+    let app = TlsRequestRecorder::start();
+    aim_at_tls_app(app.port);
+    let mut adapter = adapter_from_env();
+
+    let req = LambdaEventBuilder::new()
+        .with_path("/hello.txt")
+        .with_query("page", "2")
+        .with_method(Method::DELETE)
+        .with_header("x-lwa-probe", "retained")
+        .build();
+    let response = tokio::time::timeout(PATIENCE, adapter.call(req.into()))
+        .await
+        .expect("the adapter never finished the request")
+        .unwrap();
+    assert_eq!(200, response.status());
+    assert_eq!(
+        Some(&HeaderValue::from_static("secured")),
+        response.headers().get("x-app-reply")
+    );
+    assert_eq!("recorded", body_text(response).await);
+
+    let request = app.request();
+    assert!(
+        request.starts_with("DELETE /hello.txt?page=2 HTTP/1.1\r\n"),
+        "method, path or query changed on the encrypted hop: {request:?}"
+    );
+    assert!(
+        request.to_ascii_lowercase().contains("\r\nx-lwa-probe: retained\r\n"),
+        "the request header did not reach the TLS application: {request:?}"
+    );
+}
+
+#[tokio::test]
+async fn the_base_path_is_stripped_when_proxying_to_a_tls_app() {
+    let app = TlsApp::start();
+    aim_at_tls_app(app.port);
+    env::set_var("REMOVE_BASE_PATH", "/prod");
+    let mut adapter = adapter_from_env();
+
+    let response = call(&mut adapter, "/prod/hello.txt").await.unwrap();
+    assert_eq!(200, response.status());
+    assert!(body_text(response).await.contains(APP_PAGE));
+}
+
+#[tokio::test]
+async fn a_response_from_a_tls_app_is_still_compressed_on_request() {
+    let app = TlsApp::start();
+    aim_at_tls_app(app.port);
+    env::set_var("AWS_LWA_ENABLE_COMPRESSION", "true");
+    let mut adapter = adapter_from_env();
+
+    let response = call_with(&mut adapter, "/hello.txt", ("accept-encoding", "gzip"))
+        .await
+        .unwrap();
+    assert_eq!(200, response.status());
+    assert_eq!(response.headers().get("content-encoding").unwrap(), "gzip");
+
+    let bytes = hyper::body::to_bytes(response.into_body()).await.unwrap();
+    let mut out = String::new();
+    GzDecoder::new(&bytes[..]).read_to_string(&mut out).unwrap();
+    assert!(out.contains(APP_PAGE));
+}
+
+#[tokio::test]
+async fn the_readiness_probe_and_the_request_can_use_different_tls_ports() {
+    let app = TlsApp::start();
+    let probe = TlsApp::start();
+    aim_at_tls_app(app.port);
+    env::set_var("READINESS_CHECK_PORT", probe.port.to_string());
+    let mut adapter = adapter_from_env();
+
+    tokio::time::timeout(PATIENCE, adapter.check_init_health())
+        .await
+        .expect("the readiness probe never finished");
+    let response = call(&mut adapter, "/hello.txt").await.unwrap();
+    assert_eq!(200, response.status());
+    assert!(body_text(response).await.contains(APP_PAGE));
+}
+
+#[tokio::test]
+async fn verification_refuses_a_certificate_it_should_not_accept() {
+    // A positive control has to come first. An adapter that cannot speak TLS at all
+    // also fails to reach these apps, so the refusals below only mean something once
+    // the same app has been shown reachable while its authority is configured.
+    // Each case gets its own app: the test server takes one connection at a time, and
+    // an adapter that is still holding a live one would keep the next case waiting.
+    let trusted = TlsApp::start();
+    aim_at_tls_app(trusted.port);
+    let mut adapter = adapter_from_env();
+    let reachable = call(&mut adapter, "/hello.txt")
+        .await
+        .expect("the app must be reachable while the authority that issued it is configured");
+    assert_eq!(200, reachable.status());
+    drop(adapter);
+
+    // Nothing to chain it to.
+    let unvouched = TlsApp::start();
+    aim_at_tls_app(unvouched.port);
+    env::remove_var("AWS_LWA_TLS_CERT_FILE");
+    let mut adapter = adapter_from_env();
+    assert!(
+        call(&mut adapter, "/hello.txt").await.is_err(),
+        "a certificate from an authority the adapter was never given was accepted anyway"
+    );
+
+    // A chain that checks out, under somebody else's name.
+    drop(adapter);
+    let other = TlsApp::presenting(&tls_material().other_cert);
+    aim_at_tls_app(other.port);
+    let mut adapter = adapter_from_env();
+    assert!(
+        call(&mut adapter, "/hello.txt").await.is_err(),
+        "the app's certificate names somebody else and was accepted anyway"
+    );
+}
+
+#[tokio::test]
+async fn a_client_identity_gets_a_request_into_an_app_that_demands_one() {
+    let app = TlsApp::demanding_a_client_certificate();
+    aim_at_tls_app(app.port);
+    present_the_client_identity();
+    let mut adapter = adapter_from_env();
+
+    let response = call(&mut adapter, "/hello.txt")
+        .await
+        .expect("the app demanded a client certificate and the configured one did not get in");
+    assert_eq!(200, response.status());
+    assert!(body_text(response).await.contains(APP_PAGE));
+}
+
+#[tokio::test]
+async fn an_app_that_demands_a_client_certificate_stays_out_of_reach_without_one() {
+    // Control first: the same kind of app, reachable while an identity is named.
+    // Without it the refusal below would also hold for an adapter that cannot
+    // present anything at all, which proves nothing about the identity.
+    let reachable = TlsApp::demanding_a_client_certificate();
+    aim_at_tls_app(reachable.port);
+    present_the_client_identity();
+    let mut adapter = adapter_from_env();
+    assert_eq!(
+        200,
+        call(&mut adapter, "/hello.txt")
+            .await
+            .expect("the configured identity should have got in")
+            .status()
+    );
+    drop(adapter);
+
+    let closed = TlsApp::demanding_a_client_certificate();
+    aim_at_tls_app(closed.port);
+    let mut adapter = adapter_from_env();
+    assert!(
+        call(&mut adapter, "/hello.txt").await.is_err(),
+        "an app that demands a client certificate answered an adapter that offered none"
+    );
+}
