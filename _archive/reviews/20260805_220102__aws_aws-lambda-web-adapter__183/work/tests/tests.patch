+    assert_eq!("Hello Encoded World", body_to_string(response).await);
+}
+
+#[tokio::test]
+async fn regression_query_parameters_are_forwarded() {
+    let app_server = MockServer::start();
+    let hello = app_server.mock(|when, then| {
