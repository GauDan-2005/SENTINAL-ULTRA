+/// The TLS configuration to use when the adapter has to prove who it is.
+///
+/// `Ok(None)` means no identity was configured and the platform's own trust
+/// settings apply unchanged. `Err` means an identity WAS configured and cannot be
+/// used — half a pair, a file that is not there, material that holds nothing
+/// usable. That is never downgraded to `Ok(None)`.
+fn client_tls_config(options: &AdapterOptions) -> Result<Option<rustls::ClientConfig>, String> {
+    let (cert_file, key_file) = match (&options.tls_client_cert_file, &options.tls_client_key_file) {
+        (None, None) => return Ok(None),
+        (Some(_), None) => return Err("a client certificate was configured without its key".to_string()),
+        (None, Some(_)) => return Err("a client key was configured without its certificate".to_string()),
+        (Some(c), Some(k)) => (c, k),
+    };
+
+    let cert_pem =
+        std::fs::read(cert_file).map_err(|e| format!("the client certificate at {cert_file} could not be read: {e}"))?;
+    let key_pem =
+        std::fs::read(key_file).map_err(|e| format!("the client key at {key_file} could not be read: {e}"))?;
+
+    let certs: Vec<rustls::Certificate> = rustls_pemfile::certs(&mut cert_pem.as_slice())
+        .map_err(|e| format!("the client certificate at {cert_file} could not be parsed: {e}"))?
+        .into_iter()
+        .map(rustls::Certificate)
+        .collect();
+    if certs.is_empty() {
+        return Err(format!("the client certificate at {cert_file} holds no certificate"));
+    }
+
+    let key = rustls_pemfile::pkcs8_private_keys(&mut key_pem.as_slice())
+        .map_err(|e| format!("the client key at {key_file} could not be parsed: {e}"))?
+        .into_iter()
+        .next()
+        .map(rustls::PrivateKey)
+        .ok_or_else(|| format!("the client key at {key_file} holds no private key"))?;
