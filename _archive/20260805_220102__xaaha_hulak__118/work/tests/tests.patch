+func TestExplorerClickOnAnEndpointRowTogglesItBothWays(t *testing.T) {
+	model := sentinelExplorer(t, []UnifiedOperation{
+		{Name: "opalpha", Type: TypeQuery, Endpoint: "http://epalpha/g"},
+		{Name: "opbeta", Type: TypeQuery, Endpoint: "http://epbeta/g"},
+	})
+	model.search.Model.SetValue("e:")
+	model.endpointCursor = 0
+	model.applyFilterAndReset()
+
+	eps := model.filteredEndpoints()
+	if len(eps) != 2 {
+		t.Fatalf("expected the two endpoints of the sample operations, got %v", eps)
+	}
+	clicked := eps[1]
+	delete(model.activeEndpoints, clicked)
+
+	settled := sentinelArmZones(t)
+	view := model.View()
+	settled()
+
+	x, y := sentinelCellBelow(t, view, "Search:", clicked)
+	result, _ := model.Update(sentinelLeftClick(x, y))
+	model = result.(*Model)
+
+	if model.endpointCursor != 1 {
+		t.Fatalf("expected the endpoint cursor on the clicked row, got %d", model.endpointCursor)
+	}
+	if !model.activeEndpoints[clicked] {
+		t.Fatalf("expected clicking the switched off endpoint %q to switch it on", clicked)
+	}
+	if !model.activeEndpoints[eps[0]] {
+		t.Fatalf("expected the endpoint that was not clicked to keep its state")
+	}
+	if !model.focus.LeftFocused() {
+		t.Fatal("expected the endpoint list to take focus after the click")
+	}
+	if model.focus.Typing() {
+		t.Fatal("expected typing to be off after clicking an endpoint")
+	}
+
+	settled = sentinelArmZones(t)
+	view = model.View()
+	settled()
+
+	x, y = sentinelCellBelow(t, view, "Search:", clicked)
+	result, _ = model.Update(sentinelLeftClick(x, y))
+	model = result.(*Model)
+
+	if model.activeEndpoints[clicked] {
+		t.Fatalf("expected clicking the switched on endpoint %q to switch it off", clicked)
+	}
+}
