+func TestDetailFormClickExpandsADropdownThenPicksTheClickedOption(t *testing.T) {
+	ep := "ep"
+	enums := map[string]graphql.EnumType{
+		ScopedTypeKey(ep, "Status"): {
+			Name: "Status",
+			Values: []graphql.EnumValue{
+				{Name: "optone"}, {Name: "opttwo"}, {Name: "optthree"},
+			},
+		},
+	}
+	op := &UnifiedOperation{
+		Name: "statusop", Type: TypeQuery, Endpoint: ep,
+		Arguments: []graphql.Argument{{Name: "statusarg", Type: "Status"}},
+	}
+	df := buildDetailForm(op, nil, enums, nil, nil, nil)
+	if df == nil {
+		t.Fatal("expected a detail form for an operation with an enum argument")
+	}
+
+	z := tui.NewMouseZone()
+	prefix := z.ID("detail")
+
+	settled := sentinelArmZones(t)
+	marked, _ := df.ViewMarked(op, prefix, z.Mark)
+	scanned := tui.ScanMouseZones(marked)
+	settled()
+
+	x, y := sentinelCellOf(t, scanned, "statusarg")
+	if !df.HandleMouse(prefix, sentinelLeftClick(x, y)) {
+		t.Fatal("expected the first click on a closed dropdown to be handled")
+	}
+	if !df.items[0].dropdown.Expanded() {
+		t.Fatal("expected the first click to open the option list")
+	}
+	if !df.items[0].dropdown.Focused() {
+		t.Fatal("expected the first click to focus the dropdown it opened")
+	}
+	if !df.items[0].enabled {
+		t.Fatal("expected the first click to switch the argument behind the dropdown on")
+	}
+
+	settled = sentinelArmZones(t)
+	marked, _ = df.ViewMarked(op, prefix, z.Mark)
+	scanned = tui.ScanMouseZones(marked)
+	settled()
+
+	x, y = sentinelCellOf(t, scanned, "optthree")
+	if !df.HandleMouse(prefix, sentinelLeftClick(x, y)) {
+		t.Fatal("expected the click on an open option row to be handled")
+	}
+	if df.items[0].dropdown.Expanded() {
+		t.Fatal("expected picking an option to close the list")
+	}
+	if got := df.items[0].dropdown.Value(); got != "optthree" {
+		t.Fatalf("expected the clicked option to be the value, got %q", got)
+	}
+	if !df.items[0].enabled {
+		t.Fatal("expected the argument behind the dropdown to be switched on")
+	}
+}
