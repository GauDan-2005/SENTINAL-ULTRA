+func TestDetailFormClickOnAPlainToggleRowMatchesTheSpaceKey(t *testing.T) {
+	op := &UnifiedOperation{
+		Name: "toggleop", Type: TypeQuery, Endpoint: "ep",
+		Arguments: []graphql.Argument{{Name: "flagarg", Type: "Boolean"}},
+	}
+	df := buildDetailForm(op, nil, nil, nil, nil, nil)
+	if df == nil {
+		t.Fatal("expected a detail form for an operation with a boolean argument")
+	}
+	if df.items[0].expandable {
+		t.Fatal("expected a boolean argument to be a plain toggle with nothing to expand")
+	}
+	rows := df.Len()
+
+	z := tui.NewMouseZone()
+	prefix := z.ID("detail")
+	settled := sentinelArmZones(t)
+	marked, _ := df.ViewMarked(op, prefix, z.Mark)
+	scanned := tui.ScanMouseZones(marked)
+	settled()
+
+	x, y := sentinelCellOf(t, scanned, "flagarg")
+	if !df.HandleMouse(prefix, sentinelLeftClick(x, y)) {
+		t.Fatal("expected the click on a plain toggle to be handled")
+	}
+	if df.cursor != 0 {
+		t.Fatalf("expected the form cursor on the clicked row, got %d", df.cursor)
+	}
+	if !df.items[0].toggle.Value {
+		t.Fatal("expected the click to switch the toggle on, the way the space key does")
+	}
+	if !df.items[0].enabled {
+		t.Fatal("expected the argument behind a plain toggle to follow the toggle on")
+	}
+	if df.Len() != rows {
+		t.Fatalf("expected a plain toggle to add no rows, form went from %d to %d", rows, df.Len())
+	}
+
+	if !df.HandleMouse(prefix, sentinelLeftClick(x, y)) {
+		t.Fatal("expected a second click on a plain toggle to be handled")
+	}
+	if df.items[0].toggle.Value {
+		t.Fatal("expected a second click to switch the toggle back off")
+	}
+	if df.items[0].enabled {
+		t.Fatal("expected the argument to follow the toggle back off")
+	}
+}
