+func TestDetailFormMarkedViewMatchesThePlainViewAndClickFocusesTheInput(t *testing.T) {
+	op := &UnifiedOperation{
+		Name: "detailop", Type: TypeQuery, Endpoint: "ep",
+		Arguments: []graphql.Argument{{Name: "queryarg", Type: "String"}},
+	}
+	df := buildDetailForm(op, nil, nil, nil, nil, nil)
+	if df == nil {
+		t.Fatal("expected a detail form for an operation with an argument")
+	}
+
+	z := tui.NewMouseZone()
+	prefix := z.ID("detail")
+
+	plain, plainLine := df.View(op)
+	settled := sentinelArmZones(t)
+	marked, markedLine := df.ViewMarked(op, prefix, z.Mark)
+	scanned := tui.ScanMouseZones(marked)
+	settled()
+
+	if scanned != plain {
+		t.Fatal("expected marking the form not to change what it draws")
+	}
+	if markedLine != plainLine {
+		t.Fatalf("expected the focused line to stay at %d, got %d", plainLine, markedLine)
+	}
+
+	marks := 0
+	counting := func(id, view string) string {
+		marks++
+		return view
+	}
+	bare, bareLine := df.ViewMarked(op, "", counting)
+	if bare != plain {
+		t.Fatal("expected an empty prefix to render exactly what the plain view renders")
+	}
+	if bareLine != plainLine {
+		t.Fatalf("expected an empty prefix to report the same focused line %d, got %d",
+			plainLine, bareLine)
+	}
+	if marks != 0 {
+		t.Fatalf("expected an empty prefix to mark no regions, it marked %d", marks)
+	}
+
+	x, y := sentinelCellOf(t, scanned, "queryarg")
+	if !df.HandleMouse(prefix, sentinelLeftClick(x, y)) {
+		t.Fatal("expected the click on a text argument to be handled")
+	}
+	if df.cursor != 0 {
+		t.Fatalf("expected the form cursor on the clicked row, got %d", df.cursor)
+	}
+	if !df.items[0].input.Model.Focused() {
+		t.Fatal("expected the clicked text argument to be ready for typing")
+	}
+	if !df.items[0].enabled {
+		t.Fatal("expected the clicked argument to be switched on")
+	}
+	if df.HandleMouse(prefix, sentinelLeftClick(x, y+400)) {
+		t.Fatal("expected a click outside every row to be left alone")
+	}
+}
