+package tui
+
+import (
+	"strings"
+	"testing"
+	"time"
+
+	tea "github.com/charmbracelet/bubbletea"
+	"github.com/charmbracelet/lipgloss"
+)
+
+// The zone manager stores marked regions on a background worker, and every scan
+// drops the regions recorded by earlier scans. sentinelArmZones registers a
+// throwaway region and hands back a wait function; once that region is gone the
+// worker has processed a later scan in full, so every region from that later
+// scan is readable.
+const sentinelZoneWait = 10 * time.Second
+
+func sentinelArmZones(t *testing.T) func() {
+	t.Helper()
+	z := NewMouseZone()
+	probe := z.ID("armed")
+	_ = ScanMouseZones(z.Mark(probe, "armed"))
+	sentinelAwaitZone(t, probe, true, "the probe region was never recorded")
+	return func() {
+		sentinelAwaitZone(t, probe, false,
+			"the rendered view never passed through ScanMouseZones")
+	}
+}
+
+func sentinelAwaitZone(t *testing.T, id string, want bool, msg string) {
+	t.Helper()
+	deadline := time.Now().Add(sentinelZoneWait)
+	for {
+		if _, _, _, _, ok := ZoneBounds(id); ok == want {
+			return
+		}
+		if time.Now().After(deadline) {
+			t.Fatalf("%s (zone %q)", msg, id)
+		}
+		time.Sleep(time.Millisecond)
+	}
+}
+
+// sentinelStripSequences removes terminal escape sequences so a rendered line can
+// be searched as plain text.
+func sentinelStripSequences(line string) string {
+	var out strings.Builder
+	for i := 0; i < len(line); {
+		if line[i] == 0x1b {
+			j := i + 1
+			if j < len(line) && line[j] == '[' {
+				j++
+				for j < len(line) && (line[j] < '@' || line[j] > '~') {
+					j++
+				}
+				if j < len(line) {
+					j++
+				}
+				i = j
+				continue
+			}
+			i++
+			continue
+		}
+		out.WriteByte(line[i])
+		i++
+	}
+	return out.String()
+}
+
+type sentinelCell struct{ x, y int }
+
+func sentinelFindAll(view, want string) []sentinelCell {
+	var found []sentinelCell
+	for row, line := range strings.Split(view, "\n") {
+		plain := sentinelStripSequences(line)
+		for at := 0; ; {
+			i := strings.Index(plain[at:], want)
+			if i < 0 {
+				break
+			}
+			at += i
+			found = append(found, sentinelCell{lipgloss.Width(plain[:at]), row})
+			at += len(want)
+		}
+	}
+	return found
+}
+
+// sentinelCellOf returns the screen cell where want is drawn in a rendered view.
+// It fails the test when the text is missing or drawn more than once, so a click
+// always lands somewhere unambiguous.
+func sentinelCellOf(t *testing.T, view, want string) (int, int) {
+	t.Helper()
+	type cell struct{ x, y int }
+	var found []cell
+	for row, line := range strings.Split(view, "\n") {
+		plain := sentinelStripSequences(line)
+		for at := 0; ; {
+			i := strings.Index(plain[at:], want)
+			if i < 0 {
+				break
+			}
+			at += i
+			found = append(found, cell{lipgloss.Width(plain[:at]), row})
+			at += len(want)
+		}
+	}
+	if len(found) != 1 {
+		t.Fatalf("expected %q to be drawn exactly once, it was drawn %d times", want, len(found))
+	}
+	return found[0].x, found[0].y
+}
+
+// sentinelCellBelow returns the cell where want is drawn under the row holding
+// anchor. The picker echoes its first item as the search placeholder, so a bare
+// search for that item would be ambiguous.
+func sentinelCellBelow(t *testing.T, view, anchor, want string) (int, int) {
+	t.Helper()
+	anchors := sentinelFindAll(view, anchor)
+	if len(anchors) != 1 {
+		t.Fatalf("expected the anchor %q to be drawn exactly once, it was drawn %d times",
+			anchor, len(anchors))
+	}
+	var below []sentinelCell
+	for _, c := range sentinelFindAll(view, want) {
+		if c.y > anchors[0].y {
+			below = append(below, c)
+		}
+	}
+	if len(below) != 1 {
+		t.Fatalf("expected %q to be drawn exactly once under %q, it was drawn %d times",
+			want, anchor, len(below))
+	}
+	return below[0].x, below[0].y
+}
+
+func sentinelLeftClick(x, y int) tea.MouseMsg {
+	return tea.MouseMsg{
+		X:      x,
+		Y:      y,
+		Button: tea.MouseButtonLeft,
+		Action: tea.MouseActionRelease,
+	}
+}
+
+// sentinelLeftDrag is the pointer moving with the left button held, which is not
+// a click and has to fall through to whatever already handled mouse events.
+func sentinelLeftDrag(x, y int) tea.MouseMsg {
+	return tea.MouseMsg{
+		X:      x,
+		Y:      y,
+		Button: tea.MouseButtonLeft,
+		Action: tea.MouseActionMotion,
+	}
+}
+
+func sentinelWheelDown(x, y int) tea.MouseMsg {
+	return tea.MouseMsg{
+		X:      x,
+		Y:      y,
+		Button: tea.MouseButtonWheelDown,
+		Action: tea.MouseActionPress,
+	}
+}
+
+func TestMouseZoneIDsDoNotCollideAcrossZones(t *testing.T) {
+	first := NewMouseZone()
+	second := NewMouseZone()
+
+	if first.ID("action") == second.ID("action") {
+		t.Fatalf("two zones produced the same ID for the same name: %q", first.ID("action"))
+	}
+	if first.ID("action") != first.ID("action") {
+		t.Fatal("the same zone produced two different IDs for one name")
+	}
+	if bare := first.ID(); bare == "" || !strings.HasPrefix(first.ID("action"), bare) {
+		t.Fatalf("expected a zone asked for no parts to return the prefix its other IDs are built on, got %q", bare)
+	}
+}
+
+func TestMouseZoneIDJoinsPartsWithColons(t *testing.T) {
+	z := NewMouseZone()
+
+	if got := z.ID("button", "save"); !strings.Contains(got, "button:save") {
+		t.Fatalf("expected the parts joined by a colon in %q", got)
+	}
+	if z.ID("button", "save") == z.ID("button", "cancel") {
+		t.Fatal("expected different parts to build different IDs")
+	}
+}
+
+func TestScanMouseZonesKeepsTextAndRecordsBounds(t *testing.T) {
+	z := NewMouseZone()
+	id := z.ID("row")
+
+	marked := z.Mark(id, "hello")
+	if marked == "hello" {
+		t.Fatal("expected Mark to wrap the fragment with something Scan can find")
+	}
+
+	scanned := ScanMouseZones(marked)
+	if scanned != "hello" {
+		t.Fatalf("expected the visible text back unchanged, got %q", scanned)
+	}
+
+	sentinelAwaitZone(t, id, true, "the marked region was never recorded")
+	startX, startY, endX, endY, ok := ZoneBounds(id)
+	if !ok {
+		t.Fatal("expected bounds for a region that was just scanned")
+	}
+	if startX != 0 || startY != 0 {
+		t.Fatalf("expected the region to begin at the top left, got (%d,%d)", startX, startY)
+	}
+	if endY != startY {
+		t.Fatalf("expected a single line region, got rows %d to %d", startY, endY)
+	}
+	if endX-startX+1 != len("hello") {
+		t.Fatalf("expected the last cell of the region to be its final character, got columns %d to %d",
+			startX, endX)
+	}
+
+	// A later scan is a new picture of the screen, so what the previous one recorded
+	// has to go, or a region that is no longer drawn would still take clicks.
+	later := z.ID("later")
+	_ = ScanMouseZones(z.Mark(later, "world"))
+	sentinelAwaitZone(t, later, true, "the region in the later scan was never recorded")
+	sentinelAwaitZone(t, id, false, "a region from an earlier scan is still recorded")
+	if Hit(id, sentinelLeftClick(startX, startY)) {
+		t.Fatal("expected a region that is no longer drawn to stop taking clicks")
+	}
+}
+
+func TestZoneBoundsAndZonePosInsideAndOutsideARegion(t *testing.T) {
+	z := NewMouseZone()
+	id := z.ID("row")
+
+	_ = ScanMouseZones("pad " + z.Mark(id, "hello"))
+	sentinelAwaitZone(t, id, true, "the marked region was never recorded")
+
+	startX, startY, endX, endY, ok := ZoneBounds(id)
+	if !ok {
+		t.Fatal("expected bounds for a region that was just scanned")
+	}
+	if startX == 0 {
+		t.Fatal("expected the padded region to start away from the left edge")
+	}
+
+	inside := sentinelLeftClick(startX+2, startY)
+	if !Hit(id, inside) {
+		t.Fatal("expected a click inside the region to be a hit")
+	}
+	if x, y := ZonePos(id, inside); x != 2 || y != 0 {
+		t.Fatalf("expected the position relative to the region to be (2,0), got (%d,%d)", x, y)
+	}
+	if x, y := ZonePos(id, sentinelLeftClick(startX, startY)); x != 0 || y != 0 {
+		t.Fatalf("expected the first cell of the region to be (0,0), got (%d,%d)", x, y)
+	}
+
+	past := sentinelLeftClick(endX+1, endY)
+	if Hit(id, past) {
+		t.Fatal("expected a click one cell past the region to miss")
+	}
+	if x, y := ZonePos(id, past); x != -1 || y != -1 {
+		t.Fatalf("expected an out of range position for a click outside the region, got (%d,%d)", x, y)
+	}
+	if _, _, _, _, known := ZoneBounds(z.ID("never", "marked")); known {
+		t.Fatal("expected no bounds for a region that was never marked")
+	}
+	if Hit(z.ID("never", "marked"), sentinelLeftClick(0, 0)) {
+		t.Fatal("expected a region that was never marked to report no hits")
+	}
+}
+
+func TestIsLeftClickOnlyAcceptsALeftRelease(t *testing.T) {
+	if !IsLeftClick(tea.MouseMsg{Button: tea.MouseButtonLeft, Action: tea.MouseActionRelease}) {
+		t.Fatal("expected a left button release to count as a click")
+	}
+	if IsLeftClick(tea.MouseMsg{Button: tea.MouseButtonLeft, Action: tea.MouseActionPress}) {
+		t.Fatal("expected a left button press on its own not to count as a click")
+	}
+	if IsLeftClick(tea.MouseMsg{Button: tea.MouseButtonRight, Action: tea.MouseActionRelease}) {
+		t.Fatal("expected a right button release not to count as a click")
+	}
+	if IsLeftClick(tea.MouseMsg{Button: tea.MouseButtonWheelDown, Action: tea.MouseActionPress}) {
+		t.Fatal("expected a wheel event not to count as a click")
+	}
+}
