+func TestSelectorClickOnARowSelectsAndConfirmsIt(t *testing.T) {
+	m := NewSelector([]string{"itemone", "itemtwo", "itemthree"}, "Pick: ")
+	m.Cursor = 2
+	m.syncViewport()
+
+	settled := sentinelArmZones(t)
+	view := m.View()
+	settled()
+
+	x, y := sentinelCellOf(t, view, "itemtwo")
+
+	dragged, _ := m.Update(sentinelLeftDrag(x, y))
+	if held := dragged.(*SelectorModel); held.Selected != "" || held.Cursor != 2 {
+		t.Fatalf("expected dragging across a row to select nothing and leave the cursor at 2, got %q and %d",
+			held.Selected, held.Cursor)
+	}
+
+	updated, cmd := m.Update(sentinelLeftClick(x, y))
+	model := updated.(*SelectorModel)
+
+	if model.Cursor != 1 {
+		t.Fatalf("expected the cursor to move to the clicked row, got %d", model.Cursor)
+	}
+	if model.Selected != "itemtwo" {
+		t.Fatalf("expected the clicked row to become the selection, got %q", model.Selected)
+	}
+	if cmd == nil {
+		t.Fatal("expected the click to confirm the selection and end the picker")
+	}
+	if _, quitting := cmd().(tea.QuitMsg); !quitting {
+		t.Fatal("expected the command the click returns to be the one that ends the picker")
+	}
+
+	// Every visible row has to be clickable, not just the ones below the first.
+	first := NewSelector([]string{"itemone", "itemtwo", "itemthree"}, "Pick: ")
+	first.Cursor = 2
+	first.syncViewport()
+
+	settled = sentinelArmZones(t)
+	view = first.View()
+	settled()
+
+	x, y = sentinelCellBelow(t, view, "Pick:", "itemone")
+	updated, cmd = first.Update(sentinelLeftClick(x, y))
+	top := updated.(*SelectorModel)
+	if top.Cursor != 0 || top.Selected != "itemone" {
+		t.Fatalf("expected the first row to be clickable too, cursor %d and selection %q",
+			top.Cursor, top.Selected)
+	}
+	if cmd == nil {
+		t.Fatal("expected clicking the first row to confirm it as well")
+	}
+}
