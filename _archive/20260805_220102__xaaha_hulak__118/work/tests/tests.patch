+func TestSelectorScrollAndDragStillReachTheListWithoutSelecting(t *testing.T) {
+	items := make([]string, 0, 12)
+	for i := range 12 {
+		items = append(items, "rowvalue"+string(rune('a'+i)))
+	}
+	m := NewSelector(items, "Pick: ")
