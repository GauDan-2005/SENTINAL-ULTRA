+func TestDetailFormClickOnAnExpandableFieldAddsItsChildRows(t *testing.T) {
+	ep := "ep"
+	objectTypes := map[string]graphql.ObjectType{
+		ScopedTypeKey(ep, "Country"): {
+			Name: "Country",
+			Fields: []graphql.ObjectField{
+				{Name: "codefield", Type: "ID!"},
+				{Name: "langfield", Type: "Language"},
+			},
+		},
+		ScopedTypeKey(ep, "Language"): {
+			Name:   "Language",
+			Fields: []graphql.ObjectField{{Name: "namefield", Type: "String"}},
+		},
+	}
+	op := &UnifiedOperation{Name: "countryop", ReturnType: "Country", Endpoint: ep}
+	df := buildDetailForm(op, nil, nil, objectTypes, nil, nil)
+	if df == nil {
+		t.Fatal("expected a detail form for an operation with an object return type")
+	}
+	before := df.Len()
+
+	z := tui.NewMouseZone()
+	prefix := z.ID("detail")
+	settled := sentinelArmZones(t)
+	marked, _ := df.ViewMarked(op, prefix, z.Mark)
+	scanned := tui.ScanMouseZones(marked)
+	settled()
+
+	x, y := sentinelCellOf(t, scanned, "langfield")
+	if !df.HandleMouse(prefix, sentinelLeftClick(x, y)) {
+		t.Fatal("expected the click on an expandable field to be handled")
+	}
+	if df.cursor != 1 {
+		t.Fatalf("expected the form cursor on the clicked field, got %d", df.cursor)
+	}
+	if !df.items[1].toggle.Value {
+		t.Fatal("expected the clicked field to be switched on")
+	}
+	if df.Len() != before+1 {
+		t.Fatalf("expected the child row of the clicked field to appear, form went from %d to %d rows",
+			before, df.Len())
+	}
+}
