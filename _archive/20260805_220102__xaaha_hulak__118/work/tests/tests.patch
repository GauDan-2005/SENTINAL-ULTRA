+func TestExplorerClickOnAnOperationRowMovesTheCursorAndFocusesTheList(t *testing.T) {
+	model := sentinelExplorer(t, []UnifiedOperation{
+		{Name: "opalpha", Type: TypeQuery, Description: "first", Endpoint: "http://one/g"},
+		{Name: "opbeta", Type: TypeQuery, Description: "second", Endpoint: "http://two/g"},
+		{Name: "opgamma", Type: TypeQuery, Description: "third", Endpoint: "http://three/g"},
+	})
+	model.cursor = len(model.filtered) - 1
+	model.syncViewport()
+
+	settled := sentinelArmZones(t)
+	view := model.View()
+	settled()
+
+	x, y := sentinelCellBelow(t, view, "Search:", "opbeta")
+
+	for _, quiet := range []tea.MouseMsg{sentinelWheelDown(x, y), sentinelLeftDrag(x, y)} {
+		passed, _ := model.Update(quiet)
+		model = passed.(*Model)
+		if model.cursor == 1 {
+			t.Fatal("expected scroll and drag events to pass through rather than pick a row")
+		}
+	}
+
+	result, _ := model.Update(sentinelLeftClick(x, y))
+	model = result.(*Model)
+
+	if model.cursor != 1 {
+		t.Fatalf("expected the cursor on the clicked operation, got %d", model.cursor)
+	}
+	if !model.focus.LeftFocused() {
+		t.Fatal("expected the operation list to take focus after the click")
+	}
+	if model.focus.Typing() {
+		t.Fatal("expected typing to be off after clicking an operation")
+	}
+
+	// The explorer draws a single stacked panel when the terminal is too narrow for
+	// two, and that view has to record its regions the same way the wide one does.
+	narrowed, _ := model.Update(tea.WindowSizeMsg{Width: 60, Height: 20})
+	model = narrowed.(*Model)
+
+	settled = sentinelArmZones(t)
+	view = model.View()
+	settled()
+
+	x, y = sentinelCellBelow(t, view, "Search:", "opgamma")
+	result, _ = model.Update(sentinelLeftClick(x, y))
+	model = result.(*Model)
+
+	if model.cursor != 2 {
+		t.Fatalf("expected a click to work in the narrow layout too, cursor is %d", model.cursor)
+	}
+}
