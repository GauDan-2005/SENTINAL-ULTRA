+		t.Fatalf("expected a scroll event to select nothing and move no cursor, got %q and %d",
+			model.Selected, model.Cursor)
+	}
+
+	scrolled := model.viewport.YOffset
+	updated, _ = model.Update(sentinelLeftDrag(2, 5))
+	model = updated.(*SelectorModel)
+
+	if model.Selected != "" || model.Cursor != 0 {
+		t.Fatalf("expected a drag to select nothing and move no cursor, got %q and %d",
+			model.Selected, model.Cursor)
+	}
+	if model.viewport.YOffset != scrolled {
+		t.Fatalf("expected a drag to leave the list where scrolling put it, offset moved to %d",
+			model.viewport.YOffset)
+	}
+
+	updated, _ = model.Update(sentinelWheelDown(0, 0))
+	model = updated.(*SelectorModel)
+	if model.viewport.YOffset <= scrolled {
+		t.Fatal("expected scrolling to keep working after a drag")
+	}
+}
