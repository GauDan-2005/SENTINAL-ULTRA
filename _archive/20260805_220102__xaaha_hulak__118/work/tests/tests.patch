+func TestDetailFormToggleReachesOnlyTheRowItBelongsTo(t *testing.T) {
+	ep := "ep"
+	inputTypes := map[string]graphql.InputType{
+		ScopedTypeKey(ep, "FilterInput"): {
+			Name: "FilterInput",
+			Fields: []graphql.InputField{
+				{Name: "keywordfield", Type: "String!"},
+				{Name: "catfield", Type: "String"},
+				{Name: "activefield", Type: "Boolean"},
+			},
+		},
+	}
+	op := &UnifiedOperation{
+		Name: "filterop", Type: TypeQuery, Endpoint: ep,
+		Arguments: []graphql.Argument{{Name: "filterarg", Type: "FilterInput"}},
+	}
+	df := buildDetailForm(op, inputTypes, nil, nil, nil, nil)
+	if df == nil {
+		t.Fatal("expected a detail form for an operation with an input object argument")
+	}
+	if df.argCount != 3 {
+		t.Fatalf("expected the input object to expand into 3 rows, got %d", df.argCount)
+	}
+	for i := range 3 {
+		if df.items[i].enabled {
+			t.Fatalf("expected row %d to start switched off under an optional argument", i)
+		}
+	}
+	if !df.items[0].required {
+		t.Fatal("expected a field that is required in its own right to keep saying so")
+	}
+
+	z := tui.NewMouseZone()
+	prefix := z.ID("detail")
+	settled := sentinelArmZones(t)
+	marked, _ := df.ViewMarked(op, prefix, z.Mark)
+	scanned := tui.ScanMouseZones(marked)
+	settled()
+
+	x, y := sentinelCellOf(t, scanned, "activefield")
+	if !df.HandleMouse(prefix, sentinelLeftClick(x, y)) {
+		t.Fatal("expected the click on the boolean row to be handled")
+	}
+	if !df.items[2].enabled {
+		t.Fatal("expected the clicked row to be switched on")
+	}
+	if df.items[0].enabled || df.items[1].enabled {
+		t.Fatalf("expected the rows sharing the argument not to follow the clicked one, got %v and %v",
+			df.items[0].enabled, df.items[1].enabled)
+	}
+
+	// The keyboard reaches exactly as far as the mouse does.
+	df.cursor = 0
+	df.FocusCurrent()
+	df.HandleKey(tea.KeyMsg{Type: tea.KeyRunes, Runes: []rune{' '}})
+	if !df.items[0].enabled {
+		t.Fatal("expected the space key to switch the row under the cursor on")
+	}
+	if df.items[1].enabled {
+		t.Fatal("expected the row beside it to stay switched off")
+	}
+	if !df.items[2].enabled {
+		t.Fatal("expected the row switched on by the mouse to stay on")
+	}
+
+	// A list argument is the other side of the same rule. Its rows do move as a
+	// group, and a click has to reach as far as the space key does.
+	listOp := &UnifiedOperation{
+		Name: "listop", Type: TypeQuery, Endpoint: ep,
+		Arguments: []graphql.Argument{{Name: "idsarg", Type: "[ID]"}},
+	}
+	byKey := buildDetailForm(listOp, nil, nil, nil, nil, nil)
+	byKey.items[0].input.Model.SetValue("a")
+	byKey.syncListArgRows("idsarg")
+	byKey.FocusCurrent()
+	byKey.HandleKey(tea.KeyMsg{Type: tea.KeyRunes, Runes: []rune{' '}})
+	if byKey.argCount < 2 {
+		t.Fatalf("expected a second list row once the first has a value, got %d", byKey.argCount)
+	}
+
+	byMouse := buildDetailForm(listOp, nil, nil, nil, nil, nil)
+	byMouse.items[0].input.Model.SetValue("a")
+	byMouse.syncListArgRows("idsarg")
+
+	lz := tui.NewMouseZone()
+	listPrefix := lz.ID("detail")
+	settled = sentinelArmZones(t)
+	listMarked, _ := byMouse.ViewMarked(listOp, listPrefix, lz.Mark)
+	listScanned := tui.ScanMouseZones(listMarked)
+	settled()
+
+	rx, ry := sentinelCellOf(t, listScanned, "idsarg")
+	if !byMouse.HandleMouse(listPrefix, sentinelLeftClick(rx, ry)) {
+		t.Fatal("expected the click on a list row to be handled")
+	}
+	for i := 0; i < byKey.argCount; i++ {
+		if byMouse.items[i].enabled != byKey.items[i].enabled {
+			t.Fatalf("list row %d is %v after a click and %v after the space key, they have to agree",
+				i, byMouse.items[i].enabled, byKey.items[i].enabled)
+		}
+	}
+	if !byMouse.items[1].enabled {
+		t.Fatal("expected a click on one list row to carry the whole list argument with it")
+	}
+}
