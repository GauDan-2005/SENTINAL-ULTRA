+	if model.detailForm.cursor != 0 {
+		t.Fatalf("expected the detail cursor on the clicked row, got %d", model.detailForm.cursor)
+	}
+	if !model.detailForm.items[0].input.Model.Focused() {
+		t.Fatal("expected the clicked text argument to be ready for typing")
+	}
+}
