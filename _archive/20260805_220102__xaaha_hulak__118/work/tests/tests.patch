+func TestExplorerClickOnTheSearchBoxFocusesTheListAndTyping(t *testing.T) {
+	model := sentinelExplorer(t, []UnifiedOperation{{
+		Name: "searchop", Type: TypeQuery, Endpoint: "http://one/g",
+		Arguments: []graphql.Argument{{Name: "detailarg", Type: "String"}},
+	}})
+	model.focus.FocusByNumber(model.detailPanel.Number)
+	model.syncSearchFocus()
+	if model.focus.LeftFocused() {
+		t.Fatal("expected the detail panel to hold focus before the click")
+	}
+
+	settled := sentinelArmZones(t)
+	view := model.View()
+	settled()
+
+	x, y := sentinelCellOf(t, view, "Search:")
+	result, _ := model.Update(sentinelLeftClick(x, y))
+	model = result.(*Model)
+
+	if !model.focus.LeftFocused() {
+		t.Fatal("expected the click on the search box to focus the list panel")
+	}
+	if !model.focus.Typing() {
+		t.Fatal("expected the click on the search box to turn typing on")
+	}
+	if !model.search.Model.Focused() {
+		t.Fatal("expected the search input to be ready for typing after the click")
+	}
+	if model.detailForm == nil || model.detailForm.Len() == 0 {
+		t.Fatal("expected the detail form to be live, so the click had two live regions to choose between")
+	}
+	if model.detailForm.items[0].input.Model.Focused() {
+		t.Fatal("expected the click on the search box to leave the detail form alone")
+	}
+	if model.focus.IsFocused(model.detailPanel) {
+		t.Fatal("expected the click on the search box not to focus the detail panel")
+	}
