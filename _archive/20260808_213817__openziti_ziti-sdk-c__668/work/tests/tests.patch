+TEST_CASE("sentinel_ctrl_no_switch_while_a_request_is_in_flight", "[sentinel][controller]") {
+    ziti_controller ctrl;
+    uv_loop_t *loop = uv_default_loop();
+
+    model_list endpoints = {nullptr};
+    model_list_append(&endpoints, (void *) SENTINEL_EP1);
+    model_list_append(&endpoints, (void *) SENTINEL_EP2);
+    model_list_append(&endpoints, (void *) SENTINEL_EP3);
+
+    REQUIRE(ziti_ctrl_init(loop, &ctrl, &endpoints, nullptr) == ZITI_OK);
+
+    // let the request init puts on the wire finish, so the two started below
+    // are the only ones outstanding
+    uv_run(loop, UV_RUN_DEFAULT);
+    REQUIRE(ctrl.active_reqs == 0);
+    REQUIRE(ctrl.url != nullptr);
+    std::string before = ctrl.url;
+
+    inflight_capture first = {&ctrl, false, 0, ""};
+    inflight_capture second = {&ctrl, false, 0, ""};
+    ziti_ctrl_login(&ctrl, nullptr, sentinel_inflight_cb, &first);
+    ziti_ctrl_login(&ctrl, nullptr, sentinel_inflight_cb, &second);
+
+    // both are counted while they are outstanding
+    CHECK(ctrl.active_reqs == 2);
+
+    uv_run(loop, UV_RUN_DEFAULT);
+    REQUIRE(first.called);
+    REQUIRE(second.called);
+    CHECK(ctrl.active_reqs == 0);
+
+    // exactly one of the two came back while the other was still outstanding
+    int saw_outstanding = (first.reqs_at_cb > 0 ? 1 : 0) + (second.reqs_at_cb > 0 ? 1 : 0);
+    CHECK(saw_outstanding == 1);
+
+    // and that one must not have moved the endpoint, because something else
+    // was still in flight when it failed
+    if (first.reqs_at_cb > 0) { CHECK_THAT(first.url_at_cb, Equals(before)); }
+    if (second.reqs_at_cb > 0) { CHECK_THAT(second.url_at_cb, Equals(before)); }
+
+    // once nothing was left in flight, the move happened
+    REQUIRE(ctrl.url != nullptr);
+    CHECK(std::string(ctrl.url) != before);
+
+    // a cancelled request is not a transport failure and must not move anything
+    std::string settled = ctrl.url;
+    inflight_capture cancelled = {&ctrl, false, 0, ""};
+    ziti_ctrl_login(&ctrl, nullptr, sentinel_inflight_cb, &cancelled);
+    ziti_ctrl_cancel(&ctrl);
+    uv_run(loop, UV_RUN_DEFAULT);
+    CHECK(cancelled.called);
+    REQUIRE(ctrl.url != nullptr);
+    CHECK_THAT(ctrl.url, Equals(settled));
+
+    model_list_clear(&endpoints, nullptr);
+    ziti_ctrl_close(&ctrl);
+    uv_run(loop, UV_RUN_DEFAULT);
+}
