+namespace {
+    struct inflight_capture {
+        ziti_controller *ctrl;
+        bool called;
+        unsigned int reqs_at_cb;
+        std::string url_at_cb;
+    };
+
+    void sentinel_inflight_cb(ziti_api_session *s, const ziti_error *, void *ctx) {
+        auto *c = (inflight_capture *) ctx;
+        c->called = true;
+        c->reqs_at_cb = c->ctrl->active_reqs;
+        c->url_at_cb = c->ctrl->url != nullptr ? c->ctrl->url : "";
+        free_ziti_api_session_ptr(s);
+    }
+}
