+TEST_CASE("sentinel_ctrl_prefers_peer_reported_online", "[sentinel][controller]") {
+    uv_loop_t *loop = uv_loop_new();
+    fake_ctrl srv;
+    REQUIRE(sentinel_start_ctrl(&srv, loop));
+    srv.advertise_ha = true;
+    srv.peers_payload = sentinel_three_peers(srv.url);
+
+    ziti_controller ctrl;
+    model_list endpoints = {nullptr};
+    sentinel_only(&endpoints, srv.url);
+    REQUIRE(ziti_ctrl_init(loop, &ctrl, &endpoints, nullptr) == ZITI_OK);
+    uv_run(loop, UV_RUN_DEFAULT);
+
+    login_capture login;
+    ziti_ctrl_login(&ctrl, nullptr, sentinel_login_cb, &login);
+    uv_run(loop, UV_RUN_DEFAULT);
+    REQUIRE(srv.controller_reqs == 1);
+    REQUIRE(model_map_size(&ctrl.endpoints) == 3);
+    REQUIRE(ctrl.url != nullptr);
+    REQUIRE(std::string(ctrl.url) == srv.url);
+
+    // the controller goes away, so the next request fails at the transport level
+    sentinel_stop_ctrl(&srv);
+    login_capture again;
+    ziti_ctrl_login(&ctrl, nullptr, sentinel_login_cb, &again);
+    uv_run(loop, UV_RUN_DEFAULT);
+    REQUIRE(again.called);
+    CHECK(again.err != 0);
+
+    // the peer the controller reported online is the one to move to, and the one
+    // it reported offline is not
+    REQUIRE(ctrl.url != nullptr);
+    CHECK_THAT(ctrl.url, Equals(SENTINEL_PEER_UP));
+
+    model_list_clear(&endpoints, nullptr);
+    ziti_ctrl_close(&ctrl);
+    uv_run(loop, UV_RUN_DEFAULT);
+    uv_loop_close(loop);
+    free(loop);
+}
