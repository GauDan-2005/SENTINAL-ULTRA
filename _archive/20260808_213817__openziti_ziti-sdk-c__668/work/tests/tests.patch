+TEST_CASE("sentinel_ctrl_refresh_replaces_dropped_endpoint", "[sentinel][controller]") {
+    uv_loop_t *loop = uv_loop_new();
+    fake_ctrl srv;
+    REQUIRE(sentinel_start_ctrl(&srv, loop));
+    srv.advertise_ha = true;
+    // the controller answers with a set that no longer contains the endpoint in use
+    srv.peers_payload = sentinel_peers_without_self();
+
+    ziti_controller ctrl;
+    model_list endpoints = {nullptr};
+    sentinel_only(&endpoints, srv.url);
+    REQUIRE(ziti_ctrl_init(loop, &ctrl, &endpoints, nullptr) == ZITI_OK);
+    uv_run(loop, UV_RUN_DEFAULT);
+    REQUIRE(ctrl.url != nullptr);
+    REQUIRE(std::string(ctrl.url) == srv.url);
+
+    login_capture login;
+    ziti_ctrl_login(&ctrl, nullptr, sentinel_login_cb, &login);
+    uv_run(loop, UV_RUN_DEFAULT);
+    REQUIRE(login.called);
+    REQUIRE(srv.controller_reqs == 1);
+
+    // the set is now the two the controller named, and the endpoint in use has to
+    // be one of them rather than the one that was dropped
+    std::set<std::string> expected = {SENTINEL_PEER_UP, SENTINEL_PEER_DOWN};
+    CHECK(sentinel_endpoint_keys(&ctrl) == expected);
+    REQUIRE(ctrl.url != nullptr);
+    CHECK(expected.count(ctrl.url) == 1);
+
+    model_list_clear(&endpoints, nullptr);
+    ziti_ctrl_close(&ctrl);
+    sentinel_stop_ctrl(&srv);
+    uv_run(loop, UV_RUN_DEFAULT);
+    uv_loop_close(loop);
+    free(loop);
+}
