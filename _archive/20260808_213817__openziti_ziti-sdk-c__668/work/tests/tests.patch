+// ---------------------------------------------------------------------------
+// Peer discovery and endpoint-state coverage.
+//
+// These cases need a controller that answers, and the verifier has no network.
+// Airgapped means no egress, not no sockets, so the controller under test talks
+// to a throwaway HTTP server bound to 127.0.0.1 on an ephemeral port, running on
+// the same loop and inside the same process. It answers /version, /authenticate,
+// /controllers and /current-identity/edge-routers with canned payloads, and it
+// refuses /controllers to a caller that has not presented a session, the way a
+// real controller does.
+// ---------------------------------------------------------------------------
+
+namespace {
+
+    const char *const SENTINEL_PEER_UP = "http://ctrl-up.sentinel.invalid:1280";
+    const char *const SENTINEL_PEER_DOWN = "http://ctrl-down.sentinel.invalid:1280";
+    const char *const SENTINEL_PEER_OLD_API = "http://ctrl-oldapi.sentinel.invalid:1280";
+
+    std::string sentinel_envelope(const std::string &data) {
+        return "{\"data\":" + data + "}";
+    }
+
+    std::string sentinel_paged(const std::string &data, int total) {
+        return "{\"data\":" + data +
+               ",\"meta\":{\"pagination\":{\"limit\":25,\"offset\":0,\"totalCount\":" +
+               std::to_string(total) + "}}}";
+    }
+
+    std::string sentinel_version_payload(bool ha) {
+        return std::string("{\"version\":\"v1.1.1\",\"revision\":\"sentinel\",")
+               + "\"buildDate\":\"2024-06-07 00:00:00\",\"capabilities\":"
+               + (ha ? "[\"HA_CONTROLLER\"]" : "[]") + "}";
+    }
+
+    std::string sentinel_peer(const std::string &id, const std::string &url, bool online) {
+        return "{\"id\":\"" + id + "\",\"name\":\"" + id +
+               "\",\"apiAddresses\":{\"edge-client\":[{\"url\":\"" + url +
+               "\",\"version\":\"v1\"}]},\"isOnline\":" + (online ? "true" : "false") + "}";
+    }
+
+    struct fake_ctrl {
+        uv_tcp_t server{};
+        uv_loop_t *loop = nullptr;
+        std::string url;
+        bool advertise_ha = true;
+        std::string peers_payload;
+        int version_reqs = 0;
+        int authenticate_reqs = 0;
+        int controller_reqs = 0;
+        int edge_router_reqs = 0;
+        int unauthorized_controller_reqs = 0;
+        std::string redirect_to;
+        bool listening = false;
+    };
+
+    struct fake_conn {
+        uv_tcp_t handle{};
+        fake_ctrl *srv = nullptr;
+        std::string in;
+        std::string out;
+        uv_write_t wr{};
+    };
+
+    bool sentinel_header_present(const std::string &req, const std::string &name) {
+        std::string lower;
+        lower.reserve(req.size());
+        for (size_t i = 0; i < req.size(); i++) {
+            lower.push_back((char) tolower((unsigned char) req[i]));
+        }
+        return lower.find("\r\n" + name + ":") != std::string::npos;
+    }
+
+    std::string sentinel_reply(fake_ctrl *srv, const std::string &req) {
+        size_t sp = req.find(' ');
+        size_t sp2 = sp == std::string::npos ? std::string::npos : req.find(' ', sp + 1);
+        std::string path = (sp == std::string::npos || sp2 == std::string::npos)
+                           ? std::string() : req.substr(sp + 1, sp2 - sp - 1);
+
+        int status = 200;
+        std::string body;
+        if (path.compare(0, 8, "/version") == 0) {
+            srv->version_reqs++;
+            body = sentinel_envelope(sentinel_version_payload(srv->advertise_ha));
+        } else if (path.compare(0, 13, "/authenticate") == 0) {
+            srv->authenticate_reqs++;
+            body = sentinel_envelope("{\"id\":\"sentinel-session\",\"token\":\"sentinel-token\"}");
+        } else if (path.compare(0, 12, "/controllers") == 0) {
+            // a real controller will not list its peers to an unauthenticated caller
+            if (!sentinel_header_present(req, "zt-session")) {
+                srv->unauthorized_controller_reqs++;
+                status = 401;
+                body = "{\"error\":{\"code\":\"UNAUTHORIZED\",\"message\":\"no api session\"}}";
+            } else {
+                srv->controller_reqs++;
+                body = sentinel_paged(srv->peers_payload, 4);
+            }
+        } else if (path.find("/current-identity/edge-routers") == 0) {
+            srv->edge_router_reqs++;
+            body = sentinel_paged("[]", 0);
+        } else {
+            status = 404;
+            body = "{\"error\":{\"code\":\"NOT_FOUND\",\"message\":\"no\"}}";
+        }
+
+        std::string extra;
+        if (!srv->redirect_to.empty()) {
+            // the header a controller uses to hand its callers a different address
+            extra = "ziti-ctrl-address: " + srv->redirect_to + "\r\n";
+        }
+        return "HTTP/1.1 " + std::to_string(status) + (status == 200 ? " OK" : " ERR") +
+               "\r\nContent-Type: application/json\r\n" + extra + "Content-Length: " +
+               std::to_string(body.size()) + "\r\nConnection: close\r\n\r\n" + body;
+    }
+
+    bool sentinel_request_complete(const std::string &in) {
+        size_t head = in.find("\r\n\r\n");
+        if (head == std::string::npos) { return false; }
+        std::string lower;
+        lower.reserve(head);
+        for (size_t i = 0; i < head; i++) { lower.push_back((char) tolower((unsigned char) in[i])); }
+        size_t cl = lower.find("content-length:");
+        if (cl == std::string::npos) { return true; }
+        size_t len = (size_t) strtoul(in.c_str() + cl + strlen("content-length:"), nullptr, 10);
+        return in.size() >= head + 4 + len;
+    }
+
+    void sentinel_on_conn_closed(uv_handle_t *h) {
+        delete (fake_conn *) h->data;
+    }
+
+    void sentinel_on_written(uv_write_t *w, int) {
+        uv_close((uv_handle_t *) w->handle, sentinel_on_conn_closed);
+    }
+
+    void sentinel_alloc(uv_handle_t *, size_t suggested, uv_buf_t *buf) {
+        buf->base = (char *) malloc(suggested);
+        buf->len = suggested;
+    }
+
+    void sentinel_on_read(uv_stream_t *stream, ssize_t nread, const uv_buf_t *buf) {
+        auto *c = (fake_conn *) stream->data;
+        if (nread > 0) {
+            c->in.append(buf->base, (size_t) nread);
+            if (sentinel_request_complete(c->in)) {
+                uv_read_stop(stream);
+                c->out = sentinel_reply(c->srv, c->in);
+                uv_buf_t out = uv_buf_init((char *) c->out.data(), (unsigned int) c->out.size());
+                c->wr.data = c;
+                uv_write(&c->wr, stream, &out, 1, sentinel_on_written);
+            }
+        } else if (nread < 0) {
+            uv_read_stop(stream);
+            uv_close((uv_handle_t *) stream, sentinel_on_conn_closed);
+        }
+        free(buf->base);
+    }
+
+    void sentinel_on_connection(uv_stream_t *server, int status) {
+        if (status < 0) { return; }
+        auto *srv = (fake_ctrl *) server->data;
+        auto *c = new fake_conn();
+        c->srv = srv;
+        uv_tcp_init(srv->loop, &c->handle);
+        c->handle.data = c;
+        if (uv_accept(server, (uv_stream_t *) &c->handle) == 0) {
+            uv_read_start((uv_stream_t *) &c->handle, sentinel_alloc, sentinel_on_read);
+        } else {
+            uv_close((uv_handle_t *) &c->handle, sentinel_on_conn_closed);
+        }
+    }
+
+    bool sentinel_start_ctrl(fake_ctrl *srv, uv_loop_t *loop) {
+        srv->loop = loop;
+        if (uv_tcp_init(loop, &srv->server) != 0) { return false; }
+        srv->server.data = srv;
+        struct sockaddr_in addr{};
+        uv_ip4_addr("127.0.0.1", 0, &addr);
+        if (uv_tcp_bind(&srv->server, (const struct sockaddr *) &addr, 0) != 0) { return false; }
+        if (uv_listen((uv_stream_t *) &srv->server, 16, sentinel_on_connection) != 0) { return false; }
+
+        struct sockaddr_in bound{};
+        int len = sizeof(bound);
+        if (uv_tcp_getsockname(&srv->server, (struct sockaddr *) &bound, &len) != 0) { return false; }
+        srv->url = "http://127.0.0.1:" + std::to_string(ntohs(bound.sin_port));
+        // the listener must not keep uv_run alive once the controller is idle
+        uv_unref((uv_handle_t *) &srv->server);
+        srv->listening = true;
+        return true;
+    }
+
+    void sentinel_stop_ctrl(fake_ctrl *srv) {
+        if (!srv->listening) { return; }
+        srv->listening = false;
+        uv_close((uv_handle_t *) &srv->server, nullptr);
+        uv_run(srv->loop, UV_RUN_NOWAIT);
+    }
+
+    struct login_capture {
+        bool called = false;
+        int err = 0;
+    };
+
+    void sentinel_login_cb(ziti_api_session *s, const ziti_error *err, void *ctx) {
+        auto *c = (login_capture *) ctx;
+        c->called = true;
+        if (err) { c->err = err->err; }
+        free_ziti_api_session_ptr(s);
+    }
+
+    void sentinel_routers_cb(ziti_edge_router_array ers, const ziti_error *err, void *ctx) {
+        auto *c = (login_capture *) ctx;
+        c->called = true;
+        if (err) { c->err = err->err; }
+        free_ziti_edge_router_array(&ers);
+    }
+
+    // one endpoint list holding just the fake controller
+    void sentinel_only(model_list *l, const std::string &url) {
+        model_list_append(l, (void *) url.c_str());
+    }
+
+    // a peer that only publishes an older edge API, which is not the one to use
+    std::string sentinel_peer_old_api(const std::string &id, const std::string &url) {
+        return "{\"id\":\"" + id + "\",\"name\":\"" + id +
+               "\",\"apiAddresses\":{\"edge-client\":[{\"url\":\"" + url +
+               "\",\"version\":\"v2\"}]},\"isOnline\":true}";
+    }
+
+    // a peer list that does not mention the endpoint currently in use
+    std::string sentinel_peers_without_self() {
+        return "[" + sentinel_peer("ctrl-up", SENTINEL_PEER_UP, true) + "," +
+               sentinel_peer("ctrl-down", SENTINEL_PEER_DOWN, true) + "]";
+    }
+
+    std::string sentinel_three_peers(const std::string &self_url) {
+        return "[" + sentinel_peer("ctrl-self", self_url, true) + "," +
+               sentinel_peer("ctrl-up", SENTINEL_PEER_UP, true) + "," +
+               sentinel_peer("ctrl-down", SENTINEL_PEER_DOWN, false) + "," +
+               sentinel_peer_old_api("ctrl-oldapi", SENTINEL_PEER_OLD_API) + "]";
+    }
+}
