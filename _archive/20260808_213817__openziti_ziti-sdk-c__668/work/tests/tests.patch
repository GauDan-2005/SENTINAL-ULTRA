+TEST_CASE("sentinel_ctrl_failover_switches_endpoint", "[sentinel][controller]") {
+    ziti_controller ctrl;
+    uv_loop_t *loop = uv_default_loop();
+
+    model_list endpoints = {nullptr};
+    model_list_append(&endpoints, (void *) SENTINEL_EP1);
+    model_list_append(&endpoints, (void *) SENTINEL_EP2);
+    model_list_append(&endpoints, (void *) SENTINEL_EP3);
+
+    REQUIRE(ziti_ctrl_init(loop, &ctrl, &endpoints, nullptr) == ZITI_OK);
+    REQUIRE(ctrl.url != nullptr);
+
+    std::set<std::string> expected = {SENTINEL_EP1, SENTINEL_EP2, SENTINEL_EP3};
+    std::string start = ctrl.url;
+    bool switched = false;
+    for (int i = 0; i < 50; i++) {
+        sentinel_version_capture cap = sentinel_failed_request(&ctrl, loop);
+        REQUIRE(cap.called);
+        REQUIRE(cap.err != 0);
+        REQUIRE(ctrl.url != nullptr);
+        if (start != std::string(ctrl.url)) { switched = true; }
+        // whatever it moves to is one it already knew about, and moving does
+        // not change the set it is choosing from
+        CHECK(expected.count(ctrl.url) == 1);
+        CHECK(sentinel_endpoint_keys(&ctrl) == expected);
+    }
+    CHECK(switched);
+
+    model_list_clear(&endpoints, nullptr);
+    ziti_ctrl_close(&ctrl);
+    uv_run(loop, UV_RUN_DEFAULT);
+}
