+TEST_CASE("sentinel_ctrl_init_rejects_empty_endpoints", "[sentinel][controller]") {
+    ziti_controller ctrl;
+    uv_loop_t *loop = uv_default_loop();
+
+    model_list endpoints = {nullptr};
+    REQUIRE(ziti_ctrl_init(loop, &ctrl, &endpoints, nullptr) == ZITI_INVALID_CONFIG);
+    model_list_clear(&endpoints, nullptr);
+}
+
+TEST_CASE("sentinel_ctrl_init_populates_endpoint_map", "[sentinel][controller]") {
+    ziti_controller ctrl;
+    uv_loop_t *loop = uv_default_loop();
+
+    model_list endpoints = {nullptr};
+    model_list_append(&endpoints, (void *) SENTINEL_EP1);
+    model_list_append(&endpoints, (void *) SENTINEL_EP2);
+    model_list_append(&endpoints, (void *) SENTINEL_EP3);
+
+    REQUIRE(ziti_ctrl_init(loop, &ctrl, &endpoints, nullptr) == ZITI_OK);
+
+    std::set<std::string> expected = {SENTINEL_EP1, SENTINEL_EP2, SENTINEL_EP3};
+    CHECK(sentinel_endpoint_keys(&ctrl) == expected);
+
+    REQUIRE(ctrl.url != nullptr);
+    CHECK(expected.count(ctrl.url) == 1);
+
+    // and with one endpoint there is nothing to choose between
+    ziti_controller one;
+    model_list single = {nullptr};
+    model_list_append(&single, (void *) SENTINEL_EP1);
+    REQUIRE(ziti_ctrl_init(loop, &one, &single, nullptr) == ZITI_OK);
+    CHECK(model_map_size(&one.endpoints) == 1);
+    REQUIRE(one.url != nullptr);
+    CHECK_THAT(one.url, Equals(SENTINEL_EP1));
+    model_list_clear(&single, nullptr);
+    ziti_ctrl_close(&one);
+
+    // and the client is brought up against that endpoint, not another of the set
+    REQUIRE(ctrl.client != nullptr);
+    REQUIRE(ctrl.client->host != nullptr);
+    CHECK(std::string(ctrl.url).find(std::string(ctrl.client->host)) != std::string::npos);
+
+    model_list_clear(&endpoints, nullptr);
+    ziti_ctrl_close(&ctrl);
+    uv_run(loop, UV_RUN_DEFAULT);
+}
