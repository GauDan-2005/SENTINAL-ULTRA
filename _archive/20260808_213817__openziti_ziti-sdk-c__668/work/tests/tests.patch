+TEST_CASE("sentinel_ztx_init_accepts_controllers_only", "[sentinel][config]") {
+    ziti_config cfg;
+    memset(&cfg, 0, sizeof(cfg));
+    model_list_append(&cfg.controllers, strdup(SENTINEL_EP1));
+    model_list_append(&cfg.controllers, strdup(SENTINEL_EP2));
+    cfg.id.key = strdup("pem:key");
+    cfg.id.cert = strdup("pem:cert");
+    cfg.id.ca = strdup("pem:ca");
+
+    ziti_context ztx = nullptr;
+    CHECK(ziti_context_init(&ztx, &cfg) == ZITI_OK);
+    CHECK(ztx != nullptr);
+
+    // a config naming no controller at all is the one shape it rejects
+    ziti_config none;
+    memset(&none, 0, sizeof(none));
+    none.id.key = strdup("pem:key");
+    ziti_context no_ztx = nullptr;
+    CHECK(ziti_context_init(&no_ztx, &none) == ZITI_INVALID_CONFIG);
+    free_ziti_config(&none);
+
+    // and the legacy single URL is still accepted
+    ziti_config legacy;
+    memset(&legacy, 0, sizeof(legacy));
+    legacy.controller_url = strdup(SENTINEL_EP1);
+    legacy.id.key = strdup("pem:key");
+    ziti_context legacy_ztx = nullptr;
+    CHECK(ziti_context_init(&legacy_ztx, &legacy) == ZITI_OK);
+    free_ziti_config(&legacy);
+
+    // ziti_context_init only allocates; the context is released by ziti_shutdown
+    // once it has been run on a loop, which this case deliberately does not do.
+    free_ziti_config(&cfg);
+}
