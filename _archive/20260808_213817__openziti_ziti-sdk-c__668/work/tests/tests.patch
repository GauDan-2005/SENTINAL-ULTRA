+TEST_CASE("sentinel_ctrl_failover_visits_distinct_endpoints", "[sentinel][controller]") {
+    ziti_controller ctrl;
+    uv_loop_t *loop = uv_default_loop();
+
+    model_list endpoints = {nullptr};
+    model_list_append(&endpoints, (void *) SENTINEL_EP1);
+    model_list_append(&endpoints, (void *) SENTINEL_EP2);
+    model_list_append(&endpoints, (void *) SENTINEL_EP3);
+
+    REQUIRE(ziti_ctrl_init(loop, &ctrl, &endpoints, nullptr) == ZITI_OK);
+    REQUIRE(ctrl.url != nullptr);
+
+    // the client has to be talking to the endpoint the controller reports as current
+    REQUIRE(ctrl.client != nullptr);
+    REQUIRE(ctrl.client->host != nullptr);
+    CHECK(std::string(ctrl.url).find(std::string(ctrl.client->host)) != std::string::npos);
+
+    // an endpoint that has just failed is out of the running, so three requests
+    // against a set of three unreachable endpoints visit all three
+    std::set<std::string> visited;
+    visited.insert(ctrl.url);
+    for (int i = 0; i < 2; i++) {
+        sentinel_version_capture cap = sentinel_failed_request(&ctrl, loop);
+        REQUIRE(cap.called);
+        REQUIRE(ctrl.url != nullptr);
+        visited.insert(ctrl.url);
+        CHECK(std::string(ctrl.url).find(std::string(ctrl.client->host)) != std::string::npos);
+    }
+    CHECK(visited.size() == 3);
+
+    // Every endpoint has now failed, so none is believed online. Selection still
+    // has to keep handing one back rather than giving up, which shows as the
+    // endpoint continuing to move across a run of failures.
+    std::string stuck = ctrl.url;
+    bool still_moving = false;
+    for (int i = 0; i < 12; i++) {
+        sentinel_version_capture cap = sentinel_failed_request(&ctrl, loop);
+        REQUIRE(cap.called);
+        REQUIRE(ctrl.url != nullptr);
+        CHECK(visited.count(ctrl.url) == 1);
+        CHECK(std::string(ctrl.url).find(std::string(ctrl.client->host)) != std::string::npos);
+        if (stuck != ctrl.url) { still_moving = true; }
+    }
+    CHECK(still_moving);
+
+    model_list_clear(&endpoints, nullptr);
+    ziti_ctrl_close(&ctrl);
+    uv_run(loop, UV_RUN_DEFAULT);
+}
