+TEST_CASE("sentinel_ctrl_version_follows_the_endpoint_in_use", "[sentinel][controller]") {
+    uv_loop_t *loop = uv_loop_new();
+    fake_ctrl srv1, srv2;
+    REQUIRE(sentinel_start_ctrl(&srv1, loop));
+    REQUIRE(sentinel_start_ctrl(&srv2, loop));
+    srv1.advertise_ha = false;
+    srv2.advertise_ha = false;
+    srv1.redirect_to = srv2.url;
+
+    ziti_controller ctrl;
+    model_list endpoints = {nullptr};
+    sentinel_only(&endpoints, srv1.url);
+    REQUIRE(ziti_ctrl_init(loop, &ctrl, &endpoints, nullptr) == ZITI_OK);
+    uv_run(loop, UV_RUN_DEFAULT);
+
+    REQUIRE(ctrl.url != nullptr);
+    REQUIRE(std::string(ctrl.url) == srv2.url);
+    REQUIRE(srv1.version_reqs >= 1);
+
+    // the endpoint in use has changed, so what the previous one reported about
+    // itself no longer applies and the answer has to come from the one in use
+    sentinel_version_capture cap = {false, 0, ""};
+    ziti_ctrl_get_version(&ctrl, sentinel_version_cb, &cap);
+    uv_run(loop, UV_RUN_DEFAULT);
+
+    CHECK(cap.called);
+    CHECK(srv2.version_reqs >= 1);
+
+    model_list_clear(&endpoints, nullptr);
+    ziti_ctrl_close(&ctrl);
+    sentinel_stop_ctrl(&srv1);
+    sentinel_stop_ctrl(&srv2);
+    uv_run(loop, UV_RUN_DEFAULT);
+    uv_loop_close(loop);
+    free(loop);
+}
