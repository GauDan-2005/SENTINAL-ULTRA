+TEST_CASE("sentinel_ctrl_learns_peers_from_controller", "[sentinel][controller]") {
+    uv_loop_t *loop = uv_loop_new();
+    fake_ctrl srv;
+    REQUIRE(sentinel_start_ctrl(&srv, loop));
+    srv.advertise_ha = true;
+    srv.peers_payload = sentinel_three_peers(srv.url);
+
+    ziti_controller ctrl;
+    model_list endpoints = {nullptr};
+    sentinel_only(&endpoints, srv.url);
+    REQUIRE(ziti_ctrl_init(loop, &ctrl, &endpoints, nullptr) == ZITI_OK);
+    uv_run(loop, UV_RUN_DEFAULT);
+    REQUIRE(srv.version_reqs >= 1);
+    CHECK(model_map_size(&ctrl.endpoints) == 1);
+
+    login_capture login;
+    ziti_ctrl_login(&ctrl, nullptr, sentinel_login_cb, &login);
+    uv_run(loop, UV_RUN_DEFAULT);
+    REQUIRE(login.called);
+    CHECK(login.err == 0);
+
+    // the peer list has to be asked for, and only once the session exists
+    CHECK(srv.controller_reqs == 1);
+    CHECK(srv.unauthorized_controller_reqs == 0);
+
+    std::set<std::string> expected = {srv.url, SENTINEL_PEER_UP, SENTINEL_PEER_DOWN};
+    CHECK(sentinel_endpoint_keys(&ctrl) == expected);
+
+    // the peer that only publishes an older edge API is not an endpoint
+    CHECK(sentinel_endpoint_keys(&ctrl).count(SENTINEL_PEER_OLD_API) == 0);
+
+    REQUIRE(ctrl.url != nullptr);
+    CHECK_THAT(ctrl.url, Equals(srv.url));
+
+    // and again when the current edge routers are fetched
+    login_capture routers;
+    ziti_ctrl_current_edge_routers(&ctrl, sentinel_routers_cb, &routers);
+    uv_run(loop, UV_RUN_DEFAULT);
+    CHECK(routers.called);
+    CHECK(srv.edge_router_reqs == 1);
+    CHECK(srv.controller_reqs == 2);
+    CHECK(sentinel_endpoint_keys(&ctrl) == expected);
+
+    model_list_clear(&endpoints, nullptr);
+    ziti_ctrl_close(&ctrl);
+    sentinel_stop_ctrl(&srv);
+    uv_run(loop, UV_RUN_DEFAULT);
+    uv_loop_close(loop);
+    free(loop);
+}
