+// ---------------------------------------------------------------------------
+// HA controller endpoint set and failover coverage.
+// Every endpoint below is a name that cannot resolve, so each request fails at
+// the transport level and the whole block runs with no network available.
+// ---------------------------------------------------------------------------
+
+namespace {
+
+    const char *const SENTINEL_EP1 = "https://ctrl1.sentinel.invalid:1280";
+    const char *const SENTINEL_EP2 = "https://ctrl2.sentinel.invalid:1280";
+    const char *const SENTINEL_EP3 = "https://ctrl3.sentinel.invalid:1280";
+
+    const char *const SENTINEL_IDENTITY =
+            R"("id": { "key": "pem:key", "cert": "pem:cert", "ca": "pem:ca" })";
+
+    struct sentinel_version_capture {
+        bool called;
+        int err;
+        std::string code;
+    };
+
+    void sentinel_version_cb(const ziti_version *v, const ziti_error *err, void *ctx) {
+        auto *c = static_cast<sentinel_version_capture *>(ctx);
+        c->called = true;
+        if (err != nullptr) {
+            c->err = err->err;
+            c->code = err->code != nullptr ? err->code : "";
+        }
+    }
+
+    std::set<std::string> sentinel_endpoint_keys(const ziti_controller *ctrl) {
+        std::set<std::string> keys;
+        MODEL_MAP_FOR(it, ctrl->endpoints) {
+            keys.insert(model_map_it_key(it));
+        }
+        return keys;
+    }
+
+    // drive one version request to completion and report the error it produced
+    sentinel_version_capture sentinel_failed_request(ziti_controller *ctrl, uv_loop_t *loop) {
+        sentinel_version_capture cap = {false, 0, ""};
+        ziti_ctrl_get_version(ctrl, sentinel_version_cb, &cap);
+        uv_run(loop, UV_RUN_DEFAULT);
+        return cap;
+    }
+}
