+
+TEST_CASE("ctrl_init_empty_endpoints", "[controller]") {
+    ziti_controller ctrl;
+    uv_loop_t *loop = uv_default_loop();
+
+    model_list endpoints = {nullptr};
+    REQUIRE(ziti_ctrl_init(loop, &ctrl, &endpoints, nullptr) == ZITI_INVALID_CONFIG);
+    model_list_clear(&endpoints, nullptr);
+}
+
+TEST_CASE("ctrl_init_multi_endpoint", "[controller]") {
+    ziti_controller ctrl;
+    uv_loop_t *loop = uv_default_loop();
+
+    const char *ep1 = "https://ctrl1.example:1280";
+    const char *ep2 = "https://ctrl2.example:1280";
+    const char *ep3 = "https://ctrl3.example:1280";
+
+    model_list endpoints = {nullptr};
+    model_list_append(&endpoints, (void*)ep1);
+    model_list_append(&endpoints, (void*)ep2);
+    model_list_append(&endpoints, (void*)ep3);
+
+    REQUIRE(ziti_ctrl_init(loop, &ctrl, &endpoints, nullptr) == ZITI_OK);
+
+    CHECK(model_map_size(&ctrl.endpoints) == 3);
+
+    REQUIRE(ctrl.url != nullptr);
+    bool selected_from_set = strcmp(ctrl.url, ep1) == 0
+                          || strcmp(ctrl.url, ep2) == 0
+                          || strcmp(ctrl.url, ep3) == 0;
+    CHECK(selected_from_set);
+
+    model_list_clear(&endpoints, nullptr);
+    ziti_ctrl_close(&ctrl);
+    uv_run(loop, UV_RUN_DEFAULT);
+}
+
+TEST_CASE("config_legacy_controller_url_migrated", "[config]") {
+    const char *legacy_cfg = R"({
+        "ztAPI": "https://legacy.example:1280",
+        "id": { "key": "pem:key", "cert": "pem:cert", "ca": "pem:ca" }
+    })";
+
+    ziti_config cfg;
+    REQUIRE(ziti_load_config(&cfg, legacy_cfg) == ZITI_OK);
+
+    CHECK(model_list_size(&cfg.controllers) == 1);
+    CHECK(cfg.controller_url == nullptr);
+
+    auto *url = (const char *) model_list_head(&cfg.controllers);
+    REQUIRE(url != nullptr);
+    CHECK(strcmp(url, "https://legacy.example:1280") == 0);
+
+    free_ziti_config(&cfg);
+}
+
+TEST_CASE("config_no_controller_rejected", "[config]") {
+    const char *no_ctrl_cfg = R"({
+        "id": { "key": "pem:key", "cert": "pem:cert", "ca": "pem:ca" }
+    })";
+
+    ziti_config cfg;
+    CHECK(ziti_load_config(&cfg, no_ctrl_cfg) == ZITI_INVALID_CONFIG);
+    free_ziti_config(&cfg);
+}
+
+TEST_CASE("ctrl_failover_switches_endpoint", "[controller]") {
+    ziti_controller ctrl;
+    uv_loop_t *loop = uv_default_loop();
+
+    model_list endpoints = {nullptr};
+    model_list_append(&endpoints, (void*)"https://ctrl1.invalid.example:1280");
+    model_list_append(&endpoints, (void*)"https://ctrl2.invalid.example:1280");
+    model_list_append(&endpoints, (void*)"https://ctrl3.invalid.example:1280");
+
+    REQUIRE(ziti_ctrl_init(loop, &ctrl, &endpoints, nullptr) == ZITI_OK);
+    REQUIRE(ctrl.url != nullptr);
+
+    // every endpoint is unreachable, so each version request fails at the
+    // transport level and, once nothing else is in flight, the controller
+    // should rotate ctrl.url to another endpoint from the set.
+    std::string start = ctrl.url;
+    bool switched = false;
+    for (int i = 0; i < 50 && !switched; i++) {
+        resp_capture<ziti_version> version;
+        ziti_ctrl_get_version(&ctrl, resp_cb, &version);
+        uv_run(loop, UV_RUN_DEFAULT);
+        REQUIRE(version.error.err != 0);
+        REQUIRE_THAT(version.error.code, Equals("CONTROLLER_UNAVAILABLE"));
+        REQUIRE(ctrl.url != nullptr);
+        if (start != ctrl.url) { switched = true; }
+    }
+    CHECK(switched);
+
+    model_list_clear(&endpoints, nullptr);
+    ziti_ctrl_close(&ctrl);
+    uv_run(loop, UV_RUN_DEFAULT);
 }
