+# --- script parameter annotations ---
+
+SCRIPT_BOOK_JSON = {
+    "client": "Office.js",
+    "version": xw.__version__,
+    "book": {"name": "B", "active_sheet_index": 0, "selection": "A1"},
+    "names": [],
+    "sheets": [{"name": "S", "values": [[None]], "pictures": [], "tables": []}],
+}
+
+
+def _make_module(**funcs):
+    mod = types.ModuleType("test_scripts")
+    for name, func in funcs.items():
+        mod.__dict__[name] = func
+    return mod
+
+
+@pytest.mark.anyio
+async def test_sentinel_book_async_annotation_makes_injected_book_lazy():
+    # The caller builds the book eagerly and cannot see the annotation, so the
+    # laziness has to be applied to the book that gets injected.
+    @script
+    async def my_script(book: xw.BookAsync):
+        book.sheets.active["A1"].value  # sync read on an async book -> raises
+
+    book = xw.Book(json=SCRIPT_BOOK_JSON)
+    mod = _make_module(my_script=my_script)
+    with pytest.raises(XlwingsError):
+        await custom_scripts_call(mod, "my_script", typehint_to_value={xw.Book: book})
+    book.close()
+
+
+@pytest.mark.anyio
+async def test_sentinel_plain_book_annotation_stays_regular():
+    # Without BookAsync the injected book is untouched and sync reads work.
+    @script
+    async def my_script(book: xw.Book):
+        assert book.sheets.active["A1"].value is None  # must not raise
+
+    book = xw.Book(json=SCRIPT_BOOK_JSON)
+    mod = _make_module(my_script=my_script)
+    await custom_scripts_call(mod, "my_script", typehint_to_value={xw.Book: book})
+    book.close()
+
+
+# --- optional spellings of the book parameter annotation ---
+
+LEDGER = "Ledger"
+
+
+def _script_json():
+    """A one-sheet book with a distinctive sheet name, built eagerly."""
+    return {
+        "client": "Office.js",
+        "version": xw.__version__,
+        "book": {"name": "B", "active_sheet_index": 0, "selection": "A1"},
+        "names": [],
+        "sheets": [
+            {"name": LEDGER, "values": [[None]], "pictures": [], "tables": []}
+        ],
+    }
+
+
+async def _run(func, name):
+    """Call a script the way the host does and hand back what it returned.
+
+    The book is built eagerly by the caller, exactly as xlwings Lite builds it,
+    so nothing outside the annotation can tell the script apart.
+    """
+    book = xw.Book(json=_script_json())
+    mod = _make_module(**{name: func})
+    try:
+        return book, await custom_scripts_call(
+            mod, name, typehint_to_value={xw.Book: book}
+        )
+    finally:
+        book.close()
+
+
+@pytest.mark.anyio
+async def test_sentinel_optional_spellings_of_the_book_annotation():
+    """Every optional spelling of the async annotation, and the plain one.
+
+    One case rather than four, because this is a single contract - reading the
+    annotation through a union - asserted over the spellings that express it.
+    """
+    outcome = {}
+
+    @script
+    async def opt_script(book: Optional[xw.BookAsync]):
+        try:
+            book.sheets.active["A1"].value
+        except XlwingsError as exc:
+            outcome["opt"] = str(exc)
+
+    @script
+    async def pipe_script(book: xw.BookAsync | None):
+        try:
+            book.sheets.active["A1"].value
+        except XlwingsError:
+            outcome["pipe"] = True
+
+    @script
+    async def union_script(book: Union[xw.BookAsync, None]):
+        try:
+            book.sheets.active["A1"].value
+        except XlwingsError:
+            outcome["union"] = True
+
+    @script
+    async def plain_script(book: Optional[xw.Book]):
+        # A regular book, so this read must go through rather than raise.
+        outcome["plain"] = book.sheets.active["A1"].value
+
+    scripts = {
+        "opt_script": opt_script,
+        "pipe_script": pipe_script,
+        "union_script": union_script,
+        "plain_script": plain_script,
+    }
+    # each script has to receive its book, so its body runs at all, and hand the
+    # same book back to the caller
+    for name, func in scripts.items():
+        book, returned = await _run(func, name)
+        assert returned is book, name
+
+    # the async spellings raise inside the script, and say which sheet and what
+    # to await instead
+    assert LEDGER in outcome["opt"] and _points_at_an_await_route(outcome["opt"])
+    assert outcome["pipe"] is True
+    assert outcome["union"] is True
+    # reading the annotation through a union must not turn every optional book
+    # parameter into an async one
+    assert outcome["plain"] is None
+
+    # the host reads the script list before any script runs, so the choice has
+    # to be announced there too
+    announced = {
+        m["function_name"]: m["lazy"] for m in custom_scripts_meta(_make_module(**scripts))
+    }
+    assert announced == {
+        "opt_script": True,
+        "pipe_script": True,
+        "union_script": True,
+        "plain_script": False,
+    }
+
+
+# --- a sheet the book has not seen before ---
+
+
+@pytest.mark.anyio
+async def test_sentinel_metadata_only_load_leaves_a_new_sheet_usable(fake_emscripten):
+    # The host is the authority on what the workbook holds, so a load can turn up
+    # a sheet the book has never seen. Bringing it in half-built is the failure
+    # this guards: on a regular book the new sheet reads as empty.
+    book = _open_eager(OPENED_VALUES)
+    fake_emscripten.sheet_names = [SHEET1, SHEET2, SHEET3]
+    await book.load(values=False)
+    assert _read(book.sheets(SHEET3)) == [(None,)]
+    # and the sheets that were already there keep the values they had
+    assert _read(book.sheets(SHEET1)) == [(1,)]
+
+    # on an async book the same new sheet raises the ordinary not-loaded error
+    async_book = await _fetch_async()
+    fake_emscripten.sheet_names = [SHEET1, SHEET2, SHEET3]
+    await async_book.load()
+    assert _raises(async_book.sheets(SHEET3))
+    # and loading values fills it in
+    await async_book.load(values=True)
+    assert _read(async_book.sheets(SHEET3)) == [(10,)]
+
+
+# --- metadata-only has to be metadata-only on the wire ---
+
+
+@pytest.mark.anyio
+async def test_sentinel_metadata_only_load_asks_the_host_to_skip_values(
+    fake_emscripten,
+):
+    # Skipping the cell payload is the point of the feature, so the request has
+    # to carry the choice. Pulling everything down and hiding it locally looks
+    # identical from every other test's point of view.
+    fake_emscripten.calls.clear()
+    book = await _fetch_async()
+    assert fake_emscripten.lazy_flags() == [True]
+
+    fake_emscripten.calls.clear()
+    await book.load()
+    assert fake_emscripten.lazy_flags() == [True]
+
+    fake_emscripten.calls.clear()
+    await book.load(values=True)
+    assert fake_emscripten.lazy_flags() == [False]
+
+    fake_emscripten.calls.clear()
+    await book.sheets(SHEET1).load(values=True)
+    assert fake_emscripten.lazy_flags() == [False]
+
+    fake_emscripten.calls.clear()
+    await book.sheets(SHEET1).load()
+    assert fake_emscripten.lazy_flags() == [True]
+
+
+# --- loading values for only some of the sheets ---
+
+
+@pytest.mark.anyio
+async def test_sentinel_book_load_with_a_sheet_list_loads_only_those_sheets(
+    fake_emscripten,
+):
+    # Naming sheets asks for their values and nobody else's. The sheets left out
+    # keep exactly what they had, and none of them drops out of the book.
+    book = await _fetch_async()
+    fake_emscripten.sheet_names = [SHEET1, SHEET2, SHEET3]
+    await book.load()
+    await book.load(values=[SHEET1])
+
+    assert _read(book.sheets(SHEET1)) == [(10,)]
+    # still in the book, and still unloaded rather than quietly empty
+    assert book.sheets(SHEET2).name == SHEET2
+    assert _raises(book.sheets(SHEET2))
+    assert book.sheets(SHEET3).name == SHEET3
+    assert _raises(book.sheets(SHEET3))
+
