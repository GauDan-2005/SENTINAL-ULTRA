+# --- Book.load(values=...) ---
+
+
+@pytest.mark.anyio
+async def test_sentinel_async_book_load_value_states(fake_emscripten):
+    """Every state of the values argument on an async book, in one case.
+
+    One id rather than three, because this is a single contract - what the
+    argument means - asserted over the values it can take.
+    """
+    # no argument: metadata only, so reads still raise
+    book = await _fetch_async()
+    await book.load()
+    assert _raises(book.sheets.active)
+
+    # values=True: values arrive and the sheet reads normally
+    await book.load(values=True)
+    assert _read(book.sheets.active) == [(10,)]
+
+    # values=False: metadata only, whatever the book already is
+    fresh = await _fetch_async()
+    await fresh.load(values=False)
+    assert _raises(fresh.sheets.active)
+
+    # an empty selection asks for nothing, exactly like False
+    empty = await _fetch_async()
+    await empty.load(values=[])
+    assert _raises(empty.sheets.active)
+
