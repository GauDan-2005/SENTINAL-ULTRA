+"""
+Tests for the async (lazy) book load semantics in the remote backend.
+
+Everything here is asserted through observable behaviour: whether a synchronous
+cell read succeeds, raises, or returns a stale value. Nothing reaches into the
+implementation's private state, so any correct design passes.
+
+``js`` / ``pyodide`` aren't available in the test environment and the load
+methods gate on ``sys.platform == "emscripten"``, so the fixtures below fake just
+enough of that surface to run the real branching logic.
+"""
+
+import re
+import sys
+import types
+from typing import Optional, Union
+from types import ModuleType, SimpleNamespace
+
+import pytest
+
+import xlwings as xw
+from xlwings import XlwingsError
+from xlwings.pro import _xlremote as R
+from xlwings.pro.udfs_officejs import custom_scripts_call, custom_scripts_meta, script
+
+SHEET1 = "SalesQ3"
+SHEET2 = "Archive"
+SHEET3 = "Forecast"
+
+# What the fake host returns for a full (non-lazy) fetch. Distinct from the
+# values a book is opened with, so "did this load actually happen" is visible.
+SERVER_VALUES = [[10, 20], [30, 40]]
+OPENED_VALUES = [[1, 2], [3, 4]]
+
+
+def _sheet(name, values):
+    return {
+        "name": name,
+        "values": values if values is not None else [[]],
+        "pictures": [],
+        "tables": [],
+    }
+
+
+def _book_json(values=None, names=None):
+    """Two sheets by default, so per-sheet behaviour is observable."""
+    return {
+        "client": "Office.js",
+        "version": xw.__version__,
+        "book": {"name": "B", "active_sheet_index": 0, "selection": "A1"},
+        "names": [],
+        "sheets": [_sheet(n, values) for n in (names or [SHEET1, SHEET2])],
+    }
+
+
+def _make_app():
+    """A real *remote* App, so reads go through the remote backend rather than
+    launching the native Excel engine."""
+    return R.App(R.Apps(), add_book=False)
+
+
+def _open_eager(values=None):
+    """A regular book, opened directly with its data."""
+    return _make_app().books.open(_book_json(values))
+
+
+async def _fetch_async():
+    """A book obtained the way the async API obtains one, on demand."""
+    return await _make_app().books.get_active()
+
+
+def _read(sheet):
+    """Synchronous top-left cell read on an implementation sheet."""
+    return R.Range(sheet=sheet, arg1=(1, 1)).raw_value
+
+
+def _points_at_an_await_route(msg):
+    """The instruction asks the message to point at an awaitable way to get the
+    value, and says either real route counts. A message naming only one of them
+    is a correct solution, so both spellings pass here."""
+    return re.search(r"get_value|\bload\s*\(", msg) is not None
+
+
+def _raises(sheet):
+    """True when a synchronous read on this sheet raises XlwingsError."""
+    try:
+        _read(sheet)
+    except XlwingsError:
+        return True
+    return False
+
+
+class _Host:
+    """Stands in for the Office.js host.
+
+    Mirrors the server: a metadata-only request comes back with no cell values, a
+    full one comes back with SERVER_VALUES. Records the options each request
+    arrived with, and lets a test change the sheet list between requests the way
+    someone adding a sheet in Excel would.
+    """
+
+    def __init__(self):
+        self.calls = []
+        self.sheet_names = [SHEET1, SHEET2]
+
+    async def get_book_data(self, opts=None):
+        opts = dict(opts) if opts else {}
+        self.calls.append(opts)
+        # `include` narrows the payload to the named sheets, the way the real
+        # host does for a single sheet load.
+        include = opts.get("include")
+        if isinstance(include, str):
+            include = [include]
+        names = list(include) if include else self.sheet_names
+        values = [[]] if opts.get("lazy", False) else SERVER_VALUES
+        return SimpleNamespace(to_py=lambda: _book_json(values, names))
+
+    def lazy_flags(self):
+        """What each request since the last clear asked for."""
+        return [c.get("lazy") for c in self.calls]
+
+    def included(self):
+        """Which sheets the most recent request named, as a list.
+
+        A single sheet load already sends `include` as a plain string, so a
+        request naming several sheets may reasonably arrive as a list or as one
+        delimited string. Both spellings mean the same thing and both are
+        accepted here.
+        """
+        if not self.calls:
+            return None
+        raw = self.calls[-1].get("include")
+        if raw is None:
+            return None
+        if isinstance(raw, str):
+            return [part.strip() for part in raw.split(",") if part.strip()]
+        return [str(part) for part in raw]
+
+
+@pytest.fixture
+def fake_emscripten(monkeypatch):
+    """Fake sys.platform + js/pyodide so the load paths run their real logic.
+
+    Hands back the fake host, so a test that cares can read what was requested or
+    change what the workbook looks like.
+    """
+    monkeypatch.setattr(sys, "platform", "emscripten")
+    host = _Host()
+
+    js = ModuleType("js")
+    js.xlwings = SimpleNamespace(getBookData=host.get_book_data)
+    # to_js(..., dict_converter=js.Object.fromEntries) references this; our fake
+    # to_js ignores it, but the attribute must exist to be passed as an arg.
+    js.Object = SimpleNamespace(fromEntries=lambda x: x)
+
+    pyodide = ModuleType("pyodide")
+    ffi = ModuleType("pyodide.ffi")
+    ffi.to_js = lambda obj, dict_converter=None: obj
+    pyodide.ffi = ffi
+
+    monkeypatch.setitem(sys.modules, "js", js)
+    monkeypatch.setitem(sys.modules, "pyodide", pyodide)
+    monkeypatch.setitem(sys.modules, "pyodide.ffi", ffi)
+    return host
+
+
+@pytest.fixture
+def anyio_backend():
+    return "asyncio"
+
