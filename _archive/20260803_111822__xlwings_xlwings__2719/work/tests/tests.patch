+@pytest.mark.anyio
+async def test_sentinel_a_selective_load_keeps_what_other_sheets_already_had(
+    fake_emscripten,
+):
+    # Naming sheets says which values to fetch, not which sheets count as loaded.
+    # A sheet loaded by an earlier call keeps its values and stays readable when a
+    # later call names a different sheet.
+    book = await _fetch_async()
+    fake_emscripten.sheet_names = [SHEET1, SHEET2, SHEET3]
+    await book.load()
+
+    await book.load(values=[SHEET1])
+    assert _read(book.sheets(SHEET1)) == [(10,)]
+
+    await book.load(values=[SHEET2])
+    # the sheet named this time is readable, and so is the one named last time
+    assert _read(book.sheets(SHEET2)) == [(10,)]
+    assert _read(book.sheets(SHEET1)) == [(10,)]
+    # the one never named is still unloaded rather than quietly empty
+    assert _raises(book.sheets(SHEET3))
+
+    # and a plain metadata-only load afterwards does not undo any of it
+    await book.load()
+    assert _read(book.sheets(SHEET1)) == [(10,)]
+    assert _read(book.sheets(SHEET2)) == [(10,)]
+
