+# --- how a book was obtained decides whether sync reads work ---
+
+
+@pytest.mark.anyio
+async def test_sentinel_async_fetch_read_raises_with_actionable_message(
+    fake_emscripten,
+):
+    book = await _fetch_async()
+    sheet = book.sheets.active
+    with pytest.raises(XlwingsError) as exc_info:
+        _read(sheet)
+    msg = str(exc_info.value)
+    # says the values are not loaded, names the sheet, and offers both routes
+    assert sheet.name in msg
+    assert _points_at_an_await_route(msg)
+
+
+def test_sentinel_eager_book_value_read_works():
+    assert _read(_open_eager(OPENED_VALUES).sheets.active) == [(1,)]
+
